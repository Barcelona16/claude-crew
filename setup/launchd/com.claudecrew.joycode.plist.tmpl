<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.claudecrew.joycode</string>
  <key>ProgramArguments</key><array><string>__PY__</string><string>__JOYCODE_SCRIPT__</string></array>
  <key>EnvironmentVariables</key><dict>
    <key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key><string>__HOME__</string>
    <key>CREW_HOME</key><string>__CREW_CONFIG_DIR__</string>
    <key>CREW_CONFIG_DIR</key><string>__CREW_CONFIG_DIR__</string>
    <key>JOYCODE_HMAC_SECRET_FILE</key><string>__JOYCODE_SECRET_FILE__</string>
    <key>JOYCODE_UPSTREAM_TIMEOUT</key><string>__JOYCODE_TIMEOUT__</string>
    <key>JOYCODE_PORT</key><string>__JOYCODE_PORT__</string>
  </dict>
  <key>RunAtLoad</key><true/><key>KeepAlive</key><true/><key>ThrottleInterval</key><integer>5</integer>
  <key>Umask</key><integer>63</integer>
  <key>StandardOutPath</key><string>__HOME__/.claude-code-router/joycode.launchd.out.log</string>
  <key>StandardErrorPath</key><string>__HOME__/.claude-code-router/joycode.launchd.err.log</string>
</dict></plist>