# Example backend preset. Copy to ~/.config/claude-crew/backends/<name>.conf and edit.
# All keys are optional — an empty file behaves like the built-in "default" backend
# (plain Claude with your ambient config). This file is sourced by bash, so it must
# be valid shell (KEY=value, quote values with spaces).

# ANTHROPIC_BASE_URL override — point Claude at a proxy/gateway that speaks the
# Anthropic /v1/messages API (e.g. a local LiteLLM translating to another provider).
BASE_URL=

# Model name passed as `claude --model <MODEL>`. Leave empty for Claude's default.
MODEL=

# Auth token sent as ANTHROPIC_AUTH_TOKEN. Either a literal:
TOKEN=
# ...or a command whose stdout is the token (takes precedence over TOKEN).
# Useful to pull a token from a keychain, a router config, or an env file.
TOKEN_CMD=
# ...or the NAME of an environment variable to read the token from at launch time —
# the crew analog of LiteLLM's `api_key: os.environ/GATEWAY_TOKEN`. HIGHEST precedence:
# if the named var is set & non-empty it wins over TOKEN_CMD and TOKEN (otherwise crew
# falls back to them). Lets several tools share one gateway token via the environment
# instead of pasting it into each backend.
#   TOKEN_ENV=GATEWAY_TOKEN
TOKEN_ENV=

# Optional idempotent command run before the session starts — e.g. start a local
# proxy if it isn't already up. Must be safe to run repeatedly.
ENSURE_CMD=

# KEY_MODE — how a pinned `crew --key <alias>` (alias from ~/.config/claude-crew/keys.conf)
# applies to THIS backend:
#   token   (default) the alias's key becomes ANTHROPIC_AUTH_TOKEN. Correct when this
#           backend talks DIRECTLY to the gateway (the inbound token IS the credential).
#   litellm this backend's BASE_URL is a local LiteLLM proxy that only accepts its own
#           master key, so --key can't be sent inbound. Instead crew spins/points at a
#           per-key LiteLLM instance whose UPSTREAM gateway token is the alias's key
#           (inbound stays the proxy master key). Use for glm/kimi-style backends.
KEY_MODE=

# Extra environment injected into the session, space-separated K=V pairs.
# NOTE: quote the whole value if it contains spaces (multiple K=V pairs), otherwise
# bash's inline-env parsing splits it and only the first pair reaches the session.
# Correct:   ENV_EXTRA="MAX_THINKING_TOKENS=0 IS_SANDBOX=1"
# WRONG:     ENV_EXTRA=MAX_THINKING_TOKENS=0 IS_SANDBOX=1   # IS_SANDBOX becomes command-level env, lost
ENV_EXTRA=

# Force-enable --dangerously-skip-permissions for this backend regardless of the global
# default. NOTE: crew now enables bypass by DEFAULT for every session (CREW_YOLO=1);
# opt out per-launch with `crew --safe` (alias --no-yolo) or globally with CREW_YOLO=0.
DANGEROUS=

# Override the flags passed to `claude` entirely (advanced).
CLAUDE_FLAGS=

# AGENT_POLICY — 分层派发规则(2026-08-30 用户拍板方案 2 落地)
# crew 启动时把 templates/policy-<value>.md 的正文拼进 --append-system-prompt,让
# 智能体从'main-loop 干重活'过渡到'派子 agent/新 crew 干重活,主脑保持轻'。
# 合法值:none/conservative/balanced/aggressive(未知会告警回落 none)
#   none         (默认) 不注入任何附加 system prompt,行为等同于本字段未加时。存量 21 个 crew 就用这档保持零改动
#   conservative 轻提示,推荐大 IO 派子 agent 但不强制。适合长稳业务(dongkv/chaos/drc)
#   balanced     标准分层,判据明确(grep 3+ 文件派子 agent、跑测试派 crew 等)。适合 workflow-code/review-*/verify
#   aggressive   主脑档硬约束,强度最高。仅推荐主脑 work
# 应急旁路:环境变量 CREW_POLICY_DISABLE=1 全局跳过 policy 注入(不改 conf)
# 模板搜索顺序:$CREW_HOME/templates/policy-<value>.md → 仓内 templates/(fallback)
AGENT_POLICY=
