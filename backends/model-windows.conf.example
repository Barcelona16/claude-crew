# model-windows.conf — 各模型真实上下文窗口(2026-10-20)
#
# 为什么存在:oxygen(llm-gw)的 /v1/models 不返回 context window;CC 对未知模型按
# ~200k 假定。不符时:假窗口 > 真窗口 → 压缩不触发 → 400 "prompt is too long" 会话卡死;
# 假窗口 < 真窗口 → 提前压缩浪费 + statusline 失真。
# crew-launcher 起会话按此表注入 CLAUDE_CODE_MAX_CONTEXT_TOKENS(真实窗口)+
# AUTO_COMPACT_WINDOW(90%);crew-statusline 同源。proxy 报错时自动校准会写此文件。
#
# 格式:<小写模式>=<token 数>;模型名包含该模式即命中,首条生效。
# 2026-10-20 实测(llm-gw 超限探测):
#   GLM-5.3-Local "context length (1048576 tokens)"
#   kimi-k3      "token limit: 1048576"
#   GLM-5.2      无数字(code 1261 Prompt 超长)— 待统计校准

glm-5.3=1048576  
kimi=1048576
glm-5.2=200000
glm-5.1=200000
glm-5=200000
claude=200000
opus=200000
sonnet=200000
fable=200000
deepseek=128000
doubao=128000
