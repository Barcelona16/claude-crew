#!/usr/bin/env bash
# crew — named, attachable, persistent tmux sessions for Claude Code, with pluggable backends.
#
# A "crew session" is a named tmux session running `claude`, pinned to a backend
# (base URL + model + token + env) and a stable Claude session-id. That lets you:
#   * address a long-lived agent by name (crew mysess "task")
#   * attach any time to watch it work (crew attach mysess)
#   * survive tmux/host restarts — it --resumes the same conversation
#   * point different sessions at different model backends
#
# Backends are presets you drop in ~/.config/claude-crew/backends/<name>.conf.
# There is NO implicit "default" backend — a backend must be chosen explicitly
# (--model <name>, CREW_BACKEND, a session's remembered .backend, or --pick).
#
# USAGE
#   crew [--model M] [--key A] [--pick] [--fresh] [--safe] [--no-tmux] [name] [task...]
#                         start/continue a session (auto-attaches when interactive)
#
# SESSIONS (the everyday commands)
#   crew                  ensure + attach the session for the current directory
#   crew <name>           ensure + attach the named session
#   crew <name> --model M           switch model, then attach
#   crew <name> --key A             switch key, then attach
#   crew <name> --model M --key A   switch both, then attach
#   crew ls               list all known crew sessions (live + resumable, survives restart)
#                         (main session pinned first, then most-recently-active)
#   crew attach <name>    attach to observe a session
#   crew stop <name>      stop a session's tmux but KEEP its state (resume/switch later)
#   crew kill <name> [--purge]   delete a session for good (tmux + id + registry; --purge also transcript)
#   crew adopt <name> <tmux-session> [--sid U] [--model M]   register an EXTERNAL tmux session
#                         (e.g. the main `work` session) into crew: shows in ls, attach/send/log
#                         reach it, but crew never spawns/stops/kills it (stop/kill/prune refuse it)
#
# CONFIG
#   crew models           list available model presets
#   crew keys             list api-key aliases from ~/.config/claude-crew/keys.conf
#   crew up               ensure dependency services are up (CCR :3456 + crew-proxy :8788)
#   crew prune [--days N] [--dry-run] [--purge]   auto-release sessions idle > N days (default 7);
#                         never touches a live or adopted session; keeps transcripts unless --purge.
#                         Runs itself opportunistically (throttled) on spawn/up; CREW_PRUNE_AUTO=0 disables
#   crew doctor           read-only health check (services, keys.conf, key-policy resolvable)
#   crew stats            crew-proxy usage in the terminal (key health + token totals)
#   crew add-key [<name>]        add a new API+key as a direct backend; picks from its /v1/models
#   crew sync-models [--key A]   discover a key's upstream models; pick which new ones to add to CCR
#
# MESSAGING (between sessions)
#   crew send [--from X] [--nudge] <name> "msg"   drop a message in <name>'s mailbox
#   crew send --all [--nudge] "msg"               broadcast to all running sessions
#   crew inbox [--peek] [<name>]                  read (and consume) your mailbox
#
# ADVANCED
#   crew delegate --model M "task"   one-shot `claude -p` delegation (result to stdout)
#   crew log [--tail N] [--raw] [<name>]          full transcript from Claude's session log
#
# The two knobs you switch are --model and --key; everything else is plumbing.
#
# FLAGS
#   --model M     pick a model preset (see `crew models`). Remembered
#                 per session; switching it on a live session restarts (history kept via
#                 --resume) and then attaches. `--backend` is a hidden alias.
#   --key A       use api-key alias A (from ~/.config/claude-crew/keys.conf). Works for every
#                 model (direct-gateway = inbound token; ccr = swaps to the provider that
#                 serves the model with that key). Remembered per session; a live switch
#                 restarts + attaches. `--key -` clears the pin.
#   --pick, -p    interactively choose model, then key, then tmux mode from menus
#                 (fzf if installed, else a numbered bash prompt). Any knob you also
#                 pass explicitly (--model/--key/--tmux/--no-tmux) is skipped. Defaults
#                 preselect the existing session's model/key/tmux when it already exists,
#                 else CREW_BACKEND / no key / tmux. Saves typing three flags every time.
#   --fresh       start a brand-new conversation (do not --resume old history)
#   --yolo        add --dangerously-skip-permissions (ON by default; see --safe)
#   --safe        DON'T add --dangerously-skip-permissions (opt out of the default
#                 bypass for this one launch). Alias: --no-yolo. Set CREW_YOLO=0 to
#                 make "safe" the default for every session.
#   --no-tmux     run Claude in the FOREGROUND of the current terminal instead of a
#                 detached tmux session. Session state is still registered (shows in
#                 `crew ls`, `send`/`inbox` work, next `crew <name>` --resumes it), but
#                 it ends when you close the terminal. Can't be combined with a queued
#                 task (tasks need tmux + send-keys). Alias to opt back in: --tmux.
#                 Set CREW_NO_TMUX=1 to make foreground the default.
#
# Optional extensions live in $CREW_HOME/ext/*.sh (sourced if present). Core crew
# (tmux + CCR/proxy-routed presets) works with none installed.
# See README.md / README.en.md.
set -uo pipefail

CREW_HOME="${CREW_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}/claude-crew}"
CREW_STATE="${CREW_STATE:-${XDG_DATA_HOME:-$HOME/.local/share}/claude-crew}"
BACKEND_DIR="$CREW_HOME/backends"
KEYS_FILE="$CREW_HOME/keys.conf"                 # lines: <alias>=<api-key>  (full-line # comments ok)
REG="$CREW_STATE/registry"                       # lines: <cwd>\t<name>
CLAUDE_BIN="${CREW_CLAUDE_BIN:-$(command -v claude || echo claude)}"
TMUX_PREFIX="crew-"
mkdir -p "$BACKEND_DIR" "$CREW_STATE"

# Locate sibling helper scripts. crew is usually invoked via a symlink (e.g. ~/.local/bin/crew
# -> <clone>/bin/crew), so resolve the link chain to find the real bin/ dir. Portable (no
# realpath -f, which macOS lacks). KEYRESOLVE = the shared effective-key resolver shared with
# crew-statusline.sh; if it's missing, callers fall back to raw state.
_crew_self="${BASH_SOURCE[0]:-$0}"
while [ -L "$_crew_self" ]; do
  _crew_link="$(readlink "$_crew_self")"
  case "$_crew_link" in /*) _crew_self="$_crew_link";; *) _crew_self="$(dirname "$_crew_self")/$_crew_link";; esac
done
CREW_BIN_DIR="$(cd "$(dirname "$_crew_self")" 2>/dev/null && pwd)"
KEYRESOLVE="$CREW_BIN_DIR/crew-keyresolve.js"

die(){ echo "[crew] $*" >&2; exit 1; }
log(){ echo "[crew] $*" >&2; }

# --- portable helpers (no lsof/ss/node dependency) --------------------------
gen_uuid(){
  if   command -v uuidgen >/dev/null 2>&1; then uuidgen | tr 'A-Z' 'a-z'
  elif [ -r /proc/sys/kernel/random/uuid ]; then cat /proc/sys/kernel/random/uuid
  elif command -v python3 >/dev/null 2>&1; then python3 -c 'import uuid;print(uuid.uuid4())'
  elif command -v node    >/dev/null 2>&1; then node -e 'console.log(require("crypto").randomUUID())'
  else openssl rand -hex 16 | sed 's/\(........\)\(....\)\(....\)\(....\)\(............\)/\1-\2-\3-\4-\5/'
  fi
}
# Is 127.0.0.1:<port> accepting connections? Uses bash's built-in /dev/tcp so it
# works in minimal containers that ship no lsof/ss (a real bug we hit otherwise:
# a missing lsof made the check silently fail and spawn duplicate backends).
port_listening(){
  local p="$1"
  (exec 3<>"/dev/tcp/127.0.0.1/$p") 2>/dev/null && { exec 3>&- 3<&-; return 0; }
  command -v nc   >/dev/null 2>&1 && nc -z 127.0.0.1 "$p" >/dev/null 2>&1 && return 0
  command -v lsof >/dev/null 2>&1 && lsof -nP -iTCP:"$p" -sTCP:LISTEN >/dev/null 2>&1 && return 0
  command -v ss   >/dev/null 2>&1 && ss -tlnH "sport = :$p" 2>/dev/null | grep -q . && return 0
  return 1
}
sanitize(){ printf '%s' "$1" | tr -c 'A-Za-z0-9._-' '-' | sed 's/^-*//;s/-*$//'; }
# Portable mtime (epoch seconds): GNU coreutils `stat -c`, else BSD/macOS `stat -f`.
mtime(){ stat -c %Y "$1" 2>/dev/null || stat -f %m "$1" 2>/dev/null || echo 0; }
# The tmux session name for a crew session. Normal sessions crew spawns are "crew-<name>".
# An ADOPTED/external session (a `<name>.tmux` override file exists — e.g. the main `work`
# session that bootstrap/start.sh manages, not crew) uses that recorded name verbatim, so
# `crew attach/ls/send` reach the real tmux while crew never owns its lifecycle.
tmux_name_for(){ if [ -f "$CREW_STATE/$1.tmux" ]; then cat "$CREW_STATE/$1.tmux"; else printf '%s' "$TMUX_PREFIX$1"; fi; }
is_adopted(){ [ -f "$CREW_STATE/$1.tmux" ]; }
# Most-recent-activity epoch for a session: max mtime across its transcript JSONL and its
# .sid/.backend/.key state. Used to sort `crew ls` so the sessions you're working in float
# up. Mirrors prune's staleness math (kept in sync). 0 when nothing on disk yet.
session_activity(){
  local nm="$1" sidf="$CREW_STATE/$nm.sid" last=0 s j m f
  if [ -f "$sidf" ]; then s=$(cat "$sidf" 2>/dev/null)
    for j in "$HOME"/.claude/projects/*/"$s".jsonl; do [ -f "$j" ] || continue; m=$(mtime "$j"); [ "$m" -gt "$last" ] && last=$m; done
  fi
  for f in "$sidf" "$CREW_STATE/$nm.backend" "$CREW_STATE/$nm.key"; do [ -f "$f" ] || continue; m=$(mtime "$f"); [ "$m" -gt "$last" ] && last=$m; done
  echo "$last"
}

# Opportunistic, throttled auto-release: at most once per CREW_PRUNE_EVERY seconds (default
# 1 day) fire `crew prune` in the background to release sessions idle > CREW_PRUNE_DAYS
# (default 7). No cron needed — piggybacks on spawn/up. Disable with CREW_PRUNE_AUTO=0.
# NEVER reaps a live or adopted session (prune enforces that); backgrounded so it can't
# delay a spawn/attach.
crew_autoprune(){
  [ "${CREW_PRUNE_AUTO:-1}" = 1 ] || return 0
  local every="${CREW_PRUNE_EVERY:-86400}" stamp="$CREW_STATE/.last-prune" last now
  last=$(cat "$stamp" 2>/dev/null || echo 0); case "$last" in ''|*[!0-9]*) last=0;; esac
  now=$(date +%s 2>/dev/null || echo 0); [ "$now" = 0 ] && return 0
  [ $((now - last)) -ge "$every" ] || return 0
  printf '%s' "$now" > "$stamp" 2>/dev/null || true
  ( "$0" prune >/dev/null 2>&1 & ) 2>/dev/null || true
}

# --- registry: current dir <-> session name --------------------------------
resolve_name_for_cwd(){
  local cwd="$1" base name n
  if [ -f "$REG" ]; then name=$(awk -F'\t' -v p="$cwd" '$1==p{print $2}' "$REG" | head -1); [ -n "$name" ] && { echo "$name"; return; }; fi
  base=$(sanitize "$(basename "$cwd")"); [ -z "$base" ] && base="root"
  name="$base"; n=2
  while [ -f "$REG" ] && awk -F'\t' -v m="$name" '$2==m{ok=1}END{exit !ok}' "$REG"; do name="${base}${n}"; n=$((n+1)); done
  printf '%s\t%s\n' "$cwd" "$name" >> "$REG"; echo "$name"
}
resolve_explicit_name(){ local name="$1" cwd="$2"; if [ -f "$REG" ] && awk -F'\t' -v m="$name" '$2==m{ok=1}END{exit !ok}' "$REG"; then :; else printf '%s\t%s\n' "$cwd" "$name" >> "$REG"; fi; echo "$name"; }
path_for_name(){ awk -F'\t' -v m="$1" '$2==m{print $1}' "$REG" 2>/dev/null | head -1; }

# All session names registered for a directory (a path may have several). One per line.
sessions_for_cwd(){ local cwd="$1"; [ -f "$REG" ] && awk -F'\t' -v p="$cwd" '$1==p{print $2}' "$REG" | awk 'NF'; }

# Always mint a NEW deduped session name for a directory and register it (unlike
# resolve_name_for_cwd, which reuses the first existing name). Used by the "+ new" menu path.
fresh_name_for_cwd(){
  local cwd="$1" base name n
  base=$(sanitize "$(basename "$cwd")"); [ -z "$base" ] && base="root"
  name="$base"; n=2
  while [ -f "$REG" ] && awk -F'\t' -v m="$name" '$2==m{ok=1}END{exit !ok}' "$REG"; do name="${base}${n}"; n=$((n+1)); done
  printf '%s\t%s\n' "$cwd" "$name" >> "$REG"; echo "$name"
}

# --- backend presets --------------------------------------------------------
list_backends_inline(){ ls "$BACKEND_DIR"/*.conf 2>/dev/null | sed 's:.*/::;s:\.conf$::' | sort -u | tr '\n' ' '; }
# Echo the model a backend runs, WITHOUT sourcing the conf (sourcing can fire a backend's
# ENSURE_CMD side effects; read-only paths like `ls` must not).
model_for_backend(){
  local b="$1" f="$BACKEND_DIR/$1.conf" m=""
  [ -f "$f" ] || { printf '?'; return; }
  m=$(grep -E '^[[:space:]]*MODEL=' "$f" 2>/dev/null | head -1 | sed -E 's/^[[:space:]]*MODEL=//')
  m="${m%\"}"; m="${m#\"}"; m="${m%\'}"; m="${m#\'}"
  printf '%s' "${m:-<default>}"
}
# Sets BK_* globals from $BACKEND_DIR/<backend>.conf. There is no "default" backend;
# an unknown/empty name (that isn't a synthesized ccr "provider,realmodel") dies.
# A backend given as "provider,realmodel" (comma) with no matching .conf is a synthesized
# ccr backend — the key-first --pick menu produces these for models that have no preset file
# (e.g. joycode models). It routes through crew-proxy (:8788) -> CCR just like the ccr presets.
load_backend(){
  local b="$1" f="$BACKEND_DIR/$1.conf"
  BK_BASE_URL=""; BK_MODEL=""; BK_TOKEN=""; BK_TOKEN_CMD=""; BK_TOKEN_ENV=""; BK_ENSURE_CMD=""; BK_ENV_EXTRA=""; BK_DANGEROUS=""; BK_CLAUDE_FLAGS=""; BK_KEY_MODE=""
  if [ -f "$f" ]; then
    local BASE_URL="" MODEL="" TOKEN="" TOKEN_CMD="" TOKEN_ENV="" ENSURE_CMD="" ENV_EXTRA="" DANGEROUS="" CLAUDE_FLAGS="" KEY_MODE=""
    # shellcheck disable=SC1090
    . "$f"
    BK_BASE_URL="$BASE_URL"; BK_MODEL="$MODEL"; BK_TOKEN="$TOKEN"; BK_TOKEN_CMD="$TOKEN_CMD"; BK_TOKEN_ENV="$TOKEN_ENV"
    BK_ENSURE_CMD="$ENSURE_CMD"; BK_ENV_EXTRA="$ENV_EXTRA"; BK_DANGEROUS="$DANGEROUS"; BK_CLAUDE_FLAGS="$CLAUDE_FLAGS"; BK_KEY_MODE="$KEY_MODE"
  elif case "$b" in *,*) true;; *) false;; esac; then
    # synthesized ccr backend "provider,realmodel" (no preset file)
    BK_BASE_URL="http://127.0.0.1:${CREW_PROXY_PORT:-8788}"; BK_MODEL="$b"; BK_TOKEN="test"
    BK_ENV_EXTRA="MAX_THINKING_TOKENS=0 CLAUDE_CODE_DISABLE_UNKNOWN_MODEL_WINDOW_ENFORCEMENT=1"; BK_KEY_MODE="ccr"
  else
    die "backend '$b' not found ($f); pass --model <backend> or --pick. available: $(list_backends_inline)"
  fi
}

# --- api keys (switchable, independent of backend) --------------------------
# Keys live in $KEYS_FILE as `<alias>=<api-key>` lines (full-line # comments ok; no
# inline comments after the key). A session pins one with `crew --key <alias> <name>`;
# the pinned alias wins over the backend's own TOKEN/TOKEN_CMD/TOKEN_ENV and is
# remembered per session. Switching only the token (not model/base_url) is the point.
lookup_key(){
  local want="$1" line k v
  [ -f "$KEYS_FILE" ] || return 0
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in ''|'#'*) continue;; esac
    k="${line%%=*}"; v="${line#*=}"
    k="$(printf '%s' "$k" | tr -d '[:space:]')"
    v="$(printf '%s' "$v" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
    [ "$k" = "$want" ] && { printf '%s' "$v"; return 0; }
  done < "$KEYS_FILE"
  return 0
}
list_key_aliases(){ [ -f "$KEYS_FILE" ] || return 0; grep -Ev '^[[:space:]]*(#|$)' "$KEYS_FILE" 2>/dev/null | sed -E 's/[[:space:]]*=.*//;s/[[:space:]]//g' | awk 'NF'; }
mask_key(){ local s="$1" n=${#1}; if [ "$n" -le 8 ]; then printf '****'; else printf '%s...%s' "${s:0:4}" "${s: -4}"; fi; }
# For KEY_MODE=ccr backends the model is "provider,realmodel" and the key rides with the
# provider. Given a realmodel + a raw gateway key, find the ccr provider that serves that
# model with that key (from ccr's own config.json) so --key can swap the provider.
ccr_provider_for(){
  local model="$1" key="$2" cfg="$HOME/.claude-code-router/config.json"
  [ -f "$cfg" ] || return 0; command -v node >/dev/null 2>&1 || return 0
  MODEL="$model" KEY="$key" node -e '
    const fs=require("fs");
    const c=JSON.parse(fs.readFileSync(process.argv[1],"utf8"));
    const ps=c.Providers||c.providers||[];
    const hit=ps.find(p=>(p.models||[]).includes(process.env.MODEL) && (p.api_key||p.apiKey)===process.env.KEY);
    process.stdout.write(hit?hit.name:"");
  ' "$cfg" 2>/dev/null
}
# Which realmodels can a given raw gateway key serve? Union of models[] across every ccr
# provider whose api_key matches. Drives the key->model interactive menu: pick a key first,
# then choose from exactly what that key can route (joycode/personal/prod treated the same).
ccr_models_for_key(){
  local key="$1" cfg="$HOME/.claude-code-router/config.json"
  [ -f "$cfg" ] || return 0; command -v node >/dev/null 2>&1 || return 0
  KEY="$key" node -e '
    const fs=require("fs");
    const c=JSON.parse(fs.readFileSync(process.argv[1],"utf8"));
    const ps=c.Providers||c.providers||[];
    const out=[];
    for(const p of ps){ if((p.api_key||p.apiKey)===process.env.KEY) for(const m of (p.models||[])) if(!out.includes(m)) out.push(m); }
    process.stdout.write(out.join("\n"));
  ' "$cfg" 2>/dev/null
}
# --- model discovery (crew sync-models) -------------------------------------
# GET an OpenAI-style /v1/models endpoint and emit one "<owned_by>\t<id>" line per model.
# $1 = full URL, $2 = optional bearer token (sent as Authorization if non-empty). Uses curl,
# falling back to python3. Silent (empty output) on any failure — callers handle "nothing found".
fetch_models_url(){
  local url="$1" tok="${2:-}" raw=""
  if command -v curl >/dev/null 2>&1; then
    if [ -n "$tok" ]; then raw=$(curl -fsS -m 12 -H "Authorization: Bearer $tok" "$url" 2>/dev/null)
    else raw=$(curl -fsS -m 12 "$url" 2>/dev/null); fi
  elif command -v python3 >/dev/null 2>&1; then
    raw=$(URL="$url" TOK="$tok" python3 -c '
import os,sys,urllib.request
r=urllib.request.Request(os.environ["URL"])
if os.environ.get("TOK"): r.add_header("Authorization","Bearer "+os.environ["TOK"])
sys.stdout.write(urllib.request.urlopen(r,timeout=12).read().decode())' 2>/dev/null)
  fi
  [ -n "$raw" ] || return 0
  printf '%s' "$raw" | node -e '
    let s=""; process.stdin.on("data",d=>s+=d).on("end",()=>{
      let d; try{ d=JSON.parse(s); }catch(e){ return; }
      for(const m of (d.data||d.models||[])){
        const id=m.id||m.name||m.chatApiModel||m.label; if(!id) continue;
        process.stdout.write((m.owned_by||"")+"\t"+id+"\n");
      }
    });
  ' 2>/dev/null
}
# The gateway origin (scheme://host) that serves a given key: taken from any CCR provider whose
# api_key matches. Empty if the key has no provider yet (caller must then supply --base-url).
ccr_origin_for_key(){
  local key="$1" cfg="$HOME/.claude-code-router/config.json"
  [ -f "$cfg" ] || return 0; command -v node >/dev/null 2>&1 || return 0
  KEY="$key" node -e '
    const fs=require("fs");
    const c=JSON.parse(fs.readFileSync(process.argv[1],"utf8"));
    const p=(c.Providers||c.providers||[]).find(p=>(p.api_key||p.apiKey)===process.env.KEY && (p.api_base_url||p.apiBaseUrl));
    if(p){ try{ const u=new URL(p.api_base_url||p.apiBaseUrl); process.stdout.write(u.protocol+"//"+u.host); }catch(e){} }
  ' "$cfg" 2>/dev/null
}
# Resolve a pinned --key alias per the loaded backend's KEY_MODE. Shared by ensure_session
# and crew_delegate_core so both honor --key identically. token mode: sets KEY_INBOUND_OVERRIDE
# to the raw key (becomes ANTHROPIC_AUTH_TOKEN). ccr mode: rewrites BK_MODEL to the provider
# serving this model with that key. Reads BK_MODEL/BK_KEY_MODE; may mutate BK_MODEL; sets the
# global KEY_INBOUND_OVERRIDE ("" if none).
apply_key_pin(){
  local keyalias="$1"; KEY_INBOUND_OVERRIDE=""
  [ -n "$keyalias" ] && [ "$keyalias" != "-" ] || return 0
  local _kv; _kv=$(lookup_key "$keyalias")
  if [ -z "$_kv" ]; then log "WARN: key alias '$keyalias' not in $KEYS_FILE; ignoring pin"
  elif [ "${BK_KEY_MODE:-token}" = "ccr" ]; then
    local _real="${BK_MODEL##*,}" _prov
    _prov=$(ccr_provider_for "$_real" "$_kv")
    if [ -n "$_prov" ]; then BK_MODEL="$_prov,$_real"; log "key '$keyalias' -> ccr provider '$_prov' for $_real"
    else log "WARN: no ccr provider serves '$_real' with key '$keyalias'; keeping default provider"; fi
  else
    KEY_INBOUND_OVERRIDE="$_kv"
  fi
}

# --- dependency services (CCR) ----------------------------------------------
# crew's ccr-routed presets need claude-code-router (:3456) up. It's meant to run as a
# launchd agent (see README); crew_dep_up brings one up on demand by kickstarting its
# agent if the port is down. Ports and agent labels are overridable via env for other
# setups (e.g. the cloud). Optional extensions (ext/*.sh) can register extra services
# via the crew_ext_dep_up hook below.
crew_dep_up(){
  local name="$1" port="$2" mac_label="$3" linux_unit="$4" i
  shift 4  # any remaining args are a detached fallback launch command (see the elif below)
  port_listening "$port" && return 0
  if command -v launchctl >/dev/null 2>&1 && { launchctl print "gui/$(id -u)/$mac_label" >/dev/null 2>&1 || [ -f "$HOME/Library/LaunchAgents/$mac_label.plist" ]; }; then
    log "$name (:$port) down — kickstarting launchd $mac_label"
    launchctl kickstart -k "gui/$(id -u)/$mac_label" >/dev/null 2>&1 || launchctl load -w "$HOME/Library/LaunchAgents/$mac_label.plist" >/dev/null 2>&1 || true
  elif command -v systemctl >/dev/null 2>&1 && systemctl --user cat "$linux_unit" >/dev/null 2>&1; then
    log "$name (:$port) down — restarting systemd --user $linux_unit"
    systemctl --user restart "$linux_unit" >/dev/null 2>&1 || true
  elif [ "$#" -gt 0 ]; then
    # No launchd/systemd unit is installed, but the caller told us how to launch this service,
    # so start it detached (nohup) — same as setup.sh's container mode. This keeps `crew up`
    # (and session start) working with no manual step; crew relaunches it on demand when down.
    log "$name (:$port) down — launching detached: $*"
    mkdir -p "$CREW_STATE" 2>/dev/null || true
    nohup "$@" >>"$CREW_STATE/$name.nohup.log" 2>&1 & disown 2>/dev/null || true
  else
    log "WARN: $name (:$port) down; no launchd/systemd unit — start it manually (see setup.sh)."; return 0
  fi
  for i in $(seq 1 12); do port_listening "$port" && { log "$name up"; return 0; }; sleep 1; done
  log "WARN: $name (:$port) still down after restart."
  return 0
}

# Extension dependency hook. Core calls this after ensuring CCR, so an optional ext/*.sh
# can bring up its own background service. Default is a no-op; an extension overrides it.
# Arg $1 = the resolved model ("provider,realmodel", or empty in `crew up` = bring up all),
# so the extension can decide whether its service is needed for this launch. Extensions
# reuse crew_dep_up for the actual launchd/systemd kickstart.
crew_ext_dep_up(){ :; }

# crew-proxy (:8788) sits between claude and CCR for key failover. Callers ensure CCR first,
# then this. With no key-policy line for a model the proxy is a pure passthrough. If no
# launchd/systemd unit is installed (e.g. setup.sh never ran, or ran before python3 was
# present), crew_dep_up still auto-starts it detached via `python3 crew_proxy.py` so `crew up`
# just works — provided python3 and the installed proxy script are both available.
crew_proxy_up(){
  [ "${CREW_PROXY_DISABLE:-0}" = 1 ] && return 0
  local port="${CREW_PROXY_PORT:-8788}" label="${CREW_PROXY_LABEL:-com.claudecrew.proxy}"
  local unit="${CREW_PROXY_UNIT:-claudecrew-proxy}"
  local script="${CREW_PROXY_SCRIPT:-$CREW_HOME/crew_proxy.py}" py
  py="$(command -v python3 2>/dev/null || true)"
  if [ -n "$py" ] && [ -f "$script" ]; then
    crew_dep_up "crew-proxy" "$port" "$label" "$unit" "$py" "$script"
  else
    crew_dep_up "crew-proxy" "$port" "$label" "$unit"  # kickstarts a unit if one exists
    port_listening "$port" && return 0
    [ -z "$py" ] && log "WARN: crew-proxy can't auto-start — no python3 on PATH (set CREW_PROXY_DISABLE=1 to silence)."
    [ -n "$py" ] && [ ! -f "$script" ] && log "WARN: crew-proxy can't auto-start — $script missing (run setup.sh to install it)."
  fi
}

# --- interactive picker (--pick) --------------------------------------------
# One menu per knob (model -> key -> tmux), skipping any the user already gave on
# the CLI. Defaults come from the session's remembered state when it exists
# ($name.backend / $name.key), else from CREW_BACKEND / no-key / tmux. fzf if
# present (fuzzy filter), else bash `select`. Reads/writes the global BACKEND,
# BACKEND_EXPLICIT, KEY, KEY_EXPLICIT, NO_TMUX so the rest of the flow is unchanged.
# All prompts go to stderr (fzf uses the tty); only the chosen value is captured.
_pick_one(){  # _pick_one <title> <default_line>  (options on stdin, one per line) -> chosen line on stdout
  local title="$1" def="$2" chosen=""
  local opts=() line
  while IFS= read -r line; do [ -n "$line" ] && opts+=("$line"); done
  if command -v fzf >/dev/null 2>&1; then
    # Put the default first so fzf's cursor starts on it — Enter keeps the default.
    # Esc/no-match => empty => falls through to the default below.
    local ordered; ordered=$( { [ -n "$def" ] && printf '%s\n' "$def"; local o; for o in "${opts[@]}"; do [ "$o" = "$def" ] || printf '%s\n' "$o"; done; } )
    chosen=$(printf '%s\n' "$ordered" | fzf --height=40% --reverse --prompt="$title > " \
            --header="Enter=select  Esc=keep default [$def]" 2>/dev/tty) || chosen=""
  else
    local i
    printf '\n== %s ==  (number, or Enter to keep default: %s)\n' "$title" "$def" >&2
    i=1; for line in "${opts[@]}"; do printf '  %2d) %s%s\n' "$i" "$line" "$([ "$line" = "$def" ] && printf '  (default)')" >&2; i=$((i+1)); done
    local reply; printf '  choose > ' >&2; read -r reply </dev/tty
    if [ -z "$reply" ]; then chosen="$def"
    elif [ "$reply" -ge 1 ] 2>/dev/null && [ "$reply" -le "${#opts[@]}" ] 2>/dev/null; then chosen="${opts[$((reply-1))]}"
    else chosen="$def"; fi
  fi
  [ -z "$chosen" ] && chosen="$def"
  printf '%s' "$chosen"
}
# Multi-select sibling of _pick_one: options on stdin (one per line), chosen lines to stdout
# (one per line). fzf -m (Tab to mark, Enter to confirm), else a numbered menu accepting a
# comma/space list like "1,3 5", the word "all", or empty to cancel. Prompts go to stderr.
_pick_multi(){  # _pick_multi <title>  (options on stdin) -> chosen lines on stdout
  local title="$1"
  local opts=() line
  while IFS= read -r line; do [ -n "$line" ] && opts+=("$line"); done
  [ "${#opts[@]}" -eq 0 ] && return 0
  if command -v fzf >/dev/null 2>&1; then
    printf '%s\n' "${opts[@]}" | fzf --multi --height=50% --reverse --prompt="$title > " \
          --header="Tab=mark  Enter=confirm  Esc=cancel" 2>/dev/tty || true
  else
    local i
    printf '\n== %s ==  (numbers like "1,3 5", "all", or Enter to cancel)\n' "$title" >&2
    i=1; for line in "${opts[@]}"; do printf '  %2d) %s\n' "$i" "$line" >&2; i=$((i+1)); done
    local reply; printf '  choose > ' >&2; read -r reply </dev/tty
    [ -z "$reply" ] && return 0
    if [ "$reply" = all ]; then printf '%s\n' "${opts[@]}"; return 0; fi
    local tok; for tok in $(printf '%s' "$reply" | tr ',' ' '); do
      [ "$tok" -ge 1 ] 2>/dev/null && [ "$tok" -le "${#opts[@]}" ] 2>/dev/null && printf '%s\n' "${opts[$((tok-1))]}"
    done
  fi
}
interactive_pick(){  # interactive_pick <session-name>
  local name="$1"
  # Session-remembered defaults win over global defaults when this session already exists.
  local def_bk="${CREW_BACKEND:-}"; [ -f "$CREW_STATE/$name.backend" ] && def_bk=$(cat "$CREW_STATE/$name.backend")
  local def_key=""; [ -f "$CREW_STATE/$name.key" ] && def_key=$(cat "$CREW_STATE/$name.key")
  local def_key_disp; def_key_disp=$([ -n "$def_key" ] && [ "$def_key" != "-" ] && printf '%s' "$def_key" || printf '(backend default)')

  # key FIRST — skip if --key was given. "(backend default)" clears the pin (old preset-name flow).
  # A concrete key's value then drives the model menu (only models that key can route).
  if [ "${KEY_EXPLICIT:-0}" != 1 ]; then
    local chosen; chosen=$( { echo "(backend default)"; list_key_aliases; } | awk 'NF' | _pick_one "pick key" "$def_key_disp")
    case "$chosen" in "(backend default)"|"") KEY="-";; *) KEY="$chosen";; esac
    KEY_EXPLICIT=1
  fi
  # model — skip if --model was given. If a concrete key is chosen, list exactly the realmodels
  # that key serves (from CCR) and set BACKEND=provider,realmodel. Else fall back to preset names.
  if [ "${BACKEND_EXPLICIT:-0}" != 1 ]; then
    if [ -n "$KEY" ] && [ "$KEY" != "-" ]; then
      local _kv; _kv=$(lookup_key "$KEY")
      local _models; _models=$(ccr_models_for_key "$_kv")
      if [ -n "$_models" ]; then
        local _real; _real=$(printf '%s\n' "$_models" | awk 'NF' | _pick_one "pick model (key: $KEY)" "${def_bk##*,}")
        local _prov; _prov=$(ccr_provider_for "$_real" "$_kv")
        BACKEND=$([ -n "$_prov" ] && printf '%s,%s' "$_prov" "$_real" || printf '%s' "$_real")
      else
        log "WARN: key '$KEY' has no CCR provider/models; falling back to preset list"
        BACKEND=$(list_backends_inline | tr ' ' '\n' | awk 'NF' | _pick_one "pick model" "$def_bk")
      fi
    else
      BACKEND=$(list_backends_inline | tr ' ' '\n' | awk 'NF' | _pick_one "pick model" "$def_bk")
    fi
    BACKEND_EXPLICIT=1
  fi
  # tmux — skip if --tmux/--no-tmux was given
  if [ "${NO_TMUX_EXPLICIT:-0}" != 1 ]; then
    # Seed the default from the session's REMEMBERED mode if it has one, else ambient NO_TMUX.
    local _rm="$NO_TMUX"; local _mf="$CREW_STATE/${1:-}.notmux"
    [ -n "${1:-}" ] && [ -f "$_mf" ] && _rm=$(cat "$_mf" 2>/dev/null)
    local def_tm; def_tm=$([ "$_rm" = 1 ] && printf 'no-tmux (foreground)' || printf 'tmux (background, default)')
    local chosen; chosen=$(printf 'tmux (background, default)\nno-tmux (foreground)\n' | _pick_one "tmux mode" "$def_tm")
    case "$chosen" in no-tmux*) NO_TMUX=1;; *) NO_TMUX=0;; esac
  fi
  log "picked -> model: $BACKEND, key: $([ "$KEY" = "-" ] && echo '<backend default>' || echo "$KEY"), tmux: $([ "$NO_TMUX" = 1 ] && echo off || echo on)"
}

# --- session lifecycle ------------------------------------------------------
# fg_live NAME: true iff NAME is a live no-tmux (foreground) session — its mode is
# foreground AND its recorded pid is still alive. A stale pid (process gone) => not live,
# and we clean it up. Lets tmux-centric checks reason about foreground sessions too.
fg_live(){
  local nm="$1"
  local modef="$CREW_STATE/$nm.notmux" fgpidf="$CREW_STATE/$nm.fgpid" pid
  [ -f "$modef" ] && [ "$(cat "$modef" 2>/dev/null)" = 1 ] || return 1
  [ -f "$fgpidf" ] || return 1
  pid=$(cat "$fgpidf" 2>/dev/null)
  case "$pid" in ''|*[!0-9]*) return 1;; esac
  if kill -0 "$pid" 2>/dev/null; then return 0; else rm -f "$fgpidf" 2>/dev/null; return 1; fi
}
ensure_session(){
  local name="$1" backend="$2" fresh="$3" yolo="$4" no_tmux="${5:-0}" tmux_s="$TMUX_PREFIX$1"
  crew_autoprune   # opportunistic, throttled, backgrounded — never blocks this spawn
  # Adopted/external session (e.g. the main `work` session managed by bootstrap/start.sh):
  # crew doesn't spawn or own its lifecycle — the caller just attaches to the live tmux.
  if is_adopted "$name"; then
    tmux has-session -t "$(tmux_name_for "$name")" 2>/dev/null \
      || log "adopted '$name': tmux '$(tmux_name_for "$name")' not live (start it where it's managed)"
    return 0
  fi
  local bkf="$CREW_STATE/$name.backend"
  local keyf="$CREW_STATE/$name.key"
  local modef="$CREW_STATE/$name.notmux"
  local fgpidf="$CREW_STATE/$name.fgpid"
  # Mode (tmux/no-tmux) is part of session identity: unless the caller EXPLICITLY passed
  # --tmux/--no-tmux, honor the mode this session last launched with. Prevents the same
  # name resolving to two different live sessions (one tmux, one foreground).
  if [ "${NO_TMUX_EXPLICIT:-0}" != 1 ] && [ -f "$modef" ]; then
    no_tmux=$(cat "$modef" 2>/dev/null); [ "$no_tmux" = 1 ] || no_tmux=0
  fi
  # Is this session live right now, and in which mode? Look at BOTH tmux and a tracked
  # foreground pid (fg_live), so switching/re-attaching reasons about either mode.
  local live_mode=""   # "" none, "tmux", or "fg"
  if tmux has-session -t "$tmux_s" 2>/dev/null; then live_mode=tmux
  elif fg_live "$name"; then live_mode=fg; fi
  # Cross-mode: the session is already live in one mode but the caller EXPLICITLY asked for
  # the other. Don't start a second claude on the same .sid, and don't dead-end the user —
  # enter the running session as-is (its current mode wins) and note the flag was ignored.
  # Switching modes for real needs an explicit stop first (then the next launch honors it).
  if [ -n "$live_mode" ] && [ "${NO_TMUX_EXPLICIT:-0}" = 1 ]; then
    local want_mode; want_mode=$([ "$no_tmux" = 1 ] && echo fg || echo tmux)
    if [ "$want_mode" != "$live_mode" ]; then
      log "'$name' is already live in $([ "$live_mode" = fg ] && echo 'no-tmux (foreground)' || echo tmux) mode — entering that; --$([ "$no_tmux" = 1 ] && echo no-tmux || echo tmux) ignored. To switch: crew stop $name, then re-run."
      no_tmux=$([ "$live_mode" = fg ] && echo 1 || echo 0)   # align with the live session
    fi
  fi
  # If the session is already live, just re-attach — UNLESS the caller explicitly
  # asked for a DIFFERENT backend/key, in which case stop it and relaunch on the new one
  # (history preserved below via --resume). Works for BOTH tmux and foreground sessions;
  # the relaunch below uses the session's remembered mode, so a no-tmux GLM session
  # switched to kimi comes back as a no-tmux kimi session (not a stray tmux one).
  if [ -n "$live_mode" ]; then
    local running=""; [ -f "$bkf" ] && running=$(cat "$bkf")
    local running_key=""; [ -f "$keyf" ] && running_key=$(cat "$keyf")
    local want_restart=0
    if [ "${BACKEND_EXPLICIT:-0}" = 1 ] && [ "$backend" != "$running" ]; then
      log "switching '$name' backend: $running -> $backend (restart; history kept via --resume)"; want_restart=1
    fi
    if [ "${KEY_EXPLICIT:-0}" = 1 ] && [ "${KEY:-}" != "$running_key" ]; then
      log "switching '$name' key: ${running_key:-<backend default>} -> ${KEY:-<backend default>} (restart; history kept via --resume)"; want_restart=1
    fi
    if [ "$want_restart" = 1 ]; then
      if [ "$live_mode" = tmux ]; then tmux kill-session -t "$tmux_s" 2>/dev/null || true
      else kill "$(cat "$fgpidf" 2>/dev/null)" 2>/dev/null || true; rm -f "$fgpidf"; fi
    else
      return
    fi
  fi
  # Per-session backend memory: an explicit --backend wins and is remembered for
  # next time; otherwise reuse whatever backend this session last started with.
  # There is NO implicit default — if neither applies, the guard below refuses to spawn.
  if [ "${BACKEND_EXPLICIT:-0}" = 1 ]; then printf '%s\n' "$backend" > "$bkf"
  elif [ -f "$bkf" ]; then backend=$(cat "$bkf"); fi
  # Enforce explicit backend selection (option B, 2026-08-17): no plain-ambient "default".
  if [ -z "$backend" ] || [ "$backend" = default ]; then
    die "no backend selected for '$name' — pass --model <backend>, set CREW_BACKEND, or use --pick. available: $(list_backends_inline)"
  fi
  # Per-session key memory (mirrors backend memory): an explicit --key wins and sticks;
  # otherwise reuse the last pinned alias; empty/"-" alias => fall back to backend token.
  local keyalias="${KEY:-}"
  if [ "${KEY_EXPLICIT:-0}" = 1 ]; then printf '%s\n' "$keyalias" > "$keyf"
  elif [ -f "$keyf" ]; then keyalias=$(cat "$keyf"); fi
  # Friendly label for launch logs: the pinned alias name, or "<backend default>"
  # when no key is pinned (empty or "-" => fall back to the backend's own token).
  local keydisp="<backend default>"; [ -n "$keyalias" ] && [ "$keyalias" != "-" ] && keydisp="$keyalias"
  load_backend "$backend"
  # Apply a pinned --key per the backend's KEY_MODE. token (default): the key IS the inbound
  # gateway credential. ccr: swap to the provider that serves this model with that key.
  apply_key_pin "$keyalias"
  local _inbound_override="$KEY_INBOUND_OVERRIDE"
  [ -n "$BK_ENSURE_CMD" ] && { log "ensuring backend '$backend' is up..."; bash -c "$BK_ENSURE_CMD" || log "WARN: backend ENSURE_CMD failed (continuing)"; }
  # ccr-routed presets need CCR (:3456) up; extensions may need their own service (hook).
  if [ "${BK_KEY_MODE:-}" = ccr ]; then
    crew_dep_up "CCR" "${CREW_CCR_PORT:-3456}" "${CREW_CCR_LABEL:-com.claudecrew.ccr}" "${CREW_CCR_UNIT:-claudecrew-ccr}"
    crew_proxy_up
    crew_ext_dep_up "$BK_MODEL"
  fi

  local cwd; cwd=$(path_for_name "$name"); [ -z "$cwd" ] && cwd="$PWD"
  local sidf="$CREW_STATE/$name.sid" sid resume
  if [ "$fresh" = 1 ] || [ ! -f "$sidf" ]; then sid=$(gen_uuid); echo "$sid" > "$sidf"; else sid=$(cat "$sidf"); fi
  if [ "$fresh" != 1 ] && ls "$HOME"/.claude/projects/*/"$sid".jsonl >/dev/null 2>&1; then resume="--resume $sid"; else resume="--session-id $sid"; fi

  # token precedence: TOKEN_ENV (named env var, if non-empty) > TOKEN_CMD (stdout) > TOKEN (literal)
  local tok="$BK_TOKEN"
  [ -n "$BK_TOKEN_CMD" ] && tok=$(bash -c "$BK_TOKEN_CMD" 2>/dev/null)
  if [ -n "$BK_TOKEN_ENV" ]; then local _ev="${!BK_TOKEN_ENV-}"; [ -n "$_ev" ] && tok="$_ev"; fi
  # A pinned --key overrides the token (highest precedence); its value was resolved above
  # per KEY_MODE (the gateway key for token mode; ccr mode swaps the provider instead).
  [ -n "$_inbound_override" ] && tok="$_inbound_override"
  local envp=""
  [ -n "$BK_BASE_URL" ] && envp="$envp ANTHROPIC_BASE_URL=$(printf %q "$BK_BASE_URL")"
  [ -n "$tok" ]         && envp="$envp ANTHROPIC_AUTH_TOKEN=$(printf %q "$tok")"
  [ -n "$BK_ENV_EXTRA" ] && envp="$envp $BK_ENV_EXTRA"
  # Let the agent inside know its own name + where crew's state lives, so `crew send/inbox`
  # from within the session addresses the right mailbox and auto-tags the sender.
  # CREW_MODEL/CREW_KEY expose the session's current backend + key alias ("-" = backend
  # default) so the statusline can report params without shelling out to state.
  local keyexport="$keyalias"; [ -z "$keyexport" ] && keyexport="-"
  envp="$envp CREW_SESSION=$(printf %q "$name") CREW_HOME=$(printf %q "$CREW_HOME") CREW_STATE=$(printf %q "$CREW_STATE")"
  envp="$envp CREW_MODEL=$(printf %q "$backend") CREW_KEY=$(printf %q "$keyexport")"

  local flags="${BK_CLAUDE_FLAGS:-${CREW_CLAUDE_FLAGS:-}}"
  if [ "$yolo" = 1 ] || [ "$BK_DANGEROUS" = 1 ]; then
    case " $flags " in *" --dangerously-skip-permissions "*) :;; *) flags="$flags --dangerously-skip-permissions";; esac
  fi
  local modelarg=""; [ -n "$BK_MODEL" ] && modelarg="--model $BK_MODEL"

  # --no-tmux: run claude directly in THIS terminal. All the backend/key/model/--resume
  # resolution above is tmux-independent and already ran; state (.sid/.backend/.key) is
  # written, so `crew ls`/`send`/`inbox`/resume keep working. exec replaces this process
  # (never returns), mirroring the tmux cmd's own `exec $CLAUDE_BIN`.
  if [ "$no_tmux" = 1 ]; then
    log "session '$name' starting in foreground (no tmux; backend: $backend, model: ${BK_MODEL:-<default>}, key: $keydisp)"
    cd "$cwd" || die "cannot cd to $cwd"
    printf '1\n' > "$modef"           # remember mode = foreground
    printf '%s\n' "$$" > "$fgpidf"    # this shell becomes claude via exec -> $$ is claude's pid
    eval "export $envp"   # envp is space-separated, printf %q-quoted KEY=value pairs
    exec $CLAUDE_BIN $modelarg $flags $resume
  fi
  printf '0\n' > "$modef"             # remember mode = tmux
  rm -f "$fgpidf" 2>/dev/null || true # no longer a foreground session

  local cmd="cd $(printf %q "$cwd") &&$envp exec $CLAUDE_BIN $modelarg $flags $resume; echo CREW_SESSION_EXITED; exec bash -i"
  tmux set-option -g history-limit "${CREW_HISTORY_LIMIT:-200000}" 2>/dev/null || true  # keep long scrollback on attach
  # 2026-08-07 修:bash -lc 起【非交互 shell】,claude cli 检测无 TTY 自动进 --print 模式导致 "Input must be provided..." 拒启动.
  # 改用 -c 让 tmux 分配 pty,claude 拿到 TTY(仍在深挖 TUI pane 空的进一步 pty/TERM 问题).
  # 2026-08-12 追根:tmux -u new-session -d bash -c "..." 里 bash -c cmd 在 pty 存在但 detached(无 client attach)时,
  # claude --session-id + --dangerously-skip-permissions 组合触发 --print 分支,要求 stdin/prompt → 立即 exit rc=1;
  # 后续 exec bash -i 在无 client 时也立即 exit → tmux session 3s 内消失(踩过 2 次派活失败).
  # **改法**:改用 two-step spawn - 先起空 bash session,再 send-keys 灌 claude 命令.shell 是持久 session 主进程,
  # claude 是 shell 前台子进程,claude exit 后 shell 还在,不再依赖 exec bash -i 保命.
  # DEBUG(2026-08-07):写 cmd 到 /tmp/crew-last-cmd-<name>.sh 便于抓活的 shell
  { echo "#!/bin/bash"; echo "# generated by crew for session $name (two-step spawn 2026-08-12)"; echo "# step1: tmux new-session -d 空 shell; step2: send-keys 灌 claude 命令"; echo "$cmd"; } > /tmp/crew-last-cmd-"$name".sh 2>/dev/null || true
  # Step 1:起持久空 bash session
  tmux -u new-session -d -s "$tmux_s" -x 200 -y 50
  # Step 2:send-keys 灌 claude 启动命令(shell 前台跑,claude exit 后回 shell 提示符,tmux session 存活)
  # 注意:不 exec claude(否则 claude exit shell 也退),不结尾 exec bash -i(shell 已经在跑,天生持久)
  local start_cmd="cd $(printf %q "$cwd") &&$envp $CLAUDE_BIN $modelarg $flags $resume; echo CREW_SESSION_EXITED"
  tmux send-keys -t "$tmux_s" -l "$start_cmd"; sleep 0.5; tmux send-keys -t "$tmux_s" Enter
  # Mouse on for this crew session only (scoped, not global): without it the scroll wheel
  # flips through shell history instead of Claude's output. Select-to-clipboard still needs
  # a copy-mode binding in the user's ~/.tmux.conf (see README "tmux" section).
  tmux set-option -t "$tmux_s" mouse on 2>/dev/null || true
  # Reflow to whatever terminal attaches (don't stay pinned at the detached size, or a
  # smaller client sees a cropped pane and a larger one sees a small box in the corner).
  tmux set-option -t "$tmux_s" window-size latest 2>/dev/null || true
  tmux set-window-option -t "$tmux_s" aggressive-resize on 2>/dev/null || true
  log "session '$name' ready (tmux: $tmux_s, backend: $backend, model: ${BK_MODEL:-<default>}, key: $keydisp); watch: crew attach $name"
  sleep 5
}
send_task(){ local t; t=$(tmux_name_for "$1"); tmux send-keys -t "$t" -l "$2"; sleep 1; tmux send-keys -t "$t" Enter; log "fed task to '$1'; watch: crew attach $1"; }

# --- one-shot delegation -----------------------------------------------------
# `crew delegate --model X "task"` runs a one-shot `claude -p` sub-agent on a crew
# backend and prints its result to stdout — no tmux, no session, no --resume. Reuses
# load_backend + the same env assembly as ensure_session.
crew_delegate_core(){
  local backend="$1"; shift; local task="$*"
  { [ -z "$backend" ] || [ "$backend" = default ]; } && die "delegate needs an explicit backend with a base URL (e.g. --model glm). available: $(list_backends_inline)"
  [ -n "$task" ] || die "usage: crew delegate --model <name> \"<task>\""
  load_backend "$backend"
  apply_key_pin "${KEY:-}"   # honor --key (ccr: swaps provider; token: overrides inbound below)
  [ -n "$BK_ENSURE_CMD" ] && { log "ensuring backend '$backend' is up..."; bash -c "$BK_ENSURE_CMD" >&2 || log "WARN: ENSURE_CMD failed (continuing)"; }
  if [ "${BK_KEY_MODE:-}" = ccr ]; then
    crew_dep_up "CCR" "${CREW_CCR_PORT:-3456}" "${CREW_CCR_LABEL:-com.claudecrew.ccr}" "${CREW_CCR_UNIT:-claudecrew-ccr}" >&2
    crew_proxy_up >&2
    crew_ext_dep_up "$BK_MODEL"
  fi
  local tok="$BK_TOKEN"
  [ -n "$BK_TOKEN_CMD" ] && tok=$(bash -c "$BK_TOKEN_CMD" 2>/dev/null)
  if [ -n "$BK_TOKEN_ENV" ]; then local _ev="${!BK_TOKEN_ENV-}"; [ -n "$_ev" ] && tok="$_ev"; fi
  [ -n "$KEY_INBOUND_OVERRIDE" ] && tok="$KEY_INBOUND_OVERRIDE"
  local modelarg=""; [ -n "$BK_MODEL" ] && modelarg="--model $BK_MODEL"
  local flags="${BK_CLAUDE_FLAGS:-${CREW_CLAUDE_FLAGS:-}}"
  [ -n "$BK_BASE_URL" ] && export ANTHROPIC_BASE_URL="$BK_BASE_URL"
  [ -n "$tok" ]         && export ANTHROPIC_AUTH_TOKEN="$tok"
  [ -n "$BK_ENV_EXTRA" ] && eval "export $BK_ENV_EXTRA"
  log "delegating to '$backend' (model: ${BK_MODEL:-<default>}) via claude -p..."
  exec $CLAUDE_BIN -p $modelarg $flags "$task"
}

# --- optional extensions -----------------------------------------------------
# Core crew = tmux + a CCR/proxy-routed model preset. Optional add-ons live as ext/*.sh that
# define extra subcommand functions and are sourced if present from $CREW_HOME/ext. Nothing
# in core depends on them; a fresh install with no ext/ is pure tmux + CCR.
for _ext in "$CREW_HOME"/ext/*.sh; do [ -e "$_ext" ] && . "$_ext"; done

# --- inter-session mailbox (async) -----------------------------------------
# Messages are files under $CREW_STATE/inbox/<name>/ (file-per-message = no append race).
# `crew send` drops a message; the recipient reads it with `crew inbox` when it's ready.
# Because `crew` is on PATH inside a session, an agent can `crew send other "..."` itself.
inbox_dir(){ echo "$CREW_STATE/inbox/$1"; }
whoami_session(){
  local w="${CREW_SESSION:-}"
  [ -z "$w" ] && [ -f "$REG" ] && w=$(awk -F'\t' -v p="$PWD" '$1==p{print $2}' "$REG" | head -1)
  echo "$w"
}
deliver(){   # deliver <to> <from> <msg>
  local to="$1" from="$2" msg="$3" dir; dir=$(inbox_dir "$to"); mkdir -p "$dir"
  { printf '%s\t%s\n' "$from" "$(date '+%Y-%m-%d %H:%M:%S')"; printf '%s\n' "$msg"; } > "$dir/$(date +%Y%m%d-%H%M%S)-$$-${RANDOM}.msg"
}
nudge(){     # nudge <to> <from>
  local t; t=$(tmux_name_for "$1")
  tmux has-session -t "$t" 2>/dev/null || return 0
  tmux send-keys -t "$t" -l "[crew] new mail from $2 — run: crew inbox"; sleep 1; tmux send-keys -t "$t" Enter
}
crew_send(){
  local to="$1"; shift 2>/dev/null || true; local msg="$*"
  [ -n "$to" ] || die "usage: crew send [--from X] [--nudge] <name> \"message\""
  [ -n "$msg" ] || die "empty message"
  local from="${FROM:-$(whoami_session)}"; [ -z "$from" ] && from="cli"
  deliver "$to" "$from" "$msg"
  log "queued -> inbox of '$to' (from $from)"
  [ "${NUDGE:-0}" = 1 ] && { nudge "$to" "$from" && log "nudged '$to'"; } || true
}
crew_broadcast(){  # crew send --all "msg"  → every running crew session (except self)
  local msg="$*"; [ -n "$msg" ] || die "usage: crew send --all \"message\""
  local from="${FROM:-$(whoami_session)}"; [ -z "$from" ] && from="cli"
  local names n; names=$(tmux ls 2>/dev/null | sed -n "s/^$TMUX_PREFIX\([^:]*\):.*/\1/p"); local cnt=0
  for n in $names; do [ "$n" = "$from" ] && continue; deliver "$n" "$from" "$msg"; [ "${NUDGE:-0}" = 1 ] && nudge "$n" "$from"; cnt=$((cnt+1)); done
  log "broadcast to $cnt session(s) (from $from)"
}
crew_inbox(){
  local who="${1:-$(whoami_session)}"
  [ -n "$who" ] || die "which inbox? pass a name or run inside a crew session"
  local dir; dir=$(inbox_dir "$who"); local files; files=$(ls "$dir"/*.msg 2>/dev/null | sort)
  [ -z "$files" ] && { echo "(inbox empty for '$who')"; return 0; }
  local f n=0 hdr
  for f in $files; do
    n=$((n+1)); hdr=$(head -1 "$f")
    echo "── #$n  from ${hdr%%$'\t'*}  at ${hdr#*$'\t'} ──"
    tail -n +2 "$f"; echo ""
    [ "${PEEK:-0}" = 1 ] || rm -f "$f"
  done
  [ "${PEEK:-0}" = 1 ] && echo "(peeked $n; not consumed — omit --peek to consume)" || echo "(consumed $n message(s))"
}

# --- full transcript (the complete analysis, unlike attach's limited scrollback) --------
# `attach` only shows tmux's scrollback and Claude's TUI redraws in place, so long runs
# scroll out of reach. The authoritative record is Claude Code's own session JSONL; crew
# knows each session's id, so `crew log <name>` renders the full turn-by-turn trail.
crew_log(){
  local who="${1:-$(whoami_session)}"
  [ -n "$who" ] || die "which session? pass a name or run inside a crew session"
  local sidf="$CREW_STATE/$who.sid"; [ -f "$sidf" ] || die "no session id for '$who' (has it run yet?)"
  local sid; sid=$(cat "$sidf"); local jf; jf=$(ls -t "$HOME"/.claude/projects/*/"$sid".jsonl 2>/dev/null | head -1)
  [ -n "$jf" ] || die "no transcript file yet for '$who' (sid $sid)"
  if [ "${RAW:-0}" = 1 ] || ! command -v node >/dev/null 2>&1; then echo "# transcript: $jf"; cat "$jf"; return 0; fi
  CREW_JF="$jf" CREW_TAIL="${LOGTAIL:-0}" node -e '
    const fs=require("fs");
    let L=fs.readFileSync(process.env.CREW_JF,"utf8").split("\n").filter(Boolean);
    const t=Number(process.env.CREW_TAIL)||0; if(t>0) L=L.slice(-t);
    const s=x=>{x=String(x==null?"":x).replace(/\s+/g," ").trim(); return x.length>2000?x.slice(0,2000)+" …[+more]":x;};
    for(const ln of L){ let o; try{o=JSON.parse(ln)}catch(e){continue;}
      const m=o.message||o, role=m.role||o.type||"?", c=m.content;
      if(typeof c==="string"){ if(c.trim()) console.log(`\n【${role}】 ${s(c)}`); continue; }
      if(!Array.isArray(c)) continue;
      for(const p of c){
        if(p.type==="text"&&p.text&&p.text.trim()) console.log(`\n【${role}】 ${s(p.text)}`);
        else if(p.type==="thinking") console.log(`\n【${role}·thinking】 ${s(p.thinking||p.text)}`);
        else if(p.type==="tool_use") console.log(`\n  ⏺ ${p.name}(${s(JSON.stringify(p.input))})`);
        else if(p.type==="tool_result"){ let r=p.content; if(Array.isArray(r)) r=r.map(x=>x&&x.text||"").join(" "); console.log(`  ⎿ ${s(r)}`); }
      }
    }
  '
}

# --- arg parsing ------------------------------------------------------------
BACKEND="${CREW_BACKEND:-}"; BACKEND_EXPLICIT=0; KEY=""; KEY_EXPLICIT=0; FRESH=0; YOLO="${CREW_YOLO:-1}"; NO_TMUX="${CREW_NO_TMUX:-0}"; NO_TMUX_EXPLICIT=0; PICK=0; FROM=""; NUDGE=0; PEEK=0; ALLTGT=0; RAW=0; LOGTAIL=0; POS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --model|--backend) BACKEND="${2:?--model needs a value (see: crew models)}"; BACKEND_EXPLICIT=1; shift 2;;
    --model=*|--backend=*) BACKEND="${1#*=}"; BACKEND_EXPLICIT=1; shift;;
    --key) KEY="${2:?--key needs an alias (or - to clear)}"; KEY_EXPLICIT=1; shift 2;;
    --key=*) KEY="${1#*=}"; KEY_EXPLICIT=1; shift;;
    --fresh) FRESH=1; shift;;
    --yolo)  YOLO=1; shift;;
    --safe|--no-yolo) YOLO=0; shift;;
    --no-tmux) NO_TMUX=1; NO_TMUX_EXPLICIT=1; shift;;
    --tmux)    NO_TMUX=0; NO_TMUX_EXPLICIT=1; shift;;
    --pick|-p) PICK=1; shift;;
    --from) FROM="${2:?--from needs a value}"; shift 2;;
    --nudge) NUDGE=1; shift;;
    --peek) PEEK=1; shift;;
    --all) ALLTGT=1; shift;;
    --raw) RAW=1; shift;;
    --tail) LOGTAIL="${2:?--tail needs a number}"; shift 2;;
    --) shift; while [ $# -gt 0 ]; do POS+=("$1"); shift; done;;
    *) POS+=("$1"); shift;;
  esac
done
set -- ${POS[@]+"${POS[@]}"}

case "${1:-}" in
  ls)
    # List every session crew knows about from on-disk state (registry + .sid files),
    # NOT just the live tmux ones. tmux dies on host restart, but a session's id +
    # transcript persist on disk, so `crew <name>` still resumes it with full history.
    # Status: live = running in tmux now | resumable = dormant, has a saved transcript
    #         (`crew <name>` restores it) | new = has an id but no transcript yet.
    # `crew ls --json` emits the same data as a JSON array (consumed by crew-proxy's
    # dashboard) — one code path computes status, so CLI and dashboard never diverge.
    ls_json=0; [ "${2:-}" = "--json" ] && ls_json=1
    names=$( { [ -f "$REG" ] && awk -F'\t' 'NF>=2{print $2}' "$REG"
               ls "$CREW_STATE"/*.sid 2>/dev/null | sed 's:.*/::;s:\.sid$::'
             } | sort -u )
    # Reorder so the sessions you care about come first: the main/primary session
    # (CREW_MAIN_SESSION, default "main") pinned to the very top, then everything else by
    # most-recent activity (session_activity) descending. Both the human table and --json
    # read from $names, so the dashboard gets the same friendly order for free.
    _main_name="${CREW_MAIN_SESSION:-main}"
    names=$( printf '%s\n' "$names" | while IFS= read -r nm; do
               [ -n "$nm" ] || continue
               if [ "$nm" = "$_main_name" ]; then rank=99999999999; else rank=$(session_activity "$nm"); fi
               printf '%s\t%s\n' "$rank" "$nm"
             done | sort -t$'\t' -k1,1nr | cut -f2- )
    # emit one session's fields; sets globals nm/st/bk/ky/cwd for the caller to format
    _ls_row(){
      cwd=$(path_for_name "$nm"); [ -n "$cwd" ] || cwd="?"
      local sidf="$CREW_STATE/$nm.sid"
      if tmux has-session -t "$(tmux_name_for "$nm")" 2>/dev/null || fg_live "$nm"; then st="live"
      elif [ -f "$sidf" ] && ls "$HOME"/.claude/projects/*/"$(cat "$sidf")".jsonl >/dev/null 2>&1; then st="resumable"
      else st="new"; fi
      bk=$(cat "$CREW_STATE/$nm.backend" 2>/dev/null || echo "?")
      local _pin; _pin=$(cat "$CREW_STATE/$nm.key" 2>/dev/null); [ -n "$_pin" ] || _pin="-"
      # KEY column shows the EFFECTIVE key (what requests actually use), not just the raw pin —
      # so an unpinned session reads "personal"/"prod"/… (its key-policy primary) instead of "-".
      # Resolve via the shared crew-keyresolve.js (same logic the statusline uses). We hand it
      # this session's model + pin and blank ANTHROPIC_BASE_URL so it derives routing from the
      # backend conf rather than crew's own ambient env. Falls back to the raw pin on any failure.
      ky="$_pin"
      if [ -f "$KEYRESOLVE" ] && command -v node >/dev/null 2>&1; then
        local _eff
        _eff=$(CREW_STATE="$CREW_STATE" CREW_HOME="$CREW_HOME" CREW_MODEL="$bk" CREW_KEY="$_pin" ANTHROPIC_BASE_URL="" \
                 node "$KEYRESOLVE" "$nm" 2>/dev/null | cut -f2)
        [ -n "$_eff" ] && [ "$_eff" != "?" ] && ky="$_eff"
      fi
    }
    if [ "$ls_json" = 1 ]; then
      # JSON-escape a string (backslash, quote, control chars) for safe embedding.
      _json_str(){ printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/	/\\t/g'; }
      printf '{"sessions":['
      first=1
      while IFS= read -r nm; do
        [ -n "$nm" ] || continue
        _ls_row
        [ "$first" = 1 ] && first=0 || printf ','
        printf '{"name":"%s","status":"%s","model":"%s","key":"%s","dir":"%s"}' \
          "$(_json_str "$nm")" "$st" "$(_json_str "$bk")" "$(_json_str "$ky")" "$(_json_str "$cwd")"
      done <<EOF
$names
EOF
      printf ']}\n'
    else
      echo "== crew sessions =="
      if [ -z "$names" ]; then echo "  (none)"; else
        # Dynamic column widths: collect every row (header + sessions) and let
        # awk size each column to its widest cell. Fixed widths used to overflow
        # when a MODEL name (e.g. kimi-k3-joybuilder) or long session name beat
        # the hard-coded %-14s/%-20s, shoving KEY/DIR out of alignment — which
        # reads badly in chat clients (咚咚) that render the table monospaced.
        {
          printf '%s\t%s\t%s\t%s\t%s\n' NAME STATUS MODEL KEY DIR
          while IFS= read -r nm; do
            [ -n "$nm" ] || continue
            _ls_row
            printf '%s\t%s\t%s\t%s\t%s\n' "$nm" "$st" "$bk" "$ky" "$cwd"
          done <<EOF
$names
EOF
        } | awk -F'\t' '
          { rows[NR]=$0; if (NR==1) ncols=NF; for (i=1;i<=NF;i++) if (length($i)+1 > W[i]) W[i]=length($i)+1 }
          END {
            for (r=1;r<=NR;r++) {
              n=split(rows[r], a, "\t")
              line="  "
              for (i=1;i<=n;i++) line=line sprintf("%-*s", W[i], a[i])
              sub(/[ \t]+$/, "", line); print line
            }
          }
        '
      fi
    fi
    ;;
  whoami|me|current) die "crew whoami was removed — session params now live in the statusline (⬡ <session> · <model> · 🔑<key>)";;
  stop) [ -n "${2:-}" ] || die "usage: crew stop <name>"
    # Stop the running tmux session but KEEP its on-disk state (.sid + transcript),
    # so `crew [--backend X] <name>` resumes it later with full history. This is how
    # you switch a session's model: `crew stop <name>` then `crew --backend Y <name>`.
    if is_adopted "$2"; then die "'$2' is adopted/external (tmux '$(tmux_name_for "$2")') — crew won't stop it; manage it where it was started"; fi
    if tmux kill-session -t "$(tmux_name_for "$2")" 2>/dev/null; then
      log "stopped $2 (state kept; resume with: crew $2)"
    elif fg_live "$2"; then
      kill "$(cat "$CREW_STATE/$2.fgpid" 2>/dev/null)" 2>/dev/null && log "stopped $2 (foreground; state kept; resume with: crew $2)" || log "could not stop foreground '$2'"
      rm -f "$CREW_STATE/$2.fgpid" 2>/dev/null || true
    else
      log "no live session '$2' (nothing to stop)"
    fi
    ;;
  models|backends) echo "== models =="; for b in $(list_backends_inline); do echo "  $b"; done;;
  adopt) [ -n "${2:-}" ] && [ -n "${3:-}" ] || die "usage: crew adopt <name> <tmux-session> [--sid <uuid>] [--dir <path>] [--model <label>]"
    # Register an EXTERNALLY-managed tmux session (e.g. the main `work` session that
    # bootstrap/start.sh owns) into crew: it then shows in `crew ls`, and `crew attach/
    # send/log <name>` reach it — but crew never spawns/stops/kills it (stop/kill/prune
    # all refuse an adopted session). --sid links its Claude transcript for `crew log`.
    # NB: the tmux name is POSITIONAL (not --tmux) because --tmux is already a global
    # flag; --model is read from the global parser ($BACKEND when given explicitly).
    a_name="$2"; a_tmux="$3"; a_sid=""; a_dir="$PWD"
    a_model=""; [ "${BACKEND_EXPLICIT:-0}" = 1 ] && a_model="$BACKEND"
    shift 3
    while [ $# -gt 0 ]; do case "$1" in
      --sid) a_sid="$2"; shift 2;;
      --dir) a_dir="$2"; shift 2;;
      *) shift;;
    esac; done
    tmux has-session -t "$a_tmux" 2>/dev/null || log "warn: tmux session '$a_tmux' not live right now (adopting anyway)"
    printf '%s' "$a_tmux" > "$CREW_STATE/$a_name.tmux"
    [ -n "$a_sid" ]   && printf '%s\n' "$a_sid"   > "$CREW_STATE/$a_name.sid"
    [ -n "$a_model" ] && printf '%s\n' "$a_model" > "$CREW_STATE/$a_name.backend"
    if [ -f "$REG" ] && awk -F'\t' -v m="$a_name" '$2==m{ok=1}END{exit !ok}' "$REG"; then :; else printf '%s\t%s\n' "$a_dir" "$a_name" >> "$REG"; fi
    log "adopted '$a_name' -> tmux '$a_tmux'${a_sid:+ (sid $a_sid)}; now in crew ls / attach. stop/kill/prune will refuse it. Un-adopt: rm $CREW_STATE/$a_name.tmux"
    ;;
  prune)
    # Auto-release sessions idle > N days (default 7): kill their (usually already dead)
    # tmux and remove on-disk state so `crew ls` stops showing them. NEVER touches a live
    # session (tmux running now) or an adopted/external one. Transcripts are KEPT by
    # default (recoverable); --purge also deletes them.  crew prune [--days N] [--dry-run] [--purge]
    p_days="${CREW_PRUNE_DAYS:-7}"; p_dry=0; p_purge=0
    shift || true
    while [ $# -gt 0 ]; do case "$1" in
      --days)     p_days="$2"; shift 2;;
      --days=*)   p_days="${1#*=}"; shift;;
      --dry-run|-n) p_dry=1; shift;;
      --purge)    p_purge=1; shift;;
      *) shift;;
    esac; done
    now=$(date +%s 2>/dev/null || echo 0); cutoff=$(( now - p_days*86400 ))
    p_names=$( { [ -f "$REG" ] && awk -F'\t' 'NF>=2{print $2}' "$REG"
                 ls "$CREW_STATE"/*.sid 2>/dev/null | sed 's:.*/::;s:\.sid$::'
               } | sort -u )
    reaped=0; kept=0
    while IFS= read -r nm; do
      [ -n "$nm" ] || continue
      if tmux has-session -t "$(tmux_name_for "$nm")" 2>/dev/null || fg_live "$nm"; then kept=$((kept+1)); continue; fi   # live (tmux or foreground) -> keep
      if is_adopted "$nm"; then kept=$((kept+1)); continue; fi                                            # external -> keep
      sidf="$CREW_STATE/$nm.sid"; last=0
      if [ -f "$sidf" ]; then s=$(cat "$sidf" 2>/dev/null)
        for j in "$HOME"/.claude/projects/*/"$s".jsonl; do [ -f "$j" ] || continue; m=$(mtime "$j"); [ "$m" -gt "$last" ] && last=$m; done
      fi
      for f in "$sidf" "$CREW_STATE/$nm.backend" "$CREW_STATE/$nm.key"; do [ -f "$f" ] || continue; m=$(mtime "$f"); [ "$m" -gt "$last" ] && last=$m; done
      if [ "$last" = 0 ] || [ "$now" = 0 ] || [ "$last" -ge "$cutoff" ]; then kept=$((kept+1)); continue; fi  # indeterminate/fresh -> keep
      age_d=$(( (now-last)/86400 ))
      if [ "$p_dry" = 1 ]; then echo "  would release '$nm' (idle ${age_d}d)"; reaped=$((reaped+1)); continue; fi
      tmux kill-session -t "$(tmux_name_for "$nm")" 2>/dev/null || true
      if [ "$p_purge" = 1 ] && [ -f "$sidf" ]; then s=$(cat "$sidf" 2>/dev/null); rm -f "$HOME"/.claude/projects/*/"$s".jsonl 2>/dev/null || true; fi
      rm -f "$sidf" "$CREW_STATE/$nm.backend" "$CREW_STATE/$nm.key" "$CREW_STATE/$nm.notmux" "$CREW_STATE/$nm.fgpid"
      if [ -f "$REG" ]; then t=$(mktemp) && awk -F'\t' -v m="$nm" '$2!=m' "$REG" > "$t" && mv "$t" "$REG"; fi
      echo "  released '$nm' (idle ${age_d}d$( [ "$p_purge" = 1 ] && printf ', transcript purged'))"
      reaped=$((reaped+1))
    done <<EOF
$p_names
EOF
    [ "$p_dry" = 1 ] || { [ "$now" = 0 ] || printf '%s' "$now" > "$CREW_STATE/.last-prune" 2>/dev/null || true; }
    echo "== prune: released $reaped, kept $kept (threshold ${p_days}d$( [ "$p_dry" = 1 ] && printf ', dry-run'))"
    ;;
  up) crew_dep_up "CCR" "${CREW_CCR_PORT:-3456}" "${CREW_CCR_LABEL:-com.claudecrew.ccr}" "${CREW_CCR_UNIT:-claudecrew-ccr}"; crew_proxy_up; crew_ext_dep_up ""; crew_autoprune;;
  doctor)
    # Read-only health check: services up? config sane? every key-policy alias resolvable?
    echo "== crew doctor =="
    ccrp="${CREW_CCR_PORT:-3456}"; prxp="${CREW_PROXY_PORT:-8788}"
    if port_listening "$ccrp"; then echo "  [ok]   CCR listening on :$ccrp"; else echo "  [WARN] CCR not listening on :$ccrp (crew up, or check launchd/systemd)"; fi
    if port_listening "$prxp"; then echo "  [ok]   crew-proxy listening on :$prxp"; else echo "  [WARN] crew-proxy not listening on :$prxp (optional; presets point here)"; fi
    if [ -f "$KEYS_FILE" ]; then echo "  [ok]   keys.conf present ($(list_key_aliases | grep -c . ) alias(es))"; else echo "  [WARN] no keys.conf at $KEYS_FILE"; fi
    pol="$CREW_HOME/key-policy.conf"
    if [ ! -f "$pol" ]; then echo "  [ok]   no key-policy.conf (single-key passthrough — nothing to check)"
    else
      echo "  key-policy.conf:"
      while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in ''|'#'*) continue;; esac
        m="${line%%=*}"; m="$(printf '%s' "$m" | tr -d '[:space:]')"; rest="${line#*=}"
        [ -n "$m" ] || continue
        for al in $rest; do
          kv=$(lookup_key "$al")
          if [ -z "$kv" ]; then echo "    [ERR]  $m: alias '$al' not in keys.conf"
          elif [ -z "$(ccr_provider_for "$m" "$kv")" ]; then echo "    [ERR]  $m: no CCR provider serves '$m' with key '$al'"
          else echo "    [ok]   $m ← $al"; fi
        done
      done < "$pol"
    fi;;
  stats)
    # Show crew-proxy usage (key health + token totals) in the terminal — reads the same
    # /api/status the dashboard uses. Needs crew-proxy running (crew up).
    prxp="${CREW_PROXY_PORT:-8788}"; url="http://127.0.0.1:$prxp/api/status"
    if command -v curl >/dev/null 2>&1; then raw=$(curl -fsS "$url" 2>/dev/null)
    elif command -v python3 >/dev/null 2>&1; then raw=$(python3 -c 'import sys,urllib.request;sys.stdout.write(urllib.request.urlopen(sys.argv[1],timeout=3).read().decode())' "$url" 2>/dev/null)
    else die "need curl or python3 to fetch $url"; fi
    [ -n "$raw" ] || die "crew-proxy not reachable on :$prxp (crew up first?)"
    command -v python3 >/dev/null 2>&1 || die "crew stats needs python3 to format output"
    printf '%s' "$raw" | python3 -c '
import sys, json
d = json.load(sys.stdin)
t = d.get("totals", {})
def k(n):
    n = n or 0
    return "%.1fM" % (n/1e6) if n>=1e6 else "%.1fk" % (n/1e3) if n>=1e3 else str(n)
print("== crew-proxy stats ==")
print("  :%s  ->  %s   trip@%s cooldown %ss" % (d.get("port"), d.get("ccr_url"), d.get("fail_n"), d.get("cooldown")))
print("  totals: req %s  ok %s  fail %s  tok %sin / %sout" % (t.get("requests",0), t.get("ok",0), t.get("fail",0), k(t.get("in_tokens")), k(t.get("out_tokens"))))
ks = d.get("keys", [])
if ks:
    print("  keys:")
    print("    %-14s %-9s %8s %6s %6s %8s %8s" % ("ALIAS","STATE","REQ","OK","FAIL","IN","OUT"))
    for x in ks:
        print("    %-14s %-9s %8s %6s %6s %8s %8s" % (x.get("alias",""), x.get("state",""), x.get("requests",0), x.get("ok",0), x.get("fail",0), k(x.get("in_tokens")), k(x.get("out_tokens"))))
ms = d.get("models", [])
if ms:
    print("  models:")
    print("    %-28s %8s %8s %8s" % ("MODEL","REQ","IN","OUT"))
    for x in ms:
        print("    %-28s %8s %8s %8s" % (x.get("model",""), x.get("requests",0), k(x.get("in_tokens")), k(x.get("out_tokens"))))
' || die "failed to parse crew-proxy response";;
  keys) echo "== api keys ($KEYS_FILE) =="
    if [ ! -f "$KEYS_FILE" ]; then echo "  (no keys file; create it with lines: <alias>=<api-key>)";
    else
      als=$(list_key_aliases)
      if [ -z "$als" ]; then echo "  (none)"; else
        while IFS= read -r a; do [ -n "$a" ] || continue; printf '  %-16s %s\n' "$a" "$(mask_key "$(lookup_key "$a")")"; done <<EOF
$als
EOF
      fi
    fi;;
  add-key|add-api)
    # Interactively add a NEW API endpoint + key as a DIRECT token backend — crew talks to the
    # API directly (no local CCR). Queries <base>/v1/models with the key to list the models that
    # key may use, you pick one, and a ready-to-run backend conf is written to BACKEND_DIR. Then
    # `crew --model <name> <session>` uses it. (To fold a key's models into your LOCAL CCR
    # instead, use `crew sync-models`.) Flags allow non-interactive/scripted use:
    #   crew add-key [<name>] [--base-url <url>] [--key <k>] [--model <m>]
    # With an explicit --model, /v1/models discovery is skipped (for APIs that don't expose it).
    command -v node >/dev/null 2>&1 || die "crew add-key needs node (to read /v1/models)"
    shift 2>/dev/null || true
    ak_name=""; ak_base=""
    # --key and --model are eaten by the GLOBAL parser (into KEY / BACKEND) before we get here,
    # exactly like sync-models reads $KEY. For add-key, --key's value is the RAW new key (it need
    # not be a keys.conf alias). --base-url is not global, so it survives in the positionals.
    ak_key=""; [ "${KEY_EXPLICIT:-0}" = 1 ] && [ "${KEY:-}" != "-" ] && ak_key="$KEY"
    ak_model=""; [ "${BACKEND_EXPLICIT:-0}" = 1 ] && ak_model="$BACKEND"
    while [ $# -gt 0 ]; do
      case "$1" in
        --base-url) ak_base="${2:-}"; shift 2;;
        --base-url=*) ak_base="${1#*=}"; shift;;
        -*) shift;;
        *) [ -z "$ak_name" ] && ak_name="$1"; shift;;
      esac
    done
    # 1) backend name (must be a fresh conf we won't clobber)
    if [ -z "$ak_name" ]; then printf '  backend name (e.g. remote) > ' >&2; read -r ak_name </dev/tty || true; fi
    [ -n "$ak_name" ] || die "no name given"
    case "$ak_name" in *[!A-Za-z0-9._-]*) die "invalid name '$ak_name' (letters, digits, . _ - only)";; esac
    ak_conf="$BACKEND_DIR/$ak_name.conf"
    [ -e "$ak_conf" ] && die "backend '$ak_name' already exists ($ak_conf) — choose another name, or 'crew kill'/remove it first"
    # 2) API base URL (origin only, no path)
    if [ -z "$ak_base" ]; then printf '  API base URL (scheme://host:port, no path) > ' >&2; read -r ak_base </dev/tty || true; fi
    [ -n "$ak_base" ] || die "no base URL given"
    ak_base="${ak_base%/}"
    case "$ak_base" in http://*|https://*) :;; *) die "base URL must start with http:// or https://";; esac
    # 3) key (silent input)
    if [ -z "$ak_key" ]; then printf '  login key (input hidden) > ' >&2; read -rs ak_key </dev/tty || true; echo >&2; fi
    [ -n "$ak_key" ] || die "no key given"
    # 4) model — discover via /v1/models unless one was given explicitly
    if [ -z "$ak_model" ]; then
      log "querying $ak_base/v1/models for models this key can use ..."
      ak_remote=$(fetch_models_url "$ak_base/v1/models" "$ak_key")
      ak_ids=$(printf '%s\n' "$ak_remote" | awk -F'\t' 'NF{print ($2!=""?$2:$1)}' | awk 'NF')
      [ -n "$ak_ids" ] || die "$ak_base/v1/models returned no models (bad key, wrong URL, or the API doesn't expose /v1/models). Re-run with --model <name> to skip discovery."
      ak_model=$(printf '%s\n' "$ak_ids" | _pick_one "pick model for '$ak_name'" "$(printf '%s\n' "$ak_ids" | head -1)")
    fi
    [ -n "$ak_model" ] || die "no model chosen"
    # 5) write the direct token backend conf (mode 600 — it holds a key)
    mkdir -p "$BACKEND_DIR"
    {
      printf '# Added by `crew add-key` — direct token backend to an Anthropic-compatible API.\n'
      printf '# TOKEN is sent as the inbound credential (ANTHROPIC_AUTH_TOKEN / x-api-key).\n'
      printf 'BASE_URL=%s\n' "$ak_base"
      printf 'MODEL=%s\n' "$ak_model"
      printf 'TOKEN=%s\n' "$ak_key"
      printf 'KEY_MODE=token\n'
      printf 'ENV_EXTRA="MAX_THINKING_TOKENS=0 CLAUDE_CODE_DISABLE_UNKNOWN_MODEL_WINDOW_ENFORCEMENT=1"\n'
    } > "$ak_conf" || die "write failed: $ak_conf"
    chmod 600 "$ak_conf" 2>/dev/null || true
    echo "== added backend '$ak_name' -> $ak_base  (model: $ak_model)"
    echo "   use it:  crew --model $ak_name <session>"
    ;;
  sync-models)
    # Discover models a key can serve upstream and (interactively) add the ones you don't have
    # locally into CCR. Pick a key first, then a multi-select of NEW models. joycode is a key
    # too: it's discovered from the joycode proxy (:8765) and refreshes the joycode/joycode-oai
    # providers; other keys hit their gateway's /v1/models and get one provider per model.
    # --key <alias> is parsed globally (into KEY); --base-url <url> is read from the positionals.
    sm_key=""; [ "${KEY_EXPLICIT:-0}" = 1 ] && [ "${KEY:-}" != "-" ] && sm_key="$KEY"
    sm_base=""
    shift 2>/dev/null || true   # drop the "sync-models" positional; rest may hold --base-url
    while [ $# -gt 0 ]; do
      case "$1" in
        --base-url) sm_base="${2:-}"; shift 2;;
        --base-url=*) sm_base="${1#*=}"; shift;;
        *) shift;;
      esac
    done
    command -v node >/dev/null 2>&1 || die "crew sync-models needs node"
    # 1) pick key (joycode included)
    if [ -z "$sm_key" ]; then
      sm_key=$(list_key_aliases | awk 'NF' | _pick_one "pick key to sync" "")
      [ -n "$sm_key" ] || die "no key chosen"
    fi
    sm_kv=$(lookup_key "$sm_key"); [ -n "$sm_kv" ] || die "key alias '$sm_key' not in $KEYS_FILE"
    ccrcfg="$HOME/.claude-code-router/config.json"
    [ -f "$ccrcfg" ] || die "CCR config not found ($ccrcfg)"
    # 2) fetch upstream models (owned_by<TAB>id lines) per key type
    is_joycode=0; [ "$sm_kv" = joycode ] && is_joycode=1
    if [ "$is_joycode" = 1 ]; then
      jport="${JOYCODE_PORT:-8765}"
      sm_remote=$(fetch_models_url "http://127.0.0.1:$jport/v1/models" "")
      [ -n "$sm_remote" ] || die "joycode proxy (:$jport) returned no models — is it up (crew up) and are you logged in to JoyCode in VS Code?"
    else
      [ -n "$sm_base" ] || sm_base=$(ccr_origin_for_key "$sm_kv")
      [ -n "$sm_base" ] || die "can't determine gateway URL for key '$sm_key' (no CCR provider uses it yet); pass --base-url <origin>"
      sm_base="${sm_base%/}"
      sm_remote=$(fetch_models_url "$sm_base/v1/models" "$sm_kv")
      [ -n "$sm_remote" ] || die "gateway $sm_base/v1/models returned no models (auth/URL problem?)"
    fi
    # 3) diff against what this key already serves locally (remote ids minus local ids)
    sm_have=$(ccr_models_for_key "$sm_kv")
    sm_new=$(HAVE="$sm_have" awk -F'\t' '
      BEGIN{ n=split(ENVIRON["HAVE"],h,"\n"); for(i=1;i<=n;i++) if(h[i]!="") seen[h[i]]=1 }
      NF{ id=$2; if(id!="" && !(id in seen) && !(id in done)){ done[id]=1; print id } }
    ' <<EOF
$sm_remote
EOF
)
    if [ -z "$sm_new" ]; then echo "== sync-models: '$sm_key' already has every upstream model =="; exit 0; fi
    echo "== sync-models: '$sm_key' — $(printf '%s\n' "$sm_new" | grep -c .) new model(s) upstream ==" >&2
    # 4) multi-select which to add
    sm_pick=$(printf '%s\n' "$sm_new" | _pick_multi "add to key '$sm_key'")
    sm_pick=$(printf '%s\n' "$sm_pick" | awk 'NF')
    [ -n "$sm_pick" ] || { echo "nothing selected — no changes"; exit 0; }
    # 5) write back (backup first, node atomic write). Pass owned_by map so node can classify.
    sm_bak="$ccrcfg.bak.$(date +%s 2>/dev/null || echo manual)"
    cp "$ccrcfg" "$sm_bak" || die "backup failed"
    sm_added=$(CCR_CFG="$ccrcfg" ALIAS="$sm_key" KV="$sm_kv" ISJC="$is_joycode" BASE="$sm_base" \
      REMOTE="$sm_remote" PICK="$sm_pick" node -e '
      const fs=require("fs");
      const cfg=JSON.parse(fs.readFileSync(process.env.CCR_CFG,"utf8"));
      cfg.Providers=cfg.Providers||[];
      const owner={}; for(const ln of (process.env.REMOTE||"").split("\n")){ const i=ln.indexOf("\t"); if(i<0)continue; owner[ln.slice(i+1)]=ln.slice(0,i); }
      const pick=(process.env.PICK||"").split("\n").map(s=>s.trim()).filter(Boolean);
      const isjc=process.env.ISJC==="1", alias=process.env.ALIAS, kv=process.env.KV, base=(process.env.BASE||"").replace(/\/$/,"");
      // classify: joycode -> by name(Claude); gateway -> by owned_by(anthropic)
      const isAnthropic=m=> isjc ? /claude/i.test(m) : (owner[m]||"").toLowerCase()==="anthropic";
      let added=0, skipped=[];
      if(isjc){
        const pj=cfg.Providers.find(p=>p.name==="joycode"), po=cfg.Providers.find(p=>p.name==="joycode-oai");
        for(const m of pick){
          if(m.indexOf(" ")>=0){ skipped.push(m+"(space)"); continue; }
          const tgt=isAnthropic(m)?pj:po;
          if(!tgt){ skipped.push(m+"(no joycode provider)"); continue; }
          tgt.models=tgt.models||[]; if(!tgt.models.includes(m)){ tgt.models.push(m); added++; }
        }
      } else {
        for(const m of pick){
          if(m.indexOf(" ")>=0){ skipped.push(m+"(space)"); continue; }
          const anth=isAnthropic(m);
          const pname=m+"-"+alias;
          if(cfg.Providers.some(p=>p.name===pname)){ skipped.push(m+"(exists)"); continue; }
          cfg.Providers.push({ name:pname,
            api_base_url: base + (anth?"/anthropic/v1/messages":"/v1/chat/completions"),
            api_key: kv, models:[m], transformer:{ use:[anth?"Anthropic":"OpenAI"] } });
          added++;
        }
      }
      const tmp=process.env.CCR_CFG+".tmp";
      fs.writeFileSync(tmp, JSON.stringify(cfg,null,2)); fs.renameSync(tmp, process.env.CCR_CFG);
      process.stderr.write("added "+added+(skipped.length?("; skipped: "+skipped.join(", ")):"")+"\n");
      process.stdout.write(String(added));
    ') || { echo "write failed; config restored from $sm_bak"; cp "$sm_bak" "$ccrcfg"; exit 1; }
    echo "== sync-models: added $sm_added provider/model(s) to key '$sm_key' (backup: $sm_bak) =="
    # 6) reload CCR only if something changed
    if [ "${sm_added:-0}" -gt 0 ] 2>/dev/null; then
      crew_dep_up "CCR" "${CREW_CCR_PORT:-3456}" "${CREW_CCR_LABEL:-com.claudecrew.ccr}" "${CREW_CCR_UNIT:-claudecrew-ccr}" >/dev/null 2>&1
      if command -v launchctl >/dev/null 2>&1; then launchctl kickstart -k "gui/$(id -u)/${CREW_CCR_LABEL:-com.claudecrew.ccr}" >/dev/null 2>&1 || true
      elif command -v systemctl >/dev/null 2>&1; then systemctl --user restart "${CREW_CCR_UNIT:-claudecrew-ccr}" >/dev/null 2>&1 || true; fi
      echo "  restarted CCR — new models are live (crew, pick '$sm_key')"
    fi;;
  attach) [ -n "${2:-}" ] || die "usage: crew attach <name>"; fg_live "$2" && die "'$2' runs in the foreground of another terminal — not attachable; switch to it there or 'crew stop $2'"; exec tmux -u attach -t "$(tmux_name_for "$2")";;
  kill) [ -n "${2:-}" ] || die "usage: crew kill <name> [--purge]"
    nm="$2"; purge=0; [ "${3:-}" = "--purge" ] && purge=1
    # Fully delete the session so it stops showing in `crew ls`: kill the tmux
    # session (if any) AND remove its on-disk state (.sid + registry line).
    # --purge additionally deletes the saved Claude transcript (irreversible).
    if is_adopted "$nm"; then die "'$nm' is adopted/external (tmux '$(tmux_name_for "$nm")') — crew won't kill it. Un-adopt: rm $CREW_STATE/$nm.tmux"; fi
    tmux kill-session -t "$(tmux_name_for "$nm")" 2>/dev/null && log "killed tmux session $nm" || true
    if fg_live "$nm"; then kill "$(cat "$CREW_STATE/$nm.fgpid" 2>/dev/null)" 2>/dev/null && log "killed foreground session $nm" || true; fi
    sidf="$CREW_STATE/$nm.sid"
    if [ "$purge" = 1 ] && [ -f "$sidf" ]; then
      psid=$(cat "$sidf"); rm -f "$HOME"/.claude/projects/*/"$psid".jsonl 2>/dev/null && log "purged transcript $psid" || true
    fi
    rm -f "$sidf" "$CREW_STATE/$nm.backend" "$CREW_STATE/$nm.key" "$CREW_STATE/$nm.notmux" "$CREW_STATE/$nm.fgpid"
    if [ -f "$REG" ]; then t=$(mktemp) && awk -F'\t' -v m="$nm" '$2!=m' "$REG" > "$t" && mv "$t" "$REG"; fi
    log "deleted session '$nm' (tmux + sid + registry$( [ "$purge" = 1 ] && printf ' + transcript' ))"
    ;;
  delegate) shift; crew_delegate_core "$BACKEND" "$@";;
  send) shift; if [ "$ALLTGT" = 1 ]; then crew_broadcast "$@"; else crew_send "$@"; fi;;
  inbox) shift; crew_inbox "$@";;
  log) shift; crew_log "$@";;
  ""|-h|--help)
    if [ "${1:-}" = "" ]; then
      # No args: prefer this directory's existing session(s). With one or more, show a menu
      # of them plus a "+ new session" entry; picking a session attaches it, picking new runs
      # the --pick flow for a fresh session. With none, go straight to --pick for a new one.
      existing=$(sessions_for_cwd "$PWD")
      NEW_LABEL="+ new session"
      if [ -n "$existing" ]; then
        chosen=$(printf '%s\n%s\n' "$existing" "$NEW_LABEL" | _pick_one "session" "$(printf '%s' "$existing" | head -1)")
        [ -z "$chosen" ] && chosen="$(printf '%s' "$existing" | head -1)"
      else
        chosen="$NEW_LABEL"
      fi
      if [ "$chosen" = "$NEW_LABEL" ]; then
        # first session for this dir -> take the dir's base name; a further "+ new" when
        # sessions already exist -> mint a deduped fresh name.
        if [ -n "$existing" ]; then name=$(fresh_name_for_cwd "$PWD"); else name=$(resolve_name_for_cwd "$PWD"); fi
        PICK=1; interactive_pick "$name"
      else
        name="$chosen"   # attach an existing session as-is (its remembered model/key stick)
      fi
      ensure_session "$name" "$BACKEND" "$FRESH" "$YOLO" "$NO_TMUX"
      if fg_live "$name"; then log "session '$name' runs in the foreground of another terminal — switch to it there, or 'crew stop $name' then relaunch"
      elif [ "$NO_TMUX" != 1 ]; then exec tmux -u attach -t "$(tmux_name_for "$name")"; fi
      exit 0
    fi
    awk 'NR>=2{ if($0 !~ /^#/) exit; sub(/^# ?/,""); print }' "$0";;
  *)
    first="$1"; shift || true; rest="$*"
    if { [ -f "$REG" ] && awk -F'\t' -v m="$first" '$2==m{ok=1}END{exit !ok}' "$REG"; } || [[ "$first" =~ ^[A-Za-z0-9._-]{1,32}$ ]]; then
      name=$(resolve_explicit_name "$first" "$PWD"); task="$rest"
    else name=$(resolve_name_for_cwd "$PWD"); task="$first${rest:+ $rest}"; fi
    # --pick: interactive model/key/tmux menus (skips any knob already on the CLI).
    # Must run AFTER name resolution (defaults read from the session's saved state)
    # and BEFORE the --no-tmux+task reconciliation below.
    [ "$PICK" = 1 ] && interactive_pick "$name"
    # A queued task needs tmux + send-keys to deliver, so --no-tmux + task can't coexist:
    # fall back to tmux for this launch and note it.
    if [ "$NO_TMUX" = 1 ] && [ -n "$task" ]; then
      log "note: --no-tmux ignored — a queued task needs tmux (send-keys); launching detached instead"
      NO_TMUX=0; NO_TMUX_EXPLICIT=0   # a fallback, not an explicit tmux request: don't trip the cross-mode guard
    fi
    ensure_session "$name" "$BACKEND" "$FRESH" "$YOLO" "$NO_TMUX"
    # (in --no-tmux mode with no task, ensure_session exec'd claude in the foreground and
    #  never returned; the lines below only run for the tmux path)
    # A task means "queue work, don't attach". Otherwise attach when interactive (a TTY) —
    # so `crew <name>`, and any `--model`/`--key` switch, drops you straight into the session.
    if [ -n "$task" ]; then send_task "$name" "$task"
    elif fg_live "$name"; then log "session '$name' is running in the foreground of another terminal — switch to it there, or 'crew stop $name' then relaunch"
    elif [ -t 1 ]; then exec tmux -u attach -t "$(tmux_name_for "$name")"
    else log "session '$name' ready (no task); crew attach $name"; fi;;
esac
