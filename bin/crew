#!/usr/bin/env bash
# crew — 顶层 CLI,兼容旧 API 21 命令(2026-08-30 crew L 重构 Week 3)
#
# 分发到三个独立工具:
#   crew-session   状态管理
#   crew-tmux      tmux 集成
#   crew-launcher  claude 启动
#
# 21 兼容命令:
#   crew <name> [task]       起会话(默认 tmux 模式,已存在则 attach)
#   crew ls [--json]         列会话
#   crew attach <name>       attach tmux
#   crew stop <name>         停 tmux 保状态(B2 防自杀:CREW_STOP_ALLOW_SELF_KILL=1 绕过)
#   crew kill <name> [--purge]  删会话
#   crew pin/unpin <name>    pin/unpin tmux
#   crew adopt <name> <tmux> [--sid X] [--dir P] [--model M]
#   crew send <name> "msg"   给会话 inbox 灌消息
#   crew inbox <name> [--peek]  读 inbox
#   crew log <name>          看 transcript
#   crew models|backends     列 backends
#   crew doctor              自检
#   crew version [--check]   版本
#
# 全局 flags:
#   --model M --key K --tmux --no-tmux --fresh --safe --pick --dir P

set -uo pipefail

CREW_STATE="${CREW_STATE:-${XDG_DATA_HOME:-$HOME/.local/share}/claude-crew}"
CREW_HOME="${CREW_HOME:-$HOME/.config/claude-crew}"
# SCRIPT_DIR = 真实 bin/ 目录。crew 常经软链调用(~/.local/bin/crew -> <clone>/bin/crew),
# 需先解析软链链,否则 SCRIPT_DIR 会误指 ~/.local/bin(那里没有 crew-* 兄弟工具)→ exit 127。
# 用手动 while 循环而非 `readlink -f`:macOS 自带 readlink 不支持 -f(会返回空),while 版 mac+Linux 通用。
_crew_self="${BASH_SOURCE[0]:-$0}"
while [ -L "$_crew_self" ]; do
  _crew_link="$(readlink "$_crew_self")"
  case "$_crew_link" in /*) _crew_self="$_crew_link";; *) _crew_self="$(dirname "$_crew_self")/$_crew_link";; esac
done
SCRIPT_DIR="$(cd "$(dirname "$_crew_self")" && pwd)"
CS="$SCRIPT_DIR/crew-session"
CT="$SCRIPT_DIR/crew-tmux"
CL="$SCRIPT_DIR/crew-launcher"

log() { echo "[crew] $*" >&2; }
die() { log "$*"; exit 1; }

# 全局 flags 解析
BACKEND=""
KEY=""
POLICY=""
NO_TMUX=0
FRESH=0
SAFE=0
USE_CUR_TMUX=0  # 2026-08-31 audit-crew P2-b:--use-current-tmux flag
DIR=""          # 2026-08-31:默认空 = "未显式传 --dir"(区分于 "传了 = $PWD")。cmd_spawn
                # 里按 显式--dir > registry反查 > $PWD 解析真实工作目录。
# 2026-08-31:全程扫描 flags(与 v1 一致)——flag 可出现在会话名之后,如 `crew t1 --model X`。
# 非 flag(子命令/会话名/task)收进 POS,flag 在任意位置都被吃掉。避免 `crew <name> --model X`
# 里 --model 被当位置参数吞掉、静默不生效(换模型看似没反应)的坑。
POS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --model) BACKEND="$2"; shift 2 ;;
    --key) KEY="$2"; shift 2 ;;
    --policy) POLICY="$2"; shift 2 ;;
    --tmux) NO_TMUX=0; shift ;;
    --no-tmux) NO_TMUX=1; shift ;;
    --use-current-tmux) USE_CUR_TMUX=1; shift ;;
    --fresh) FRESH=1; shift ;;
    --safe) SAFE=1; shift ;;
    --dir) DIR="$2"; shift 2 ;;
    --pick) shift ;;
    --) shift; while [ $# -gt 0 ]; do POS+=("$1"); shift; done; break ;;
    *) POS+=("$1"); shift ;;
  esac
done
set -- "${POS[@]}"

if [ $# -eq 0 ]; then
  set -- ls
fi

CMD="$1"; shift

cmd_ls() {
  local live_sessions
  live_sessions=$("$CT" list 2>/dev/null || echo "")
  local kr="$SCRIPT_DIR/crew-keyresolve.js"
  printf '  %-20s %-9s %-56s %-10s %-30s\n' "NAME" "STATUS" "MODEL" "KEY" "DIR"
  "$CS" list 2>/dev/null | while IFS=$'\t' read -r name rest; do
    [ -z "$name" ] && continue
    local sid backend key tmuxname dir
    sid=$("$CS" get "$name" sid 2>/dev/null || echo "")
    backend=$("$CS" get "$name" backend 2>/dev/null || echo "?")
    tmuxname=$("$CT" resolve "$name" 2>/dev/null || echo "")
    dir=""
    key=""
    # 2026-08-30 修:tmux live 时优先从 /proc/PID/cmdline 反查真 --model + /proc/PID/cwd 反查真 dir。
    # state 里 <name>.backend 是 crew 起会话时写的期望值,但会话可能已经被 v1 时代 crew_ext_dep_up
    # 或裸 claude-yolo 用不同 model 起过 —— 真值只有运行时 claude 进程知道。crew ls 是"看",
    # 应显示真值,不是 state 记忆值。
    local claude_pid=""
    if [ -n "$tmuxname" ] && echo "$live_sessions" | grep -qFx "$tmuxname"; then
      local pane_pid
      pane_pid=$(tmux list-panes -t "$tmuxname" -F '#{pane_pid}' 2>/dev/null | head -1)
      if [ -n "$pane_pid" ]; then
        claude_pid=$(ps --no-headers -o pid,cmd --ppid "$pane_pid" 2>/dev/null | awk '/bin\/claude/{print $1; exit}')
      fi
      if [ -n "$claude_pid" ] && [ -r "/proc/$claude_pid/cmdline" ]; then
        # 抠 --model 后的一个参数(cmdline 是 \0 分隔)
        local real_model
        real_model=$(cat "/proc/$claude_pid/cmdline" 2>/dev/null | tr '\0' '\n' | awk '/^--model$/{getline; print; exit}')
        [ -n "$real_model" ] && backend="$real_model"
        # dir 从 /proc/PID/cwd 拿(比 registry 准 —— 会话可能已换 dir)
        local real_cwd
        real_cwd=$(readlink "/proc/$claude_pid/cwd" 2>/dev/null)
        [ -n "$real_cwd" ] && dir="$real_cwd"
      fi
    fi
    # KEY:优先用 crew-keyresolve.js 反查真 key(与 statusline 一致);失败回落文件
    if [ -f "$kr" ] && command -v node >/dev/null 2>&1; then
      # 2026-08-30 修:v2 ls KEY 列硬编码文件读 → 现走 keyresolve 反查真 key alias(19aa...191→joycode)
      # env -i 隔离当前 shell 的 CREW_MODEL/CREW_KEY 泄漏(否则所有会话都显本会话 model/key)
      # 传 CREW_BACKEND=真实 model,让 keyresolve 从"真 model"起解析,而不是回落 Router.default
      local kr_out
      kr_out=$(env -i HOME="$HOME" PATH="$PATH" CREW_STATE="$CREW_STATE" CREW_HOME="$CREW_HOME" SESS="$name" CREW_BACKEND="$backend" node "$kr" "$name" 2>/dev/null)
      if [ -n "$kr_out" ]; then
        # 输出 "model<TAB>key"
        local m_kr k_kr
        m_kr=$(printf '%s' "$kr_out" | cut -f1)
        k_kr=$(printf '%s' "$kr_out" | cut -f2)
        # backend 仍空/"?" 时用 keyresolve 的 model 兜底(通常 /proc 抠到就不需要)
        [ "$backend" = "?" ] && [ -n "$m_kr" ] && [ "$m_kr" != "?" ] && backend="$m_kr"
        [ -n "$k_kr" ] && [ "$k_kr" != "?" ] && key="$k_kr"
      fi
    fi
    [ -z "$key" ] && key=$("$CS" get "$name" key 2>/dev/null || echo "-")
    # DIR 兜底:/proc 抠不到 → 从 registry 反查(cwd<TAB>name)
    if [ -z "$dir" ] || [ "$dir" = "-" ]; then
      dir="-"
      if [ -f "$CREW_STATE/registry" ]; then
        local reg_dir
        reg_dir=$(awk -F'\t' -v n="$name" '$2==n{print $1; exit}' "$CREW_STATE/registry" 2>/dev/null)
        [ -n "$reg_dir" ] && dir="$reg_dir"
      fi
    fi
    local status="new"
    if echo "$live_sessions" | grep -qFx "$tmuxname"; then
      status="live"
      "$CS" has "$name" pintmux 2>/dev/null && status="live 📌"
    elif [ -n "$sid" ]; then
      status="resumable"
    fi
    printf '  %-20s %-9s %-56s %-10s %-30s\n' "$name" "$status" "$backend" "$key" "$dir"
  done
}

cmd_attach() {
  local name="$1"
  [ -z "$name" ] && die "usage: crew attach <name>"
  "$CT" attach "$name"
}

cmd_stop() {
  local name="$1"
  [ -z "$name" ] && die "usage: crew stop <name>"
  if [ -z "${CREW_STOP_ALLOW_SELF_KILL:-}" ] && "$CT" is-inside "$name" 2>/dev/null; then
    die "B2: refuse to stop '$name' — you are running inside its tmux session. Run 'crew stop $name' from OUTSIDE, or set CREW_STOP_ALLOW_SELF_KILL=1 to override."
  fi
  "$CT" kill "$name"
  log "stopped $name (state kept; resume with: crew $name)"
}

cmd_kill() {
  local name="$1"; shift
  local purge=0
  [ "${1:-}" = "--purge" ] && purge=1
  [ -z "$name" ] && die "usage: crew kill <name> [--purge]"
  if [ -z "${CREW_KILL_ALLOW_SELF:-}" ] && "$CT" is-inside "$name" 2>/dev/null; then
    die "B2: refuse to kill '$name' — you are running inside its tmux session. Run 'crew kill $name' from OUTSIDE, or set CREW_KILL_ALLOW_SELF=1 to override."
  fi
  "$CT" kill "$name"
  if [ "$purge" = 1 ]; then
    "$CS" clean "$name" --purge-transcript
  else
    "$CS" clean "$name"
  fi
  log "deleted session '$name'"
}

cmd_pin() {
  local name="$1"
  [ -z "$name" ] && die "usage: crew pin <name>"
  "$CS" set "$name" pintmux 1
  log "'$name' pinned to tmux — --no-tmux will be refused. Un-pin: crew unpin $name"
}
cmd_unpin() {
  local name="$1"
  [ -z "$name" ] && die "usage: crew unpin <name>"
  "$CS" del "$name" pintmux
  log "'$name' un-pinned — --no-tmux (foreground) is allowed again"
}

cmd_adopt() {
  local a_name="$1" a_tmux="$2"; shift 2
  local a_sid="" a_model=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --sid) a_sid="$2"; shift 2 ;;
      --dir) shift 2 ;;
      --model) a_model="$2"; shift 2 ;;
      *) shift ;;
    esac
  done
  [ -z "$a_name" ] || [ -z "$a_tmux" ] && die "usage: crew adopt <name> <tmux-session>"
  if ! "$CT" list 2>/dev/null | grep -qFx "$a_tmux"; then
    log "warn: tmux session '$a_tmux' not live right now (adopting anyway)"
  fi
  "$CS" set "$a_name" tmux "$a_tmux"
  [ -n "$a_sid" ] && "$CS" set "$a_name" sid "$a_sid"
  [ -n "$a_model" ] && "$CS" set "$a_name" backend "$a_model"
  # 2026-08-30 audit-crew A5(P0):adopt 也对称写 registry(clean 会删,起就得补)
  local reg="$CREW_STATE/registry"
  mkdir -p "$CREW_STATE"
  if ! [ -f "$reg" ] || ! awk -F'\t' -v m="$a_name" '$2==m{ok=1}END{exit !ok}' "$reg" 2>/dev/null; then
    printf '%s\t%s\n' "$DIR" "$a_name" >> "$reg"
  fi
  log "adopted '$a_name' -> tmux '$a_tmux' (sid ${a_sid:-<none>}); now in crew ls / attach. stop/kill/prune will refuse it. Un-adopt: rm $CREW_STATE/$a_name.tmux"
}

cmd_send() {
  local name="$1"; shift
  local msg="$*"
  [ -z "$name" ] && die "usage: crew send <name> \"msg\""
  mkdir -p "$CREW_STATE/inbox/$name"
  local idx
  idx=$(ls "$CREW_STATE/inbox/$name/" 2>/dev/null | wc -l)
  idx=$((idx+1))
  local ts
  ts=$(date -Iseconds)
  printf '%s\n' "$msg" > "$CREW_STATE/inbox/$name/$(printf '%04d' $idx)-$ts.msg"
  log "queued -> inbox of '$name' (from ${CREW_SESSION_NAME:-crew send})"
}

cmd_inbox() {
  local name="$1"; shift
  local peek=0
  [ "${1:-}" = "--peek" ] && peek=1
  [ -z "$name" ] && die "usage: crew inbox <name> [--peek]"
  local dir="$CREW_STATE/inbox/$name"
  [ -d "$dir" ] || { echo "(no messages)"; return 0; }
  local n=0
  for f in "$dir"/*.msg; do
    [ -f "$f" ] || continue
    n=$((n+1))
    echo "── #$n  $(basename "$f") ──"
    cat "$f"
    echo
  done
  if [ "$peek" = 0 ] && [ $n -gt 0 ]; then
    rm -f "$dir"/*.msg
    echo "(consumed $n message(s))"
  fi
}

cmd_log() {
  local name="$1"
  [ -z "$name" ] && die "usage: crew log <name>"
  local sid
  sid=$("$CS" get "$name" sid 2>/dev/null) || die "no sid for '$name'"
  for f in "$HOME"/.claude/projects/*/"$sid".jsonl; do
    [ -f "$f" ] && { echo "$f"; return 0; }
  done
  die "transcript for sid '$sid' not found"
}

cmd_models() {
  echo "== backends =="
  for f in "$CREW_HOME"/backends/*.conf; do
    [ -f "$f" ] || continue
    basename "$f" .conf | sed 's/^/  /'
  done
}

cmd_doctor() {
  local fix=0
  [ "${1:-}" = "--fix" ] && fix=1
  echo "== doctor =="
  echo "CREW_STATE: $CREW_STATE $([ -d "$CREW_STATE" ] && echo ✓ || echo ✗)"
  echo "CREW_HOME:  $CREW_HOME $([ -d "$CREW_HOME" ] && echo ✓ || echo ✗)"
  echo "CS bin:     $CS $([ -x "$CS" ] && echo ✓ || echo ✗)"
  echo "CT bin:     $CT $([ -x "$CT" ] && echo ✓ || echo ✗)"
  echo "CL bin:     $CL $([ -x "$CL" ] && echo ✓ || echo ✗)"
  echo "tmux:       $(command -v tmux || echo '(not found)')"
  echo "sessions:   $("$CS" list 2>/dev/null | wc -l)"

  # 2026-08-30 audit-crew A5(P0):registry 脏行自愈
  # 脏行 = registry 里有 <cwd,name> 但 state 目录里无任何 <name>.<field> 文件
  # (crew clean 已删 state 但 registry 行残留;或试错留下的 owkr 等孤儿名)
  local reg="$CREW_STATE/registry"
  if [ -f "$reg" ]; then
    echo "== registry =="
    local dirty_lines=""
    while IFS=$'\t' read -r cwd name; do
      [ -z "$name" ] && continue
      # state 有任何 <name>.<field> 文件就算干净
      local has_state
      has_state=$(find "$CREW_STATE" -maxdepth 1 -name "$name.*" -not -name "*.pending" -not -name "*.tmp*" 2>/dev/null | head -1)
      if [ -z "$has_state" ]; then
        dirty_lines="$dirty_lines$cwd	$name"$'\n'
        echo "  ✗ 脏行 '$name' @ '$cwd'(state 无 $name.* 文件)"
      fi
    done < "$reg"
    if [ -n "$dirty_lines" ]; then
      if [ "$fix" = "1" ]; then
        # 用 awk 过滤保留干净行
        local tmp
        tmp=$(mktemp)
        while IFS=$'\t' read -r cwd name; do
          [ -z "$name" ] && continue
          local has_state
          has_state=$(find "$CREW_STATE" -maxdepth 1 -name "$name.*" -not -name "*.pending" -not -name "*.tmp*" 2>/dev/null | head -1)
          [ -n "$has_state" ] && printf '%s\t%s\n' "$cwd" "$name" >> "$tmp"
        done < "$reg"
        mv "$tmp" "$reg"
        echo "  ✓ --fix:已删脏行"
      else
        echo "  (跑 'crew doctor --fix' 清除脏行)"
      fi
    else
      echo "  ✓ registry 干净"
    fi
  fi
}

cmd_version() {
  local commit
  commit=$(cd "$SCRIPT_DIR/.." && git rev-parse --short HEAD 2>/dev/null || echo "unknown")
  echo "crew v2.0.3 (refactor: 3 独立工具 + 顶层 CLI 兼容层;commit $commit)"
}

cmd_prune() {
  echo "[crew] prune not implemented in v2 skeleton" >&2
}

# 2026-08-31:解析会话真实工作目录。优先级(对齐 v1 path_for_name + $PWD 回落):
#   显式 --dir($DIR 非空) > registry 里 <cwd>\t<name> 按 name 反查 > state.dir > $PWD。
# 换模型/重启 live 会话时不应丢工作目录 —— 会话早在 registry(首次 spawn 时写入),从那反查
# 回它原来的目录;claude 的 --resume 也依赖在正确 cwd 起(否则按错 project 目录找历史崩)。
resolve_session_dir() {
  local name="$1" d=""
  if [ -n "$DIR" ]; then echo "$DIR"; return; fi
  local reg="$CREW_STATE/registry"
  if [ -f "$reg" ]; then
    d=$(awk -F'\t' -v n="$name" '$2==n{print $1; exit}' "$reg" 2>/dev/null)
  fi
  [ -z "$d" ] && d=$("$CS" get "$name" dir 2>/dev/null || echo "")
  [ -z "$d" ] && d="$PWD"
  echo "$d"
}

cmd_spawn() {
  local name="$1"; shift
  local task="$*"
  [ -z "$name" ] && die "no name"

  # 2026-08-30 audit-crew A5(P0):registry 写方收口 —— spawn 起会话时把 <cwd,name>
  # 落 registry(v2 之前只 clean 删行、从不写入,导致 agent-bridge crew-session-sync 侧
  # 长期看不见 v2 会话,DIR 兜底靠 /proc)。
  # 2026-08-31:解析真实工作目录(显式--dir > registry反查 > state.dir > $PWD),供 registry
  # 写入与传给 launcher 共用。显式 --dir 且与 registry 现值不同时,更新该行(原逻辑只首次写,
  # 导致换模型重启时 --dir 被忽略、会话掉回 /work)。
  local reg="$CREW_STATE/registry"
  mkdir -p "$CREW_STATE"
  local session_dir; session_dir=$(resolve_session_dir "$name")
  if ! [ -f "$reg" ] || ! awk -F'\t' -v m="$name" '$2==m{ok=1}END{exit !ok}' "$reg" 2>/dev/null; then
    printf '%s\t%s\n' "$session_dir" "$name" >> "$reg"
  elif [ -n "$DIR" ]; then
    # 显式 --dir:若 registry 里该 name 的 cwd 与之不同,重写该行
    local cur_reg_dir
    cur_reg_dir=$(awk -F'\t' -v n="$name" '$2==n{print $1; exit}' "$reg" 2>/dev/null)
    if [ "$cur_reg_dir" != "$DIR" ]; then
      awk -F'\t' -v n="$name" -v d="$DIR" 'BEGIN{OFS="\t"} $2==n{$1=d} {print}' "$reg" > "$reg.tmp" 2>/dev/null \
        && mv "$reg.tmp" "$reg"
    fi
  fi

  # 2026-08-30 修:v1 语义——crew <name> 无 task 且 tmux 已 live 时,attach 而非新起
  # (踩坑:用户跑 crew work,v2 无脑 spawn 灌新 launcher → 新起 crew-work tmux,
  # 而真 work tmux 还活着,claude 被分叉;pinned adopt 会话尤其危险)
  # 有 --fresh / 有 task / --no-tmux 时不走 attach,按用户显式意图 spawn
  if [ -z "$task" ] && [ "$FRESH" = 0 ] && [ "$NO_TMUX" = 0 ]; then
    local existing
    existing=$("$CT" resolve "$name" 2>/dev/null || true)
    if [ -n "$existing" ] && "$CT" list 2>/dev/null | grep -qFx "$existing"; then
      # 2026-08-31:补回 v1 的"live 会话就地换 model/key"语义(v2 重构时丢了)。
      # 显式传了 --model/--key 且与 state 现值不同 → 停旧的、写新值、往下 spawn(sid 在→launcher
      # 自动 --resume,历史保留)。没传(纯 crew <name>)→ 仍 attach,不动。
      local _cur_backend _cur_key _want_restart=0
      _cur_backend=$("$CS" get "$name" backend 2>/dev/null || echo "")
      _cur_key=$("$CS" get "$name" key 2>/dev/null || echo "")
      if [ -n "$BACKEND" ] && [ "$BACKEND" != "$_cur_backend" ]; then
        log "切换 '$name' 模型: ${_cur_backend:-<无>} -> $BACKEND(重启,--resume 保历史)"; _want_restart=1
      fi
      if [ -n "$KEY" ] && [ "$KEY" != "$_cur_key" ]; then
        log "切换 '$name' key: ${_cur_key:-<无>} -> $KEY(重启,--resume 保历史)"; _want_restart=1
      fi
      if [ "$_want_restart" = 1 ]; then
        "$CT" kill "$name" 2>/dev/null || true   # 停旧的;sid/state 保留,下面 spawn 会 --resume
      else
        log "'$name' 已 live (tmux=$existing) → attach(换模型/key 加 --model/--key;要新起加 --fresh 或 crew kill 后再来)"
        exec "$CT" attach "$name"
      fi
    fi
  fi

  [ -n "$BACKEND" ] && "$CS" set "$name" backend "$BACKEND"
  [ -n "$KEY" ] && "$CS" set "$name" key "$KEY"
  # --policy X:设 per-session policy 文件(v2 修② 2026-08-30)
  if [ -n "$POLICY" ]; then
    if [ "$POLICY" = "-" ]; then
      "$CS" del "$name" policy
      log "AGENT_POLICY session pin cleared for '$name'"
    else
      "$CS" set "$name" policy "$POLICY"
      log "AGENT_POLICY pinned for '$name' -> $POLICY"
    fi
  fi

  # 2026-08-31 audit-crew P2-b:mode 决策(五概念解耦)
  #   --use-current-tmux 最高优先(用户显式意图 = 已在 tmux pane 里,别再 new-session)
  #   --no-tmux 次之:pinned 时忽略(pinned 语义 = "always on tmux"),否则 fg
  #   默认 tmux(new-session)
  local mode="tmux"
  if [ "$USE_CUR_TMUX" = 1 ]; then
    mode="use-current-tmux"
    log "'$name' 使用当前 tmux pane 起 claude(不 new-session,pinned 状态不动)"
  elif [ "$NO_TMUX" = 1 ]; then
    if "$CS" has "$name" pintmux 2>/dev/null; then
      log "'$name' is pinned to tmux (always-on); ignoring --no-tmux."
    else
      mode="fg"
    fi
  fi

  local -a extra_args=()
  [ "$FRESH" = 1 ] && extra_args+=(--fresh)
  [ -n "$task" ] && extra_args+=(--task "$task")

  "$CL" spawn --name "$name" --mode "$mode" --dir "$session_dir" "${extra_args[@]}"
}

case "$CMD" in
  ls|list)      cmd_ls "$@" ;;
  attach)       cmd_attach "$@" ;;
  stop)         cmd_stop "$@" ;;
  kill)         cmd_kill "$@" ;;
  pin)          cmd_pin "$@" ;;
  unpin)        cmd_unpin "$@" ;;
  adopt)        cmd_adopt "$@" ;;
  send)         cmd_send "$@" ;;
  inbox)        cmd_inbox "$@" ;;
  log)          cmd_log "$@" ;;
  models|backends) cmd_models ;;
  doctor)       cmd_doctor "$@" ;;
  version)      cmd_version "$@" ;;
  prune)        cmd_prune "$@" ;;
  help|--help|-h) sed -n '3,22p' "$0" ;;
  *)            cmd_spawn "$CMD" "$@" ;;
esac
