#!/usr/bin/env bash
# crew — 顶层 CLI,兼容旧 API 21 命令(2026-08-30 crew L 重构 Week 3)
#
# 分发到三个独立工具:
#   crew-session   状态管理
#   crew-tmux      tmux 集成
#   crew-launcher  claude 启动
#
# 21 兼容命令:
#   crew <name> [task]       起会话(默认 tmux 模式,已存在则 attach)
#   crew ls [--json]         列会话
#   crew attach <name>       attach tmux
#   crew stop <name>         停 tmux 保状态(B2 防自杀:CREW_STOP_ALLOW_SELF_KILL=1 绕过)
#   crew kill <name> [--purge]  删会话
#   crew pin/unpin <name>    pin/unpin tmux
#   crew adopt <name> <tmux> [--sid X] [--dir P] [--model M]
#   crew send <name> "msg"   给会话 inbox 灌消息
#   crew inbox <name> [--peek]  读 inbox
#   crew log <name>          看 transcript
#   crew models|backends     列 backends
#   crew keys                列 key 别名(值脱敏)
#   crew addkey <key> [别名] 加一把 key 到 keys.conf(别名不给则自动派生)
#   crew switch <会话>       交互切 key→model(都默认当前值,选完重启换)
#   crew find <描述...>      搜已有会话历史,返回 Top5(会话名+概要+打开命令)
#   crew prune [--dry-run]   清陈旧会话(>7d 删状态、>30d 连历史删;live/pinned 不删,平时自动跑)
#   crew doctor              自检
#   crew version [--check]   版本
#
# 全局 flags:
#   --model M --key K --tmux --no-tmux --fresh --safe --pick --dir P
#   --pick  交互选 model+key(菜单);crew <会话> 不带 --model 新起时也会自动弹菜单选

set -uo pipefail

CREW_STATE="${CREW_STATE:-${XDG_DATA_HOME:-$HOME/.local/share}/claude-crew}"
CREW_HOME="${CREW_HOME:-$HOME/.config/claude-crew}"
# SCRIPT_DIR = 真实 bin/ 目录。crew 常经软链调用(~/.local/bin/crew -> <clone>/bin/crew),
# 需先解析软链链,否则 SCRIPT_DIR 会误指 ~/.local/bin(那里没有 crew-* 兄弟工具)→ exit 127。
# 用手动 while 循环而非 `readlink -f`:macOS 自带 readlink 不支持 -f(会返回空),while 版 mac+Linux 通用。
_crew_self="${BASH_SOURCE[0]:-$0}"
while [ -L "$_crew_self" ]; do
  _crew_link="$(readlink "$_crew_self")"
  case "$_crew_link" in /*) _crew_self="$_crew_link";; *) _crew_self="$(dirname "$_crew_self")/$_crew_link";; esac
done
SCRIPT_DIR="$(cd "$(dirname "$_crew_self")" && pwd)"
CS="$SCRIPT_DIR/crew-session"
CT="$SCRIPT_DIR/crew-tmux"
CL="$SCRIPT_DIR/crew-launcher"

log() { echo "[crew] $*" >&2; }
die() { log "$*"; exit 1; }

# 全局 flags 解析
BACKEND=""
KEY=""
POLICY=""
NO_TMUX=0
FRESH=0
SAFE=0
USE_CUR_TMUX=0  # 2026-08-31 audit-crew P2-b:--use-current-tmux flag
PICK=0          # 2026-08-31:--pick 强制弹交互菜单(即使已传 --model/--key)
DIR=""          # 2026-08-31:默认空 = "未显式传 --dir"(区分于 "传了 = $PWD")。cmd_spawn
                # 里按 显式--dir > registry反查 > $PWD 解析真实工作目录。
# 2026-08-31:全程扫描 flags(与 v1 一致)——flag 可出现在会话名之后,如 `crew t1 --model X`。
# 非 flag(子命令/会话名/task)收进 POS,flag 在任意位置都被吃掉。避免 `crew <name> --model X`
# 里 --model 被当位置参数吞掉、静默不生效(换模型看似没反应)的坑。
POS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --model) BACKEND="$2"; shift 2 ;;
    --key) KEY="$2"; shift 2 ;;
    --policy) POLICY="$2"; shift 2 ;;
    --tmux) NO_TMUX=0; shift ;;
    --no-tmux) NO_TMUX=1; shift ;;
    --use-current-tmux) USE_CUR_TMUX=1; shift ;;
    --fresh) FRESH=1; shift ;;
    --safe) SAFE=1; shift ;;
    --dir) DIR="$2"; shift 2 ;;
    --pick) PICK=1; shift ;;
    --) shift; while [ $# -gt 0 ]; do POS+=("$1"); shift; done; break ;;
    *) POS+=("$1"); shift ;;
  esac
done
set -- "${POS[@]}"

if [ $# -eq 0 ]; then
  set -- ls
fi

CMD="$1"; shift

cmd_ls() {
  local live_sessions
  live_sessions=$("$CT" list 2>/dev/null || echo "")
  local kr="$SCRIPT_DIR/crew-keyresolve.js"
  printf '  %-20s %-9s %-56s %-10s %-30s\n' "NAME" "STATUS" "MODEL" "KEY" "DIR"

  # 2026-08-31 perf:两遍式 —— 第一遍纯 bash/proc 收集每会话 name/sid/backend(真模型)/dir/tmuxname
  # 到数组;然后【一次】node --batch 解析所有会话的 model/key(原来每会话 spawn 一次 node ≈占 ls
  # 耗时一半);第二遍打印。用 `< <(...)` 让循环在主 shell 跑(避免 `list | while` 的 subshell 吞数组)。
  local -a NAMES=() SIDS=() BACKENDS=() DIRS=() TMUXNS=()
  local name rest
  while IFS=$'\t' read -r name rest; do
    [ -z "$name" ] && continue
    local sid backend tmuxname dir claude_pid=""
    sid=$("$CS" get "$name" sid 2>/dev/null || echo "")
    backend=$("$CS" get "$name" backend 2>/dev/null || echo "?")
    # 内联 resolve(见前注):adopted(.tmux)> .tmuxname > live_sessions 查 name/crew-name
    tmuxname=""
    if [ -f "$CREW_STATE/$name.tmux" ]; then tmuxname=$(cat "$CREW_STATE/$name.tmux" 2>/dev/null)
    elif [ -f "$CREW_STATE/$name.tmuxname" ]; then tmuxname=$(cat "$CREW_STATE/$name.tmuxname" 2>/dev/null)
    elif echo "$live_sessions" | grep -qFx "$name"; then tmuxname="$name"
    elif echo "$live_sessions" | grep -qFx "crew-$name"; then tmuxname="crew-$name"
    fi
    dir=""
    # tmux live 时从 /proc 抠真 --model + 真 cwd(见前注)
    if [ -n "$tmuxname" ] && echo "$live_sessions" | grep -qFx "$tmuxname"; then
      local pane_pid
      pane_pid=$(tmux list-panes -t "$tmuxname" -F '#{pane_pid}' 2>/dev/null | head -1)
      if [ -n "$pane_pid" ]; then
        claude_pid=$(ps --no-headers -o pid,cmd --ppid "$pane_pid" 2>/dev/null | awk '/bin\/claude/{print $1; exit}')
      fi
      if [ -n "$claude_pid" ] && [ -r "/proc/$claude_pid/cmdline" ]; then
        local real_model real_cwd
        real_model=$(cat "/proc/$claude_pid/cmdline" 2>/dev/null | tr '\0' '\n' | awk '/^--model$/{getline; print; exit}')
        [ -n "$real_model" ] && backend="$real_model"
        real_cwd=$(readlink "/proc/$claude_pid/cwd" 2>/dev/null)
        [ -n "$real_cwd" ] && dir="$real_cwd"
      fi
    fi
    # DIR 兜底:/proc 抠不到 → registry 反查
    if [ -z "$dir" ] || [ "$dir" = "-" ]; then
      dir="-"
      if [ -f "$CREW_STATE/registry" ]; then
        local reg_dir
        reg_dir=$(awk -F'\t' -v n="$name" '$2==n{print $1; exit}' "$CREW_STATE/registry" 2>/dev/null)
        [ -n "$reg_dir" ] && dir="$reg_dir"
      fi
    fi
    NAMES+=("$name"); SIDS+=("$sid"); BACKENDS+=("$backend"); DIRS+=("$dir"); TMUXNS+=("$tmuxname")
  done < <("$CS" list 2>/dev/null)

  # 一次批量 keyresolve:喂 name<TAB>backend,拿回 name<TAB>model<TAB>key。存进两个"并行数组"式查表。
  local -A KR_MODEL=() KR_KEY=()
  if [ -f "$kr" ] && command -v node >/dev/null 2>&1 && [ "${#NAMES[@]}" -gt 0 ]; then
    local batch_in="" i
    for i in "${!NAMES[@]}"; do batch_in+="${NAMES[$i]}"$'\t'"${BACKENDS[$i]}"$'\n'; done
    local batch_out
    batch_out=$(printf '%s' "$batch_in" | env -i HOME="$HOME" PATH="$PATH" CREW_STATE="$CREW_STATE" CREW_HOME="$CREW_HOME" node "$kr" --batch 2>/dev/null)
    local bn bm bk
    while IFS=$'\t' read -r bn bm bk; do
      [ -z "$bn" ] && continue
      KR_MODEL["$bn"]="$bm"; KR_KEY["$bn"]="$bk"
    done <<< "$batch_out"
  fi

  # 第二遍:打印(查批量表;缺则回落 state)
  local i
  for i in "${!NAMES[@]}"; do
    name="${NAMES[$i]}"
    local sid="${SIDS[$i]}" backend="${BACKENDS[$i]}" dir="${DIRS[$i]}" tmuxname="${TMUXNS[$i]}" key=""
    local m_kr="${KR_MODEL[$name]:-}" k_kr="${KR_KEY[$name]:-}"
    [ "$backend" = "?" ] && [ -n "$m_kr" ] && [ "$m_kr" != "?" ] && backend="$m_kr"
    [ -n "$k_kr" ] && [ "$k_kr" != "?" ] && key="$k_kr"
    [ -z "$key" ] && key=$("$CS" get "$name" key 2>/dev/null || echo "-")
    local status="new"
    if echo "$live_sessions" | grep -qFx "$tmuxname"; then
      status="live"
      "$CS" has "$name" pintmux 2>/dev/null && status="live 📌"
    elif [ -n "$sid" ]; then
      status="resumable"
    fi
    printf '  %-20s %-9s %-56s %-10s %-30s\n' "$name" "$status" "$backend" "$key" "$dir"
  done
}

cmd_attach() {
  local name="$1"
  [ -z "$name" ] && die "usage: crew attach <name>"
  "$CT" attach "$name"
}

cmd_stop() {
  local name="$1"
  [ -z "$name" ] && die "usage: crew stop <name>"
  if [ -z "${CREW_STOP_ALLOW_SELF_KILL:-}" ] && "$CT" is-inside "$name" 2>/dev/null; then
    die "B2: refuse to stop '$name' — you are running inside its tmux session. Run 'crew stop $name' from OUTSIDE, or set CREW_STOP_ALLOW_SELF_KILL=1 to override."
  fi
  "$CT" kill "$name"
  log "stopped $name (state kept; resume with: crew $name)"
}

cmd_kill() {
  local name="$1"; shift
  local purge=0
  [ "${1:-}" = "--purge" ] && purge=1
  [ -z "$name" ] && die "usage: crew kill <name> [--purge]"
  if [ -z "${CREW_KILL_ALLOW_SELF:-}" ] && "$CT" is-inside "$name" 2>/dev/null; then
    die "B2: refuse to kill '$name' — you are running inside its tmux session. Run 'crew kill $name' from OUTSIDE, or set CREW_KILL_ALLOW_SELF=1 to override."
  fi
  "$CT" kill "$name"
  if [ "$purge" = 1 ]; then
    "$CS" clean "$name" --purge-transcript
  else
    "$CS" clean "$name"
  fi
  log "deleted session '$name'"
}

cmd_pin() {
  local name="$1"
  [ -z "$name" ] && die "usage: crew pin <name>"
  "$CS" set "$name" pintmux 1
  log "'$name' pinned to tmux — --no-tmux will be refused. Un-pin: crew unpin $name"
}
cmd_unpin() {
  local name="$1"
  [ -z "$name" ] && die "usage: crew unpin <name>"
  "$CS" del "$name" pintmux
  log "'$name' un-pinned — --no-tmux (foreground) is allowed again"
}

cmd_adopt() {
  local a_name="$1" a_tmux="$2"; shift 2
  local a_sid="" a_model=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --sid) a_sid="$2"; shift 2 ;;
      --dir) shift 2 ;;
      --model) a_model="$2"; shift 2 ;;
      *) shift ;;
    esac
  done
  [ -z "$a_name" ] || [ -z "$a_tmux" ] && die "usage: crew adopt <name> <tmux-session>"
  if ! "$CT" list 2>/dev/null | grep -qFx "$a_tmux"; then
    log "warn: tmux session '$a_tmux' not live right now (adopting anyway)"
  fi
  "$CS" set "$a_name" tmux "$a_tmux"
  [ -n "$a_sid" ] && "$CS" set "$a_name" sid "$a_sid"
  [ -n "$a_model" ] && "$CS" set "$a_name" backend "$a_model"
  # 2026-08-30 audit-crew A5(P0):adopt 也对称写 registry(clean 会删,起就得补)
  local reg="$CREW_STATE/registry"
  mkdir -p "$CREW_STATE"
  if ! [ -f "$reg" ] || ! awk -F'\t' -v m="$a_name" '$2==m{ok=1}END{exit !ok}' "$reg" 2>/dev/null; then
    printf '%s\t%s\n' "$DIR" "$a_name" >> "$reg"
  fi
  log "adopted '$a_name' -> tmux '$a_tmux' (sid ${a_sid:-<none>}); now in crew ls / attach. stop/kill/prune will refuse it. Un-adopt: rm $CREW_STATE/$a_name.tmux"
}

cmd_send() {
  local name="$1"; shift
  local msg="$*"
  [ -z "$name" ] && die "usage: crew send <name> \"msg\""
  mkdir -p "$CREW_STATE/inbox/$name"
  local idx
  idx=$(ls "$CREW_STATE/inbox/$name/" 2>/dev/null | wc -l)
  idx=$((idx+1))
  local ts
  ts=$(date -Iseconds)
  printf '%s\n' "$msg" > "$CREW_STATE/inbox/$name/$(printf '%04d' $idx)-$ts.msg"
  log "queued -> inbox of '$name' (from ${CREW_SESSION_NAME:-crew send})"
}

cmd_inbox() {
  local name="$1"; shift
  local peek=0
  [ "${1:-}" = "--peek" ] && peek=1
  [ -z "$name" ] && die "usage: crew inbox <name> [--peek]"
  local dir="$CREW_STATE/inbox/$name"
  [ -d "$dir" ] || { echo "(no messages)"; return 0; }
  local n=0
  for f in "$dir"/*.msg; do
    [ -f "$f" ] || continue
    n=$((n+1))
    echo "── #$n  $(basename "$f") ──"
    cat "$f"
    echo
  done
  if [ "$peek" = 0 ] && [ $n -gt 0 ]; then
    rm -f "$dir"/*.msg
    echo "(consumed $n message(s))"
  fi
}

cmd_log() {
  local name="$1"
  [ -z "$name" ] && die "usage: crew log <name>"
  local sid
  sid=$("$CS" get "$name" sid 2>/dev/null) || die "no sid for '$name'"
  for f in "$HOME"/.claude/projects/*/"$sid".jsonl; do
    [ -f "$f" ] && { echo "$f"; return 0; }
  done
  die "transcript for sid '$sid' not found"
}

cmd_models() {
  echo "== backends =="
  for f in "$CREW_HOME"/backends/*.conf; do
    [ -f "$f" ] || continue
    basename "$f" .conf | sed 's/^/  /'
  done
}

# crew keys —— 列 key 别名(值脱敏)
cmd_keys() {
  local kf="$CREW_HOME/keys.conf"
  echo "== keys =="
  [ -f "$kf" ] || { echo "  (无 keys.conf)"; return 0; }
  awk -F= '
    /^[[:space:]]*#/ {next} /=/ {
      a=$1; gsub(/^[[:space:]]+|[[:space:]]+$/,"",a); if(a=="") next;
      v=substr($0, index($0,"=")+1); gsub(/^[[:space:]]+|[[:space:]]+$/,"",v);
      m = (length(v)>10) ? substr(v,1,4) "…" substr(v,length(v)-2) : "****";
      printf "  %-14s %s\n", a, m;
    }' "$kf"
}

# crew addkey <key> [别名] —— 简化加 key:写进 keys.conf。别名不给则从 key 派生。
# 只做"写别名=key",不拉 /v1/models、不建 backend(那是 v1 add-key 的重活;此处按用户要的极简)。
cmd_addkey() {
  local key="$1" alias="${2:-}"
  [ -z "$key" ] && die "usage: crew addkey <key> [别名]"
  # 别名默认:key- + key 的 sha256 前 6(稳定、不含明文)
  if [ -z "$alias" ]; then
    local h
    h=$(printf '%s' "$key" | { command -v sha256sum >/dev/null 2>&1 && sha256sum || shasum -a 256; } | cut -c1-6)
    alias="key-$h"
  fi
  # 别名校验(与 crew-session 名规则一致:字母数字._-)
  case "$alias" in *[!A-Za-z0-9._-]*) die "别名 '$alias' 含非法字符(仅允许 A-Za-z0-9._-)";; esac
  local kf="$CREW_HOME/keys.conf"
  mkdir -p "$CREW_HOME"
  [ -f "$kf" ] || : > "$kf"
  # 已存在同别名?覆盖其行(保留其余),否则追加。
  if grep -qE "^[[:space:]]*$alias[[:space:]]*=" "$kf" 2>/dev/null; then
    awk -v a="$alias" -v k="$key" '
      { line=$0; t=$0; sub(/^[[:space:]]+/,"",t);
        if (index(t, a "=")==1 || index(t, a " =")==1) { print a "=" k } else { print line } }
    ' "$kf" > "$kf.tmp" && mv "$kf.tmp" "$kf"
    log "更新 key 别名 '$alias'(覆盖旧值)"
  else
    printf '%s=%s\n' "$alias" "$key" >> "$kf"
    log "加了 key 别名 '$alias'"
  fi
  chmod 600 "$kf" 2>/dev/null || true
  echo "现有 key 别名:"; cmd_keys | grep -v '== keys =='
}

cmd_doctor() {
  local fix=0
  [ "${1:-}" = "--fix" ] && fix=1
  echo "== doctor =="
  echo "CREW_STATE: $CREW_STATE $([ -d "$CREW_STATE" ] && echo ✓ || echo ✗)"
  echo "CREW_HOME:  $CREW_HOME $([ -d "$CREW_HOME" ] && echo ✓ || echo ✗)"
  echo "CS bin:     $CS $([ -x "$CS" ] && echo ✓ || echo ✗)"
  echo "CT bin:     $CT $([ -x "$CT" ] && echo ✓ || echo ✗)"
  echo "CL bin:     $CL $([ -x "$CL" ] && echo ✓ || echo ✗)"
  echo "tmux:       $(command -v tmux || echo '(not found)')"
  echo "sessions:   $("$CS" list 2>/dev/null | wc -l)"

  # 2026-08-30 audit-crew A5(P0):registry 脏行自愈
  # 脏行 = registry 里有 <cwd,name> 但 state 目录里无任何 <name>.<field> 文件
  # (crew clean 已删 state 但 registry 行残留;或试错留下的 owkr 等孤儿名)
  local reg="$CREW_STATE/registry"
  if [ -f "$reg" ]; then
    echo "== registry =="
    local dirty_lines=""
    while IFS=$'\t' read -r cwd name; do
      [ -z "$name" ] && continue
      # state 有任何 <name>.<field> 文件就算干净
      local has_state
      has_state=$(find "$CREW_STATE" -maxdepth 1 -name "$name.*" -not -name "*.pending" -not -name "*.tmp*" 2>/dev/null | head -1)
      if [ -z "$has_state" ]; then
        dirty_lines="$dirty_lines$cwd	$name"$'\n'
        echo "  ✗ 脏行 '$name' @ '$cwd'(state 无 $name.* 文件)"
      fi
    done < "$reg"
    if [ -n "$dirty_lines" ]; then
      if [ "$fix" = "1" ]; then
        # 用 awk 过滤保留干净行
        local tmp
        tmp=$(mktemp)
        while IFS=$'\t' read -r cwd name; do
          [ -z "$name" ] && continue
          local has_state
          has_state=$(find "$CREW_STATE" -maxdepth 1 -name "$name.*" -not -name "*.pending" -not -name "*.tmp*" 2>/dev/null | head -1)
          [ -n "$has_state" ] && printf '%s\t%s\n' "$cwd" "$name" >> "$tmp"
        done < "$reg"
        mv "$tmp" "$reg"
        echo "  ✓ --fix:已删脏行"
      else
        echo "  (跑 'crew doctor --fix' 清除脏行)"
      fi
    else
      echo "  ✓ registry 干净"
    fi
  fi
}

cmd_version() {
  local commit
  commit=$(cd "$SCRIPT_DIR/.." && git rev-parse --short HEAD 2>/dev/null || echo "unknown")
  echo "crew v2.0.8 (refactor: 3 独立工具 + 顶层 CLI 兼容层;commit $commit)"
}

# 会话最近活跃时间(epoch):transcript .jsonl mtime + state 文件 mtime 取 max。0=无从判定。
# _mtime 跨平台:Linux `stat -c %Y`,macOS/BSD `stat -f %m`。注意 Linux 上 `stat -f` 是"文件系统
# 信息"(不报错但输出多行文本!),故必须先试 -c、再试 -f,且校验结果是纯数字(不是就当 0)。
_mtime() {
  local m
  m=$(stat -c %Y "$1" 2>/dev/null) || m=""
  case "$m" in ''|*[!0-9]*) m=$(stat -f %m "$1" 2>/dev/null) || m="";; esac
  case "$m" in ''|*[!0-9]*) m=0;; esac
  echo "$m"
}
session_activity() {
  local nm="$1" last=0 s m f
  s=$("$CS" get "$nm" sid 2>/dev/null || echo "")
  if [ -n "$s" ]; then
    for f in "$HOME"/.claude/projects/*/"$s".jsonl; do
      [ -f "$f" ] || continue; m=$(_mtime "$f"); [ "$m" -gt "$last" ] 2>/dev/null && last=$m
    done
  fi
  for f in "$CREW_STATE/$nm.sid" "$CREW_STATE/$nm.backend" "$CREW_STATE/$nm.key"; do
    [ -f "$f" ] || continue; m=$(_mtime "$f"); [ "$m" -gt "$last" ] 2>/dev/null && last=$m
  done
  echo "$last"
}

# 自动清理陈旧会话(分级):transcript/state 最后活跃 > STATE_DAYS(默认7)天 → 删 crew 状态(留
# transcript,可 find/resume 找回);> PURGE_DAYS(默认30)天 → 连 transcript 一起删(彻底)。
# 铁律:live(tmux 在跑)/ pinned 会话【绝不删】。不碰 send/inbox/--model 等接口。
# crew <name> [--days N] [--purge-days M] [--dry-run]
cmd_prune() {
  local p_days="${CREW_PRUNE_DAYS:-7}" p_purge_days="${CREW_PURGE_DAYS:-30}" p_dry=0
  while [ $# -gt 0 ]; do case "$1" in
    --days) p_days="$2"; shift 2;;
    --days=*) p_days="${1#*=}"; shift;;
    --purge-days) p_purge_days="$2"; shift 2;;
    --purge-days=*) p_purge_days="${1#*=}"; shift;;
    --dry-run|-n) p_dry=1; shift;;
    *) shift;;
  esac; done
  local now; now=$(date +%s 2>/dev/null || echo 0); [ "$now" = 0 ] && return 0
  local cut_state=$(( now - p_days*86400 )) cut_purge=$(( now - p_purge_days*86400 ))
  local live_sessions; live_sessions=$("$CT" list 2>/dev/null || echo "")
  local reaped=0 purged=0 kept=0 nm
  while IFS= read -r nm; do
    [ -n "$nm" ] || continue
    # live?(tmux 在跑)→ keep
    local tn=""
    if [ -f "$CREW_STATE/$nm.tmux" ]; then tn=$(cat "$CREW_STATE/$nm.tmux" 2>/dev/null)
    elif [ -f "$CREW_STATE/$nm.tmuxname" ]; then tn=$(cat "$CREW_STATE/$nm.tmuxname" 2>/dev/null)
    elif echo "$live_sessions" | grep -qFx "$nm"; then tn="$nm"
    elif echo "$live_sessions" | grep -qFx "crew-$nm"; then tn="crew-$nm"
    fi
    if [ -n "$tn" ] && echo "$live_sessions" | grep -qFx "$tn"; then kept=$((kept+1)); continue; fi
    # pinned?→ keep(常驻会话如 work)
    if "$CS" has "$nm" pintmux 2>/dev/null; then kept=$((kept+1)); continue; fi
    local last; last=$(session_activity "$nm")
    case "$last" in ''|*[!0-9]*) last=0;; esac
    [ "$last" = 0 ] && { kept=$((kept+1)); continue; }   # 判不出活跃时间 → 保守 keep
    local age_d=$(( (now-last)/86400 ))
    if [ "$last" -lt "$cut_purge" ]; then
      # > 30 天:连 transcript 删
      if [ "$p_dry" = 1 ]; then echo "  would PURGE '$nm' (idle ${age_d}d, +transcript)"; purged=$((purged+1)); continue; fi
      "$CT" kill "$nm" 2>/dev/null || true
      "$CS" clean "$nm" --purge-transcript >/dev/null 2>&1 || true
      echo "  purged '$nm' (idle ${age_d}d, transcript deleted)"; purged=$((purged+1))
    elif [ "$last" -lt "$cut_state" ]; then
      # 7~30 天:只删状态,留 transcript
      if [ "$p_dry" = 1 ]; then echo "  would release '$nm' (idle ${age_d}d, keep transcript)"; reaped=$((reaped+1)); continue; fi
      "$CT" kill "$nm" 2>/dev/null || true
      "$CS" clean "$nm" >/dev/null 2>&1 || true
      echo "  released '$nm' (idle ${age_d}d, transcript kept)"; reaped=$((reaped+1))
    else
      kept=$((kept+1))
    fi
  done < <("$CS" list 2>/dev/null | cut -f1 | sort -u)
  echo "== prune: 删状态 $reaped, 连历史删 $purged, 保留 $kept (状态>${p_days}d, 历史>${p_purge_days}d$( [ "$p_dry" = 1 ] && printf ', dry-run'))"
}

# 机会式节流自动清理:每 CREW_PRUNE_EVERY 秒(默认1天)最多一次,后台静默跑 prune。搭 spawn/ls 触发,
# 无需 cron。CREW_PRUNE_AUTO=0 关闭。绝不 delay 前台操作(后台 &)。
crew_autoprune() {
  [ "${CREW_PRUNE_AUTO:-1}" = 1 ] || return 0
  local every="${CREW_PRUNE_EVERY:-86400}" stamp="$CREW_STATE/.last-prune" last now
  last=$(cat "$stamp" 2>/dev/null || echo 0); case "$last" in ''|*[!0-9]*) last=0;; esac
  now=$(date +%s 2>/dev/null || echo 0); [ "$now" = 0 ] && return 0
  [ $((now - last)) -ge "$every" ] || return 0
  printf '%s' "$now" > "$stamp" 2>/dev/null || true
  ( "$SCRIPT_DIR/crew" prune >/dev/null 2>&1 & ) 2>/dev/null || true
}

# crew switch <会话> —— 交互切 key→model(都默认当前值),选完走 live 换模型路径重启。
# 顺序:先选 key(默认会话现 key),再选 model(默认会话现 model)。等价 `crew <会话> --key K --model M`,
# 但交互、免背参数。非交互(无 tty)报错提示用带参形式。
cmd_switch() {
  local name="$1"
  [ -z "$name" ] && die "usage: crew switch <会话>"
  [ -t 0 ] || die "crew switch 需交互终端;非交互请用: crew $name --key <K> --model <M>"
  local cur_key cur_be picked_key picked_be
  cur_key=$("$CS" get "$name" key 2>/dev/null || echo "")
  cur_be=$("$CS" get "$name" backend 2>/dev/null || echo "")
  picked_key=$(_list_keys | _pick_one "选 key ($name,当前: ${cur_key:-无})" "$cur_key")
  picked_be=$(_list_backends | _pick_one "选模型 backend ($name,当前: ${cur_be:-无})" "$cur_be")
  # 设全局 BACKEND/KEY,走 cmd_spawn 的 live 换模型逻辑(它会判与现值不同才重启)
  [ -n "$picked_key" ] && KEY="$picked_key"
  [ -n "$picked_be" ] && BACKEND="$picked_be"
  if [ "$BACKEND" = "$cur_be" ] && [ "$KEY" = "$cur_key" ]; then
    log "'$name' key/model 未变(key=$KEY model=$BACKEND),不重启"
    return 0
  fi
  log "switch '$name' → key=$KEY model=$BACKEND"
  cmd_spawn "$name"
}

# crew find <描述...> —— 快搜已有 crew 会话历史,返回 Top5 候选(会话名+概要+打开命令)。
# 重点是快:每会话只 tail transcript 最近片段(不读大 .jsonl 全文)grep 粗筛;按命中数+最近活跃
# 排序;概要取首个命中行的 user 文本(疑似密钥脱敏)。纯 grep 路径,零模型依赖。
# CREW_FIND_TAIL(默认 200000 字节)控制每会话读多少最近内容。
cmd_find() {
  [ $# -eq 0 ] && die "usage: crew find <描述...>"
  local q="$*" tailb="${CREW_FIND_TAIL:-200000}"
  local live_sessions; live_sessions=$("$CT" list 2>/dev/null || echo "")
  # 收集 name→sid→transcript,grep 粗筛计分。结果行:"命中数<TAB>mtime<TAB>name<TAB>transcript"
  local scored="" name sid j hits mt words w
  # 拆词(空格分),任一命中计一分
  while IFS= read -r name; do
    [ -n "$name" ] || continue
    sid=$("$CS" get "$name" sid 2>/dev/null || echo "")
    [ -z "$sid" ] && continue
    j=""
    for f in "$HOME"/.claude/projects/*/"$sid".jsonl; do [ -f "$f" ] && { j="$f"; break; }; done
    [ -z "$j" ] && continue
    # 只读最近 tailb 字节(快)。多词累计命中(每词 grep -ic 计数)。
    local recent; recent=$(tail -c "$tailb" "$j" 2>/dev/null)
    hits=0
    for w in $q; do
      local c; c=$(printf '%s' "$recent" | grep -ic -- "$w" 2>/dev/null)
      case "$c" in ''|*[!0-9]*) c=0;; esac
      hits=$((hits + c))
    done
    [ "$hits" -eq 0 ] && continue
    mt=$(_mtime "$j")
    scored+="$hits"$'\t'"$mt"$'\t'"$name"$'\t'"$j"$'\n'
  done < <("$CS" list 2>/dev/null | cut -f1 | sort -u)

  if [ -z "$scored" ]; then
    echo "没找到匹配 '$q' 的会话。换个关键词?(find 只搜每个会话最近的对话片段)"
    return 0
  fi

  # 排序:命中数降序,再 mtime 降序;取 Top5
  local top; top=$(printf '%s' "$scored" | sort -t$'\t' -k1,1nr -k2,2nr | head -5)

  # 输出候选块
  local rank=0 c_dim=$'\033[2m' c_reset=$'\033[0m' c_name=$'\033[36m' c_cmd=$'\033[2m'
  while IFS=$'\t' read -r hits mt name j; do
    [ -n "$name" ] || continue
    rank=$((rank+1))
    # 状态/model/cwd
    local st="resumable" tn=""
    if [ -f "$CREW_STATE/$name.tmux" ]; then tn=$(cat "$CREW_STATE/$name.tmux" 2>/dev/null)
    elif [ -f "$CREW_STATE/$name.tmuxname" ]; then tn=$(cat "$CREW_STATE/$name.tmuxname" 2>/dev/null)
    elif echo "$live_sessions" | grep -qFx "$name"; then tn="$name"
    elif echo "$live_sessions" | grep -qFx "crew-$name"; then tn="crew-$name"; fi
    echo "$live_sessions" | grep -qFx "$tn" && st="live"
    local be; be=$("$CS" get "$name" backend 2>/dev/null || echo "?")
    local cwd; cwd=$(awk -F'\t' -v n="$name" '$2==n{print $1; exit}' "$CREW_STATE/registry" 2>/dev/null)
    local cwdb; cwdb=$(basename "${cwd:-?}")
    # 概要:node 直接读 transcript 末尾片段(不用 stdin 管道 —— 在 `while <<<` 循环里 node 会
    # 继承循环的 here-string stdin,读不到管道数据,故传文件路径让 node 自己 fs 读末尾 tailb 字节)。
    # 抠首个含【任一】查询词的文本(与计分一致,不只首词);疑似密钥脱敏;失败回落。
    local gist
    gist=$(node -e '
      var fs=require("fs"), file=process.argv[1], tailb=+process.argv[2]||200000;
      var words=process.argv.slice(3).map(function(w){return w.toLowerCase()});
      var buf="";
      try{ var fd=fs.openSync(file,"r"), sz=fs.fstatSync(fd).size, start=Math.max(0,sz-tailb), len=sz-start;
           var b=Buffer.alloc(len); fs.readSync(fd,b,0,len,start); fs.closeSync(fd); buf=b.toString("utf8"); }catch(e){}
      var lines=buf.split("\n"), found="";
      for(var i=0;i<lines.length && !found;i++){
        try{var m=JSON.parse(lines[i]); var c=m.message&&m.message.content;
          var t = typeof c==="string" ? c : (Array.isArray(c)? c.map(function(bl){return bl&&bl.text||""}).join(" ") : "");
          if(!t) continue; var lt=t.toLowerCase();
          for(var k=0;k<words.length;k++){ if(words[k] && lt.indexOf(words[k])>=0){ found=t.replace(/\s+/g," ").trim().slice(0,120); break; } }
        }catch(e){}
      }
      if(found) process.stdout.write(found);
    ' "$j" "$tailb" $q 2>/dev/null)
    # 脱敏:疑似 token(sk-/长 hex/长 base64)打码
    gist=$(printf '%s' "$gist" | sed -E 's/(sk-[A-Za-z0-9_-]{6})[A-Za-z0-9_-]+/\1…/g; s/[A-Za-z0-9]{32,}/<REDACTED>/g')
    if [ -z "$gist" ]; then
      # content 里没抠到(命中可能在工具输出/路径等非对话文本)→ 回落:抽首个命中词所在原始行的
      # 可读片段(去 JSON 转义噪音,截断),让用户仍能看到匹配上下文。
      local w1b; w1b=$(printf '%s' "$q" | awk '{print $1}')
      gist=$(tail -c "$tailb" "$j" 2>/dev/null | grep -i -m1 -- "$w1b" 2>/dev/null \
        | sed -E 's/\\[a-z]//g; s/[{}"]//g; s/\s+/ /g' | cut -c1-110)
      [ -n "$gist" ] && gist="~ $gist"
    fi
    [ -z "$gist" ] && gist="(命中 $hits 处)"
    printf '%s#%d%s  %s%s%s  %s(%s · %s · %s)%s\n' "$c_dim" "$rank" "$c_reset" "$c_name" "$name" "$c_reset" "$c_dim" "$st" "$be" "$cwdb" "$c_reset"
    printf '    概要: %s\n' "$gist"
    printf '    打开: %screw %s%s\n\n' "$c_cmd" "$name" "$c_reset"
  done <<< "$top"
}

# 2026-08-31:解析会话真实工作目录。优先级(对齐 v1 path_for_name + $PWD 回落):
#   显式 --dir($DIR 非空) > registry 里 <cwd>\t<name> 按 name 反查 > state.dir > $PWD。
# 换模型/重启 live 会话时不应丢工作目录 —— 会话早在 registry(首次 spawn 时写入),从那反查
# 回它原来的目录;claude 的 --resume 也依赖在正确 cwd 起(否则按错 project 目录找历史崩)。
# --- 交互选择器(移植自 v1 --pick)------------------------------------------
# _pick_one <title> <default>:选项从 stdin(每行一个),选中值到 stdout。fzf 优先,否则编号菜单
# (接受编号、选项原文、唯一前缀;Enter 保持默认)。所有提示走 stderr,只有选中值进 stdout。
_pick_one() {
  local title="$1" def="$2" chosen=""
  local opts=() line
  while IFS= read -r line; do [ -n "$line" ] && opts+=("$line"); done
  [ "${#opts[@]}" -eq 0 ] && { printf '%s' "$def"; return; }
  if command -v fzf >/dev/null 2>&1; then
    local ordered; ordered=$( { [ -n "$def" ] && printf '%s\n' "$def"; local o; for o in "${opts[@]}"; do [ "$o" = "$def" ] || printf '%s\n' "$o"; done; } )
    chosen=$(printf '%s\n' "$ordered" | fzf --height=40% --reverse --prompt="$title > " \
            --header="Enter=选中  Esc=保持默认 [$def]" 2>/dev/tty) || chosen=""
  else
    local i
    printf '\n== %s ==  (输编号,或 Enter 保持默认: %s)\n' "$title" "$def" >&2
    i=1; for line in "${opts[@]}"; do printf '  %2d) %s%s\n' "$i" "$line" "$([ "$line" = "$def" ] && printf '  (默认)')" >&2; i=$((i+1)); done
    local reply; printf '  选 > ' >&2; read -r reply </dev/tty
    if [ -z "$reply" ]; then chosen="$def"
    elif [ "$reply" -ge 1 ] 2>/dev/null && [ "$reply" -le "${#opts[@]}" ] 2>/dev/null; then chosen="${opts[$((reply-1))]}"
    else
      local o m="" hits=0 h="" rl; rl=$(printf '%s' "$reply" | tr 'A-Z' 'a-z')
      for o in "${opts[@]}"; do [ "$o" = "$reply" ] && { m="$o"; break; }; done
      if [ -z "$m" ]; then
        for o in "${opts[@]}"; do case "$(printf '%s' "$o" | tr 'A-Z' 'a-z')" in "$rl"*) hits=$((hits+1)); h="$o";; esac; done
        [ "$hits" = 1 ] && m="$h"
      fi
      if [ -n "$m" ]; then chosen="$m"; else printf '  无匹配 "%s" — 保持默认: %s\n' "$reply" "$def" >&2; chosen="$def"; fi
    fi
  fi
  [ -z "$chosen" ] && chosen="$def"
  printf '%s' "$chosen"
}
# backend 名列表(backends/*.conf 去 .conf),每行一个
_list_backends() {
  local f
  for f in "$CREW_HOME"/backends/*.conf; do
    [ -f "$f" ] || continue
    basename "$f" .conf
  done | sort -u
}
# key 别名列表(keys.conf 的 alias=... 左侧),每行一个
_list_keys() {
  [ -f "$CREW_HOME/keys.conf" ] || return 0
  awk -F= '/^[[:space:]]*#/{next} /=/{gsub(/^[[:space:]]+|[[:space:]]+$/,"",$1); if($1)print $1}' "$CREW_HOME/keys.conf" | sort -u
}

resolve_session_dir() {
  local name="$1" d=""
  if [ -n "$DIR" ]; then echo "$DIR"; return; fi
  local reg="$CREW_STATE/registry"
  if [ -f "$reg" ]; then
    d=$(awk -F'\t' -v n="$name" '$2==n{print $1; exit}' "$reg" 2>/dev/null)
  fi
  [ -z "$d" ] && d=$("$CS" get "$name" dir 2>/dev/null || echo "")
  [ -z "$d" ] && d="$PWD"
  echo "$d"
}

cmd_spawn() {
  local name="$1"; shift
  local task="$*"
  [ -z "$name" ] && die "no name"

  # 2026-08-31:--pick 强制交互选 model/key(换模型/新起的交互入口)。默认值取会话现有 backend/key
  # (换模型时预选当前)。放在 attach 判断【之前】跑,这样选完的 BACKEND/KEY 能被下面的 live 换模型
  # 逻辑识别(触发重启换模型)。仅 --pick 触发,避免误伤纯 `crew <会话>` attach。
  # 需交互终端(-t 0);非交互(脚本)即使传 --pick 也跳过(无 tty 没法选)。
  if [ "$PICK" = 1 ] && [ -t 0 ]; then
    local _def_be; _def_be=$("$CS" get "$name" backend 2>/dev/null || echo "")
    local _picked_be; _picked_be=$(_list_backends | _pick_one "选模型 backend ($name)" "$_def_be")
    [ -n "$_picked_be" ] && BACKEND="$_picked_be"
    local _def_key; _def_key=$("$CS" get "$name" key 2>/dev/null || echo "")
    local _picked_key; _picked_key=$(_list_keys | _pick_one "选 key ($name)" "$_def_key")
    [ -n "$_picked_key" ] && KEY="$_picked_key"
  fi

  # 2026-08-30 audit-crew A5(P0):registry 写方收口 —— spawn 起会话时把 <cwd,name>
  # 落 registry(v2 之前只 clean 删行、从不写入,导致 agent-bridge crew-session-sync 侧
  # 长期看不见 v2 会话,DIR 兜底靠 /proc)。
  # 2026-08-31:解析真实工作目录(显式--dir > registry反查 > state.dir > $PWD),供 registry
  # 写入与传给 launcher 共用。显式 --dir 且与 registry 现值不同时,更新该行(原逻辑只首次写,
  # 导致换模型重启时 --dir 被忽略、会话掉回 /work)。
  local reg="$CREW_STATE/registry"
  mkdir -p "$CREW_STATE"
  local session_dir; session_dir=$(resolve_session_dir "$name")
  if ! [ -f "$reg" ] || ! awk -F'\t' -v m="$name" '$2==m{ok=1}END{exit !ok}' "$reg" 2>/dev/null; then
    printf '%s\t%s\n' "$session_dir" "$name" >> "$reg"
  elif [ -n "$DIR" ]; then
    # 显式 --dir:若 registry 里该 name 的 cwd 与之不同,重写该行
    local cur_reg_dir
    cur_reg_dir=$(awk -F'\t' -v n="$name" '$2==n{print $1; exit}' "$reg" 2>/dev/null)
    if [ "$cur_reg_dir" != "$DIR" ]; then
      awk -F'\t' -v n="$name" -v d="$DIR" 'BEGIN{OFS="\t"} $2==n{$1=d} {print}' "$reg" > "$reg.tmp" 2>/dev/null \
        && mv "$reg.tmp" "$reg"
    fi
  fi

  # 2026-08-30 修:v1 语义——crew <name> 无 task 且 tmux 已 live 时,attach 而非新起
  # (踩坑:用户跑 crew work,v2 无脑 spawn 灌新 launcher → 新起 crew-work tmux,
  # 而真 work tmux 还活着,claude 被分叉;pinned adopt 会话尤其危险)
  # 有 --fresh / 有 task / --no-tmux 时不走 attach,按用户显式意图 spawn
  if [ -z "$task" ] && [ "$FRESH" = 0 ] && [ "$NO_TMUX" = 0 ]; then
    local existing
    existing=$("$CT" resolve "$name" 2>/dev/null || true)
    if [ -n "$existing" ] && "$CT" list 2>/dev/null | grep -qFx "$existing"; then
      # 2026-08-31:补回 v1 的"live 会话就地换 model/key"语义(v2 重构时丢了)。
      # 显式传了 --model/--key 且与 state 现值不同 → 停旧的、写新值、往下 spawn(sid 在→launcher
      # 自动 --resume,历史保留)。没传(纯 crew <name>)→ 仍 attach,不动。
      local _cur_backend _cur_key _want_restart=0
      _cur_backend=$("$CS" get "$name" backend 2>/dev/null || echo "")
      _cur_key=$("$CS" get "$name" key 2>/dev/null || echo "")
      if [ -n "$BACKEND" ] && [ "$BACKEND" != "$_cur_backend" ]; then
        log "切换 '$name' 模型: ${_cur_backend:-<无>} -> $BACKEND(重启,--resume 保历史)"; _want_restart=1
      fi
      if [ -n "$KEY" ] && [ "$KEY" != "$_cur_key" ]; then
        log "切换 '$name' key: ${_cur_key:-<无>} -> $KEY(重启,--resume 保历史)"; _want_restart=1
      fi
      if [ "$_want_restart" = 1 ]; then
        "$CT" kill "$name" 2>/dev/null || true   # 停旧的;sid/state 保留,下面 spawn 会 --resume
      else
        log "'$name' 已 live (tmux=$existing) → attach(换模型/key 加 --model/--key;要新起加 --fresh 或 crew kill 后再来)"
        exec "$CT" attach "$name"
      fi
    fi
  fi

  # 2026-08-31:走到这 = 确定要 spawn(没被 attach exec 掉)。若没传 --model 且会话也没记忆过
  # backend、又是交互终端 → 弹菜单选(新起会话"没输入就交互")。已有记忆 backend 的(如重起旧会话)
  # 不打扰,沿用记忆值。非交互(脚本)不弹,让下游按 state/报错处理。
  if [ -z "$BACKEND" ] && [ -t 0 ] && ! "$CS" has "$name" backend 2>/dev/null; then
    local _def_be2 _picked_be2
    _def_be2=$(_list_backends | head -1)
    _picked_be2=$(_list_backends | _pick_one "选模型 backend ($name)" "$_def_be2")
    [ -n "$_picked_be2" ] && BACKEND="$_picked_be2"
    if [ -z "$KEY" ] && ! "$CS" has "$name" key 2>/dev/null; then
      local _picked_key2; _picked_key2=$(_list_keys | _pick_one "选 key ($name)" "")
      [ -n "$_picked_key2" ] && KEY="$_picked_key2"
    fi
  fi

  [ -n "$BACKEND" ] && "$CS" set "$name" backend "$BACKEND"
  [ -n "$KEY" ] && "$CS" set "$name" key "$KEY"
  # --policy X:设 per-session policy 文件(v2 修② 2026-08-30)
  if [ -n "$POLICY" ]; then
    if [ "$POLICY" = "-" ]; then
      "$CS" del "$name" policy
      log "AGENT_POLICY session pin cleared for '$name'"
    else
      "$CS" set "$name" policy "$POLICY"
      log "AGENT_POLICY pinned for '$name' -> $POLICY"
    fi
  fi

  # 2026-08-31 audit-crew P2-b:mode 决策(五概念解耦)
  #   --use-current-tmux 最高优先(用户显式意图 = 已在 tmux pane 里,别再 new-session)
  #   --no-tmux 次之:pinned 时忽略(pinned 语义 = "always on tmux"),否则 fg
  #   默认 tmux(new-session)
  local mode="tmux"
  if [ "$USE_CUR_TMUX" = 1 ]; then
    mode="use-current-tmux"
    log "'$name' 使用当前 tmux pane 起 claude(不 new-session,pinned 状态不动)"
  elif [ "$NO_TMUX" = 1 ]; then
    if "$CS" has "$name" pintmux 2>/dev/null; then
      log "'$name' is pinned to tmux (always-on); ignoring --no-tmux."
    else
      mode="fg"
    fi
  fi

  local -a extra_args=()
  [ "$FRESH" = 1 ] && extra_args+=(--fresh)
  [ -n "$task" ] && extra_args+=(--task "$task")

  "$CL" spawn --name "$name" --mode "$mode" --dir "$session_dir" "${extra_args[@]}"
}

# 2026-09-01:机会式自动清理陈旧会话(节流每天一次,后台跑)。排除 prune 自身避免递归;
# 排除纯读命令无妨(它也只是后台触发一次)。live/pinned 绝不删,见 cmd_prune。
case "$CMD" in prune) : ;; *) crew_autoprune ;; esac

case "$CMD" in
  ls|list)      cmd_ls "$@" ;;
  attach)       cmd_attach "$@" ;;
  stop)         cmd_stop "$@" ;;
  kill)         cmd_kill "$@" ;;
  pin)          cmd_pin "$@" ;;
  unpin)        cmd_unpin "$@" ;;
  adopt)        cmd_adopt "$@" ;;
  send)         cmd_send "$@" ;;
  inbox)        cmd_inbox "$@" ;;
  log)          cmd_log "$@" ;;
  models|backends) cmd_models ;;
  keys)         cmd_keys ;;
  addkey|add-key) cmd_addkey "$@" ;;
  doctor)       cmd_doctor "$@" ;;
  version)      cmd_version "$@" ;;
  switch)       cmd_switch "$@" ;;
  find)         cmd_find "$@" ;;
  prune)        cmd_prune "$@" ;;
  help|--help|-h) sed -n '3,22p' "$0" ;;
  *)            cmd_spawn "$CMD" "$@" ;;
esac
