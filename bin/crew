#!/usr/bin/env bash
# crew — 顶层 CLI,兼容旧 API 21 命令(2026-08-30 crew L 重构 Week 3)
#
# 分发到三个独立工具:
#   crew-session   状态管理
#   crew-tmux      tmux 集成
#   crew-launcher  claude 启动
#
# 命令:
#   crew <name> [task]       起会话(默认 tmux 模式,已存在则 attach)
#   crew ls [--json]         列会话
#   crew attach <name>       attach tmux
#   crew stop <name>         停 tmux 保状态(B2 防自杀:CREW_STOP_ALLOW_SELF_KILL=1 绕过)
#   crew kill <name> [--purge]  删会话
#   crew pin/unpin <name>    pin/unpin tmux
#   crew adopt <name> <tmux> [--sid X] [--dir P] [--model M]
#   crew send <name> "msg" [--no-wake]  发消息到会话 inbox + 默认唤醒(--no-wake 只落信封)
#   crew notify <name> "msg" 发消息并唤醒(send+wake 合一,确保会话看到)
#   crew wake <name>         唤醒会话(paneIdle 判据 + 双 Enter + pending 队列)
#   crew inbox <name> [--peek]  读 inbox(带时间戳,消费后归档)
#   crew status <name>       会话健康摘要(心跳/inbox/pending)
#   crew register            会话注册(读 cwd 判归属,原子写 project.json sessions[])
#   crew heartbeat           60s 采样守护(单例,抓 ctxPct 等)
#   crew web                 独立前端 :18060(会话卡片 + 收发 + 切模型 + attach)
#   crew log <name>          看 transcript
#   crew models              按 key 分组列每个 key 支持的真实模型
#   crew models <key>        列该 key 能路由的模型(从 CCR provider 反查;joycode 系含全部)
#   crew backends            列内部 backend conf 文件名(实现细节,选模型用 crew models)
#   crew sync-models [--key A] 从上游发现新模型,多选加进 CCR 并重启(joycode 从 :8765 拉)
#   crew keys                列 key 别名(值脱敏)
#   crew addkey <key> [别名] 加一把 key 到 keys.conf(别名不给则自动派生)
#   crew switch <会话>       交互切 key→model(都默认当前值,选完重启换)
#   crew resume-prev <会话>  找回上次被 --fresh 覆盖前的老历史(sid 换回归档的 prev_sid)
#   crew find <描述...>      搜已有会话历史,返回 Top5(会话名+概要+打开命令)
#   crew prune [--dry-run] [--days N] [--purge-days M]  清陈旧会话(默认>7d 删状态、>30d 连历史删;
#                            live/pinned 不删,平时自动跑;每会话打空闲天数+结果)
#   crew doctor              自检
#   crew version [--check]   版本
#
# 全局 flags:
#   --model M --key K --tmux --no-tmux --fresh --safe --pick --dir P
#   --pick  交互选 model+key(菜单);crew <会话> 不带 --model 新起时也会自动弹菜单选

set -uo pipefail

CREW_STATE="${CREW_STATE:-${XDG_DATA_HOME:-$HOME/.local/share}/claude-crew}"
CREW_HOME="${CREW_HOME:-$HOME/.config/claude-crew}"
# SCRIPT_DIR = 真实 bin/ 目录。crew 常经软链调用(~/.local/bin/crew -> <clone>/bin/crew),
# 需先解析软链链,否则 SCRIPT_DIR 会误指 ~/.local/bin(那里没有 crew-* 兄弟工具)→ exit 127。
# 用手动 while 循环而非 `readlink -f`:macOS 自带 readlink 不支持 -f(会返回空),while 版 mac+Linux 通用。
_crew_self="${BASH_SOURCE[0]:-$0}"
while [ -L "$_crew_self" ]; do
  _crew_link="$(readlink "$_crew_self")"
  case "$_crew_link" in /*) _crew_self="$_crew_link";; *) _crew_self="$(dirname "$_crew_self")/$_crew_link";; esac
done
SCRIPT_DIR="$(cd "$(dirname "$_crew_self")" && pwd)"
CS="$SCRIPT_DIR/crew-session"
CT="$SCRIPT_DIR/crew-tmux"
CL="$SCRIPT_DIR/crew-launcher"
CR="$SCRIPT_DIR/crew-register.js"
CW="$SCRIPT_DIR/crew-wake.js"
CN="$SCRIPT_DIR/crew-notify.js"
CH="$SCRIPT_DIR/crew-heartbeat.js"
CST="$SCRIPT_DIR/crew-status.js"
CWEB="$SCRIPT_DIR/crew-web.js"

log() { echo "[crew] $*" >&2; }
die() { log "$*"; exit 1; }

# 全局 flags 解析
BACKEND=""
KEY=""
POLICY=""
NO_TMUX=0
FRESH=0
SAFE=0
USE_CUR_TMUX=0  # 2026-08-31 audit-crew P2-b:--use-current-tmux flag
PICK=0          # 2026-08-31:--pick 强制弹交互菜单(即使已传 --model/--key)
DIR=""          # 2026-08-31:默认空 = "未显式传 --dir"(区分于 "传了 = $PWD")。cmd_spawn
                # 里按 显式--dir > registry反查 > $PWD 解析真实工作目录。
# 2026-08-31:全程扫描 flags(与 v1 一致)——flag 可出现在会话名之后,如 `crew t1 --model X`。
# 非 flag(子命令/会话名/task)收进 POS,flag 在任意位置都被吃掉。避免 `crew <name> --model X`
# 里 --model 被当位置参数吞掉、静默不生效(换模型看似没反应)的坑。
POS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --model) BACKEND="$2"; shift 2 ;;
    --key) KEY="$2"; shift 2 ;;
    --policy) POLICY="$2"; shift 2 ;;
    --tmux) NO_TMUX=0; shift ;;
    --no-tmux) NO_TMUX=1; shift ;;
    --use-current-tmux) USE_CUR_TMUX=1; shift ;;
    --fresh) FRESH=1; shift ;;
    --safe) SAFE=1; shift ;;
    --dir) DIR="$2"; shift 2 ;;
    --pick) PICK=1; shift ;;
    -v|--version) POS=(version); shift; break ;;   # 2026-09-01:--version/-v 等价 version 子命令(之前被当会话名误起)
    -h|--help) POS=(help); shift; break ;;
    --) shift; while [ $# -gt 0 ]; do POS+=("$1"); shift; done; break ;;
    *) POS+=("$1"); shift ;;
  esac
done
set -- "${POS[@]}"

if [ $# -eq 0 ]; then
  # 2026-09-01:crew 空参 → 交互(选已有会话 attach,或"+ 新建")。非交互(脚本/无 tty)回落 ls
  # (保持管道/脚本行为不变)。CREW_NO_MENU=1 也强制 ls。
  if [ -t 0 ] && [ -z "${CREW_NO_MENU:-}" ]; then set -- menu; else set -- ls; fi
fi

CMD="$1"; shift

cmd_ls() {
  local live_sessions
  live_sessions=$("$CT" list 2>/dev/null || echo "")
  local kr="$SCRIPT_DIR/crew-keyresolve.js"
  printf '  %-20s %-9s %-56s %-10s %-30s\n' "NAME" "STATUS" "MODEL" "KEY" "DIR"

  # 2026-08-31 perf:两遍式 —— 第一遍纯 bash/proc 收集每会话 name/sid/backend(真模型)/dir/tmuxname
  # 到数组;然后【一次】node --batch 解析所有会话的 model/key(原来每会话 spawn 一次 node ≈占 ls
  # 耗时一半);第二遍打印。用 `< <(...)` 让循环在主 shell 跑(避免 `list | while` 的 subshell 吞数组)。
  local -a NAMES=() SIDS=() BACKENDS=() DIRS=() TMUXNS=()
  local name rest
  while IFS=$'\t' read -r name rest; do
    [ -z "$name" ] && continue
    local sid backend tmuxname dir claude_pid=""
    sid=$("$CS" get "$name" sid 2>/dev/null || echo "")
    backend=$("$CS" get "$name" backend 2>/dev/null || echo "?")
    # 内联 resolve(见前注):adopted(.tmux)> .tmuxname > live_sessions 查 name/crew-name
    tmuxname=""
    if [ -f "$CREW_STATE/$name.tmux" ]; then tmuxname=$(cat "$CREW_STATE/$name.tmux" 2>/dev/null)
    elif [ -f "$CREW_STATE/$name.tmuxname" ]; then tmuxname=$(cat "$CREW_STATE/$name.tmuxname" 2>/dev/null)
    elif echo "$live_sessions" | grep -qFx "$name"; then tmuxname="$name"
    elif echo "$live_sessions" | grep -qFx "crew-$name"; then tmuxname="crew-$name"
    fi
    dir=""
    # tmux live 时从 /proc 抠真 --model + 真 cwd(见前注)
    if [ -n "$tmuxname" ] && echo "$live_sessions" | grep -qFx "$tmuxname"; then
      local pane_pid
      pane_pid=$(tmux list-panes -t "$tmuxname" -F '#{pane_pid}' 2>/dev/null | head -1)
      if [ -n "$pane_pid" ]; then
        claude_pid=$(ps --no-headers -o pid,cmd --ppid "$pane_pid" 2>/dev/null | awk '/bin\/claude/{print $1; exit}')
      fi
      if [ -n "$claude_pid" ] && [ -r "/proc/$claude_pid/cmdline" ]; then
        local real_model real_cwd
        real_model=$(cat "/proc/$claude_pid/cmdline" 2>/dev/null | tr '\0' '\n' | awk '/^--model$/{getline; print; exit}')
        [ -n "$real_model" ] && backend="$real_model"
        real_cwd=$(readlink "/proc/$claude_pid/cwd" 2>/dev/null)
        [ -n "$real_cwd" ] && dir="$real_cwd"
      fi
    fi
    # DIR 兜底:/proc 抠不到 → registry 反查
    if [ -z "$dir" ] || [ "$dir" = "-" ]; then
      dir="-"
      if [ -f "$CREW_STATE/registry" ]; then
        local reg_dir
        reg_dir=$(awk -F'\t' -v n="$name" '$2==n{print $1; exit}' "$CREW_STATE/registry" 2>/dev/null)
        [ -n "$reg_dir" ] && dir="$reg_dir"
      fi
    fi
    NAMES+=("$name"); SIDS+=("$sid"); BACKENDS+=("$backend"); DIRS+=("$dir"); TMUXNS+=("$tmuxname")
  done < <("$CS" list 2>/dev/null)

  # 一次批量 keyresolve:喂 name<TAB>backend,拿回 name<TAB>model<TAB>key。存进两个"并行数组"式查表。
  local -A KR_MODEL=() KR_KEY=()
  if [ -f "$kr" ] && command -v node >/dev/null 2>&1 && [ "${#NAMES[@]}" -gt 0 ]; then
    local batch_in="" i
    for i in "${!NAMES[@]}"; do batch_in+="${NAMES[$i]}"$'\t'"${BACKENDS[$i]}"$'\n'; done
    local batch_out
    batch_out=$(printf '%s' "$batch_in" | env -i HOME="$HOME" PATH="$PATH" CREW_STATE="$CREW_STATE" CREW_HOME="$CREW_HOME" node "$kr" --batch 2>/dev/null)
    local bn bm bk
    while IFS=$'\t' read -r bn bm bk; do
      [ -z "$bn" ] && continue
      KR_MODEL["$bn"]="$bm"; KR_KEY["$bn"]="$bk"
    done <<< "$batch_out"
  fi

  # 第二遍:打印(查批量表;缺则回落 state)
  local i
  for i in "${!NAMES[@]}"; do
    name="${NAMES[$i]}"
    local sid="${SIDS[$i]}" backend="${BACKENDS[$i]}" dir="${DIRS[$i]}" tmuxname="${TMUXNS[$i]}" key=""
    local m_kr="${KR_MODEL[$name]:-}" k_kr="${KR_KEY[$name]:-}"
    [ "$backend" = "?" ] && [ -n "$m_kr" ] && [ "$m_kr" != "?" ] && backend="$m_kr"
    [ -n "$k_kr" ] && [ "$k_kr" != "?" ] && key="$k_kr"
    [ -z "$key" ] && key=$("$CS" get "$name" key 2>/dev/null || echo "-")
    local status="new"
    if echo "$live_sessions" | grep -qFx "$tmuxname"; then
      status="live"
      "$CS" has "$name" pintmux 2>/dev/null && status="live 📌"
    elif [ -n "$sid" ]; then
      status="resumable"
    fi
    printf '  %-20s %-9s %-56s %-10s %-30s\n' "$name" "$status" "$backend" "$key" "$dir"
  done
}

cmd_attach() {
  local name="$1"
  [ -z "$name" ] && die "usage: crew attach <name>"
  "$CT" attach "$name"
}

# crew(空参)交互菜单:列已有会话选一个 attach,或选"+ 新建会话"进创建流程(问名 → spawn,
# 新起会走 cmd_spawn 里"没输入就弹菜单选模型")。需交互终端(入口已保证)。
cmd_menu() {
  [ -t 0 ] || { cmd_ls; return 0; }   # 无 tty:回落 ls,不去读 /dev/tty(会崩)
  local live_sessions; live_sessions=$("$CT" list 2>/dev/null || echo "")
  # 会话选项:每行 "会话名   (状态·模型)",带一个新建项。用 tab 后缀藏真实会话名便于回取。
  local opts="+ 新建会话" nm st be tn
  while IFS= read -r nm; do
    [ -n "$nm" ] || continue
    tn=""
    if [ -f "$CREW_STATE/$nm.tmux" ]; then tn=$(cat "$CREW_STATE/$nm.tmux" 2>/dev/null)
    elif [ -f "$CREW_STATE/$nm.tmuxname" ]; then tn=$(cat "$CREW_STATE/$nm.tmuxname" 2>/dev/null)
    elif echo "$live_sessions" | grep -qFx "$nm"; then tn="$nm"
    elif echo "$live_sessions" | grep -qFx "crew-$nm"; then tn="crew-$nm"; fi
    st="resumable"; echo "$live_sessions" | grep -qFx "$tn" && st="live"
    be=$("$CS" get "$nm" backend 2>/dev/null || echo "?")
    opts+=$'\n'"$nm   ($st · $be)"
  done < <("$CS" list 2>/dev/null | cut -f1 | sort -u)

  local chosen; chosen=$(printf '%s\n' "$opts" | _pick_one "crew 会话(选一个 attach,或新建)" "+ 新建会话")
  [ -z "$chosen" ] && return 0
  if [ "$chosen" = "+ 新建会话" ]; then
    local newname=""; printf '新会话名 > ' >&2; read -r newname </dev/tty 2>/dev/null || true
    [ -z "$newname" ] && { log "取消"; return 0; }
    # 2026-09-02:让用户选启动模式(默认 tmux 后台常驻;no-tmux 前台占当前终端)
    local _mode; _mode=$(printf 'tmux (后台常驻,推荐)\nno-tmux (前台,占当前终端)\n' | _pick_one "启动模式 ($newname)" "tmux (后台常驻,推荐)")
    case "$_mode" in no-tmux*) NO_TMUX=1 ;; esac
    cmd_spawn "$newname"   # 新起:cmd_spawn 里没传 --model 会自动弹选模型
  else
    # 取回真实会话名(截 "名   (..." 前段)
    local pick_name; pick_name="${chosen%%   (*}"
    cmd_spawn "$pick_name"  # 已有 live → attach;resumable → 重起
  fi
}

cmd_stop() {
  local name="$1"
  [ -z "$name" ] && die "usage: crew stop <name>"
  if [ -z "${CREW_STOP_ALLOW_SELF_KILL:-}" ] && "$CT" is-inside "$name" 2>/dev/null; then
    die "B2: refuse to stop '$name' — you are running inside its tmux session. Run 'crew stop $name' from OUTSIDE, or set CREW_STOP_ALLOW_SELF_KILL=1 to override."
  fi
  "$CT" kill "$name"
  log "stopped $name (state kept; resume with: crew $name)"
}

cmd_kill() {
  # 2026-08-31 修 flag 顺序 bug:原实现 `local name=$1; shift; [ $1 = --purge ]`
  # 假定 `kill <name> --purge` 严格顺序。用户跑 `crew kill --purge <name>` 时
  # name 被赋值成 "--purge",然后拿字符串 "--purge" 当会话名去 tmux/state clean,
  # 真会话不被杀。改成全程扫描 flag,与主脚本 line 67-73 同哲学(flag 位置无关)。
  local name="" purge=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --purge) purge=1; shift ;;
      --) shift; [ -z "$name" ] && name="${1:-}" && shift; break ;;
      -*) die "unknown flag for kill: $1 (usage: crew kill <name> [--purge])" ;;
      *) [ -z "$name" ] && name="$1"; shift ;;
    esac
  done
  [ -z "$name" ] && die "usage: crew kill <name> [--purge]"
  if [ -z "${CREW_KILL_ALLOW_SELF:-}" ] && "$CT" is-inside "$name" 2>/dev/null; then
    die "B2: refuse to kill '$name' — you are running inside its tmux session. Run 'crew kill $name' from OUTSIDE, or set CREW_KILL_ALLOW_SELF=1 to override."
  fi
  "$CT" kill "$name"
  if [ "$purge" = 1 ]; then
    "$CS" clean "$name" --purge-transcript
  else
    "$CS" clean "$name"
  fi
  log "deleted session '$name'"
}

cmd_pin() {
  local name="$1"
  [ -z "$name" ] && die "usage: crew pin <name>"
  "$CS" set "$name" pintmux 1
  log "'$name' pinned to tmux — --no-tmux will be refused. Un-pin: crew unpin $name"
}
cmd_unpin() {
  local name="$1"
  [ -z "$name" ] && die "usage: crew unpin <name>"
  "$CS" del "$name" pintmux
  log "'$name' un-pinned — --no-tmux (foreground) is allowed again"
}

cmd_adopt() {
  local a_name="$1" a_tmux="$2"; shift 2
  local a_sid="" a_model=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --sid) a_sid="$2"; shift 2 ;;
      --dir) shift 2 ;;
      --model) a_model="$2"; shift 2 ;;
      *) shift ;;
    esac
  done
  [ -z "$a_name" ] || [ -z "$a_tmux" ] && die "usage: crew adopt <name> <tmux-session>"
  if ! "$CT" list 2>/dev/null | grep -qFx "$a_tmux"; then
    log "warn: tmux session '$a_tmux' not live right now (adopting anyway)"
  fi
  "$CS" set "$a_name" tmux "$a_tmux"
  [ -n "$a_sid" ] && "$CS" set "$a_name" sid "$a_sid"
  [ -n "$a_model" ] && "$CS" set "$a_name" backend "$a_model"
  # 2026-08-30 audit-crew A5(P0):adopt 也对称写 registry(clean 会删,起就得补)
  local reg="$CREW_STATE/registry"
  mkdir -p "$CREW_STATE"
  if ! [ -f "$reg" ] || ! awk -F'\t' -v m="$a_name" '$2==m{ok=1}END{exit !ok}' "$reg" 2>/dev/null; then
    printf '%s\t%s\n' "$DIR" "$a_name" >> "$reg"
  fi
  log "adopted '$a_name' -> tmux '$a_tmux' (sid ${a_sid:-<none>}); now in crew ls / attach. stop/kill/prune will refuse it. Un-adopt: rm $CREW_STATE/$a_name.tmux"
}

cmd_register() {
  # 注:--dir 被 crew 顶层全局 flag 解析吃进 $DIR(见文件头 74-91 while 循环),这里直接读全局。
  # register 专属 flag(--role/--kind/--bucket/--description/--remove)在本函数解析。
  local name="" role="" kind="" bucket="" desc="" remove=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --role)        role="$2"; shift 2 ;;
      --kind)        kind="$2"; shift 2 ;;
      --bucket)      bucket="$2"; shift 2 ;;
      --description) desc="$2"; shift 2 ;;
      --remove)      remove=1; shift ;;
      -*)            die "crew register: unknown flag $1" ;;
      *)             [ -z "$name" ] && name="$1"; shift ;;
    esac
  done
  [ -z "$name" ] && die "usage: crew register <name> [--dir P] [--role R] [--kind K] [--bucket B] [--description D] [--remove]"
  command -v node >/dev/null 2>&1 || die "crew register 需要 node"
  local args=(--name "$name")
  [ -n "$DIR" ] && args+=(--dir "$DIR")
  [ -n "$role" ] && args+=(--role "$role")
  [ -n "$kind" ] && args+=(--kind "$kind")
  [ -n "$bucket" ] && args+=(--bucket "$bucket")
  [ -n "$desc" ] && args+=(--description "$desc")
  [ "$remove" = 1 ] && args+=(--remove)
  node "$CR" "${args[@]}"  # exit code 透传(0=成功/幂等/remove, 5=无归属 project)
}

cmd_wake() {
  # crew wake <name> [--note "文本"] [--no-queue]
  # exit 透传 crew-wake.js:0=已唤醒 1=会话不存在 2=非 idle 已入 pending 3=tmux 不可用
  local name="" note="" noqueue=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --note)     note="$2"; shift 2 ;;
      --no-queue) noqueue=1; shift ;;
      -*)         die "crew wake: unknown flag $1" ;;
      *)          [ -z "$name" ] && name="$1"; shift ;;
    esac
  done
  [ -z "$name" ] && die "usage: crew wake <name> [--note \"文本\"] [--no-queue]"
  command -v node >/dev/null 2>&1 || die "crew wake 需要 node"
  local args=("$name")
  [ -n "$note" ] && args+=(--note "$note")
  [ "$noqueue" = 1 ] && args+=(--no-queue)
  node "$CW" "${args[@]}"
}

cmd_send() {
  # crew send <name> "msg" [--no-wake] —— 落 JSON 信封到 inbox + 唤醒会话(默认)。
  # 2026-09-02 根治老协议漏 wake 坑(proj-sfw1k 事故):crew send 内部行为改为 send+wake,
  # 与 crew notify 语义合流。原"只落信封不 wake"行为通过 --no-wake 保留(供批量广播用)。
  # 派单代码调 crew send 也自动 wake,不用再单独跟 wake 步骤。
  local no_wake=0 name="" msg_parts=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --no-wake) no_wake=1; shift ;;
      *) if [ -z "$name" ]; then name="$1"; else msg_parts+=("$1"); fi; shift ;;
    esac
  done
  [ -z "$name" ] && die "usage: crew send <name> \"msg\" [--no-wake]"
  [ "${#msg_parts[@]}" -eq 0 ] && die "crew send: 消息不能为空"
  local msg="${msg_parts[*]}"
  local sender="${CREW_SESSION_NAME:-crew-send}"
  command -v node >/dev/null 2>&1 || die "crew send 需要 node"
  # 1) 写信封(拿到路径 → id 反查)
  local fpath env_id
  fpath=$(node "$CN" write --to "$name" --from "session:$sender" --note "$msg") || die "crew send: envelope 写失败"
  env_id=$(node -e "console.log(JSON.parse(require('fs').readFileSync(process.argv[1])).id)" "$fpath" 2>/dev/null)
  log "queued -> inbox of '$name' (from $sender, id=$env_id)"
  # 2) 默认 wake(--no-wake 保留旧行为供批量广播)
  [ "$no_wake" = 1 ] && return 0
  node "$CW" "$name"
  local rc=$?
  # 3) wake 成功回写 delivery.wokeAt=now(与 crew notify 语义一致)
  if [ "$rc" = 0 ] && [ -n "$env_id" ]; then
    node "$CN" mark-woke --to "$name" --id "$env_id" >/dev/null 2>&1 || true
  fi
  return $rc
}

cmd_status() {
  # crew status <name> [--json]  → 单会话健康摘要(心跳/inbox/pending)
  # exit 契约:0=返健康态 / 4=未注册
  local name="" args=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) args+=(--json); shift ;;
      *) [ -z "$name" ] && name="$1"; shift ;;
    esac
  done
  [ -z "$name" ] && die "usage: crew status <name> [--json]"
  command -v node >/dev/null 2>&1 || die "crew status 需要 node"
  node "$CST" "$name" "${args[@]}"
}

cmd_heartbeat() {
  # crew heartbeat [--once] [--interval N] [--status]
  # 起心跳采样守护(单例,PID 文件反查);--once 采一次退,--status 查看当前进程
  command -v node >/dev/null 2>&1 || die "crew heartbeat 需要 node"
  node "$CH" "$@"
}

cmd_web() {
  # crew web [--port 18060]  → 起独立前端(单文件 node http,零依赖)
  # 需要心跳:未跑 crew heartbeat 时 ctxPct/tmux 状态是 null(前端仍能显示,只是空)
  command -v node >/dev/null 2>&1 || die "crew web 需要 node"
  node "$CWEB" "$@"
}

cmd_notify() {
  # crew notify <name> "msg" [--no-wake]  = send + wake 复合。
  # send 成功后自动 wake,wake 成功回写 delivery.wokeAt(mark-woke)。
  # exit 契约:0=send+wake 都成 / 2=send 成但目标非 idle(nudge 已入 pending) / 1=目标不存在 / 3=tmux 挂
  local no_wake=0 name="" msg_parts=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --no-wake) no_wake=1; shift ;;
      *) if [ -z "$name" ]; then name="$1"; else msg_parts+=("$1"); fi; shift ;;
    esac
  done
  [ -z "$name" ] && die "usage: crew notify <name> \"msg\" [--no-wake]"
  [ "${#msg_parts[@]}" -eq 0 ] && die "crew notify: 消息不能为空"
  local msg="${msg_parts[*]}"
  local sender="${CREW_SESSION_NAME:-crew-notify}"
  command -v node >/dev/null 2>&1 || die "crew notify 需要 node"
  # 1) 写信封(拿到路径 → id 反查)
  local fpath env_id
  fpath=$(node "$CN" write --to "$name" --from "session:$sender" --note "$msg") || die "crew notify: envelope 写失败"
  env_id=$(node -e "console.log(JSON.parse(require('fs').readFileSync(process.argv[1])).id)" "$fpath" 2>/dev/null)
  log "queued -> $name (id=$env_id): $fpath"
  # 2) wake(除非 --no-wake)
  [ "$no_wake" = 1 ] && return 0
  node "$CW" "$name"
  local rc=$?
  # 3) wake 成功回写 delivery.wokeAt=now
  if [ "$rc" = 0 ] && [ -n "$env_id" ]; then
    node "$CN" mark-woke --to "$name" --id "$env_id" >/dev/null 2>&1 || true
  fi
  return $rc
}

cmd_inbox() {
  # crew inbox <name> [--peek]
  # 默认消费:走 crew-notify.js ack —— 回写 delivery.state=acked + 移到 consumed/ + 镜像 ack 到 feedback.jsonl。
  # --peek 只看不消费(直接 dump JSON/msg 文件,不改状态,不归档)。
  # 兼容:目录里既可能是新 .json 信封,也可能是老 .msg 纯文本(逐步淘汰,消费 rm 无 ack)。
  local name="$1"; shift
  local peek=0
  [ "${1:-}" = "--peek" ] && peek=1
  [ -z "$name" ] && die "usage: crew inbox <name> [--peek]"
  local dir="$CREW_STATE/inbox/$name"
  [ -d "$dir" ] || { echo "(no messages)"; return 0; }
  if [ "$peek" = 1 ]; then
    local n=0
    for f in "$dir"/*.json "$dir"/*.msg; do
      [ -f "$f" ] || continue
      n=$((n+1))
      echo "── #$n  $(basename "$f") ──"
      if [[ "$f" == *.json ]]; then
        node -e '
          const e=JSON.parse(require("fs").readFileSync(process.argv[1]));
          const d=new Date(e.ts||0);
          const pad=n=>String(n).padStart(2,"0");
          const now=new Date();
          const sameDay=d.getFullYear()===now.getFullYear()&&d.getMonth()===now.getMonth()&&d.getDate()===now.getDate();
          const ts=isNaN(d.getTime())?"":(sameDay?pad(d.getHours())+":"+pad(d.getMinutes())+":"+pad(d.getSeconds()):(d.getMonth()+1)+"-"+pad(d.getDate())+" "+pad(d.getHours())+":"+pad(d.getMinutes()));
          console.log("["+ts+" "+e.from.kind+":"+e.from.id+"] "+e.note+"\n(id="+e.id+" state="+e.delivery.state+")");
        ' "$f"
      else
        # 老 .msg 从文件名解析 ts(命名格式 NNNN-YYYY-MM-DDTHH-MM-SS-...json/msg)
        local basen ts_display
        basen=$(basename "$f")
        ts_display=$(echo "$basen" | sed -nE 's/^[0-9]+-([0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}-[0-9]{2}-[0-9]{2}).*/\1/p' | sed 's/T/ /; s/-/:/3; s/-/:/3')
        [ -n "$ts_display" ] && echo "[$ts_display legacy]"
        cat "$f"
      fi
      echo
    done
    [ "$n" = 0 ] && echo "(no messages)"
    return 0
  fi
  # 消费:走 crew-notify.js ack,拿到一行一 JSON 信封的输出,打印可读格式。
  command -v node >/dev/null 2>&1 || die "crew inbox 需要 node"
  local n=0
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    n=$((n+1))
    printf -- "── #%d ──\n" "$n"
    printf '%s\n' "$line" | node -e '
      let d="";process.stdin.on("data",c=>d+=c).on("end",()=>{
        const e=JSON.parse(d);
        const dt=new Date(e.ts||0);
        const pad=n=>String(n).padStart(2,"0");
        const now=new Date();
        const sameDay=dt.getFullYear()===now.getFullYear()&&dt.getMonth()===now.getMonth()&&dt.getDate()===now.getDate();
        const ts=isNaN(dt.getTime())?"":(sameDay?pad(dt.getHours())+":"+pad(dt.getMinutes())+":"+pad(dt.getSeconds()):(dt.getMonth()+1)+"-"+pad(dt.getDate())+" "+pad(dt.getHours())+":"+pad(dt.getMinutes()));
        const src=e.from&&e.from.id?"["+ts+" "+e.from.kind+":"+e.from.id+"] ":(ts?"["+ts+"] ":"");
        console.log(src+e.note);
      })'
    echo
  done < <(node "$CN" ack --to "$name")
  if [ "$n" = 0 ]; then echo "(no messages)"; else echo "(consumed $n message(s), archived to inbox/$name/consumed/)"; fi
}

cmd_log() {
  local name="$1"
  [ -z "$name" ] && die "usage: crew log <name>"
  local sid
  sid=$("$CS" get "$name" sid 2>/dev/null) || die "no sid for '$name'"
  for f in "$HOME"/.claude/projects/*/"$sid".jsonl; do
    [ -f "$f" ] && { echo "$f"; return 0; }
  done
  die "transcript for sid '$sid' not found"
}

# 某 key(别名)能路由的模型:CCR 里凡 api_key 匹配该别名【真值】的 provider,union 其 models[]。
# (v1 ccr_models_for_key 补回 —— v2 重构丢了)。别名→真值查 keys.conf;provider.api_key 存的
# 是真 token(joycode 的真值恰好也叫 joycode)。joycode 系还可从 :8765 /v1/models 实时拉(更全),
# 但 CCR models[] 已够用且不依赖代理在线,优先用它。
ccr_models_for_key() {
  local alias="$1" cfg="$HOME/.claude-code-router/config.json"
  [ -f "$cfg" ] || return 0; command -v node >/dev/null 2>&1 || return 0
  # 别名 → 真值(keys.conf: alias=token);查不到就用别名本身当值(joycode 那种)
  local kv=""
  if [ -f "$CREW_HOME/keys.conf" ]; then
    kv=$(awk -F= -v a="$alias" '/^[[:space:]]*#/{next} {k=$1; gsub(/^[[:space:]]+|[[:space:]]+$/,"",k); if(k==a){v=substr($0,index($0,"=")+1); gsub(/^[[:space:]]+|[[:space:]]+$/,"",v); print v; exit}}' "$CREW_HOME/keys.conf")
  fi
  [ -z "$kv" ] && kv="$alias"
  KEY="$kv" node -e '
    const fs=require("fs");
    const c=JSON.parse(fs.readFileSync(process.argv[1],"utf8"));
    const ps=c.Providers||c.providers||[];
    const out=[];
    for(const p of ps){ if((p.api_key||p.apiKey)===process.env.KEY) for(const m of (p.models||[])) if(out.indexOf(m)<0) out.push(m); }
    process.stdout.write(out.join("\n"));
  ' "$cfg" 2>/dev/null
}

# 同上,但返回 "provider,model" 全名(可直接当 backend / --model 用,让 CCR 精确路由)。
# switch/pick 菜单用这个 —— 选中即得可用的 backend 值,无需再拼 provider。
ccr_models_for_key_full() {
  local alias="$1" cfg="$HOME/.claude-code-router/config.json"
  [ -f "$cfg" ] || return 0; command -v node >/dev/null 2>&1 || return 0
  local kv=""
  if [ -f "$CREW_HOME/keys.conf" ]; then
    kv=$(awk -F= -v a="$alias" '/^[[:space:]]*#/{next} {k=$1; gsub(/^[[:space:]]+|[[:space:]]+$/,"",k); if(k==a){v=substr($0,index($0,"=")+1); gsub(/^[[:space:]]+|[[:space:]]+$/,"",v); print v; exit}}' "$CREW_HOME/keys.conf")
  fi
  [ -z "$kv" ] && kv="$alias"
  KEY="$kv" node -e '
    const fs=require("fs");
    const c=JSON.parse(fs.readFileSync(process.argv[1],"utf8"));
    const ps=c.Providers||c.providers||[];
    const out=[];
    for(const p of ps){ if((p.api_key||p.apiKey)===process.env.KEY) for(const m of (p.models||[])){ var full=p.name+","+m; if(out.indexOf(full)<0) out.push(full); } }
    process.stdout.write(out.join("\n"));
  ' "$cfg" 2>/dev/null
}

# 别名 → 真值(keys.conf: alias=token)。查不到回显别名本身。sync-models / 反查共用。
lookup_key() {
  local alias="$1"
  [ -f "$CREW_HOME/keys.conf" ] || { echo "$alias"; return; }
  local v
  v=$(awk -F= -v a="$alias" '/^[[:space:]]*#/{next} {k=$1; gsub(/^[[:space:]]+|[[:space:]]+$/,"",k); if(k==a){vv=substr($0,index($0,"=")+1); gsub(/^[[:space:]]+|[[:space:]]+$/,"",vv); print vv; exit}}' "$CREW_HOME/keys.conf")
  [ -n "$v" ] && echo "$v" || echo "$alias"
}

# GET 一个 OpenAI 风格 /v1/models,输出 "owned_by<TAB>id" 每行。curl→python3→静默空。(移植 v1)
fetch_models_url() {
  local url="$1" tok="${2:-}" raw=""
  if command -v curl >/dev/null 2>&1; then
    if [ -n "$tok" ]; then raw=$(curl -fsS -m 12 -H "Authorization: Bearer $tok" "$url" 2>/dev/null)
    else raw=$(curl -fsS -m 12 "$url" 2>/dev/null); fi
  elif command -v python3 >/dev/null 2>&1; then
    raw=$(URL="$url" TOK="$tok" python3 -c '
import os,sys,urllib.request
r=urllib.request.Request(os.environ["URL"])
if os.environ.get("TOK"): r.add_header("Authorization","Bearer "+os.environ["TOK"])
sys.stdout.write(urllib.request.urlopen(r,timeout=12).read().decode())' 2>/dev/null)
  fi
  [ -n "$raw" ] || return 0
  printf '%s' "$raw" | node -e '
    let s=""; process.stdin.on("data",d=>s+=d).on("end",()=>{
      let d; try{ d=JSON.parse(s); }catch(e){ return; }
      for(const m of (d.data||d.models||[])){
        const id=m.id||m.name||m.chatApiModel||m.label; if(!id) continue;
        process.stdout.write((m.owned_by||"")+"\t"+id+"\n");
      }
    });
  ' 2>/dev/null
}

# 某 key 的 gateway origin(scheme://host):取 CCR 里该 key 某 provider 的 api_base_url。(移植 v1)
ccr_origin_for_key() {
  local kv="$1" cfg="$HOME/.claude-code-router/config.json"
  [ -f "$cfg" ] || return 0; command -v node >/dev/null 2>&1 || return 0
  KEY="$kv" node -e '
    const fs=require("fs");
    const c=JSON.parse(fs.readFileSync(process.argv[1],"utf8"));
    const p=(c.Providers||c.providers||[]).find(p=>(p.api_key||p.apiKey)===process.env.KEY && (p.api_base_url||p.apiBaseUrl));
    if(p){ try{ const u=new URL(p.api_base_url||p.apiBaseUrl); process.stdout.write(u.protocol+"//"+u.host); }catch(e){} }
  ' "$cfg" 2>/dev/null
}

# 多选(stdin 选项每行一个)→ 选中行到 stdout。fzf -m 优先,否则编号菜单接受 "1,3 5"/"all"/空取消。(移植 v1)
_pick_multi() {
  local title="$1"
  local opts=() line
  while IFS= read -r line; do [ -n "$line" ] && opts+=("$line"); done
  [ "${#opts[@]}" -eq 0 ] && return 0
  if command -v fzf >/dev/null 2>&1; then
    printf '%s\n' "${opts[@]}" | fzf --multi --height=50% --reverse --prompt="$title > " \
          --header="Tab=标记  Enter=确认  Esc=取消" 2>/dev/tty || true
  else
    local i
    printf '\n== %s ==  (编号如 "1,3 5"、"all"、或 Enter 取消)\n' "$title" >&2
    i=1; for line in "${opts[@]}"; do printf '  %2d) %s\n' "$i" "$line" >&2; i=$((i+1)); done
    local reply; printf '  选 > ' >&2; read -r reply </dev/tty 2>/dev/null || true
    [ -z "${reply:-}" ] && return 0
    if [ "$reply" = all ]; then printf '%s\n' "${opts[@]}"; return 0; fi
    local tok; for tok in $(printf '%s' "$reply" | tr ',' ' '); do
      [ "$tok" -ge 1 ] 2>/dev/null && [ "$tok" -le "${#opts[@]}" ] 2>/dev/null && printf '%s\n' "${opts[$((tok-1))]}"
    done
  fi
}

# 重启 CCR 让 config 变更生效:launchd(mac)/systemd(Linux user)/回落 ccr restart(容器)。失败静默。
ccr_restart() {
  if command -v launchctl >/dev/null 2>&1 && launchctl print "gui/$(id -u)/${CREW_CCR_LABEL:-com.claudecrew.ccr}" >/dev/null 2>&1; then
    launchctl kickstart -k "gui/$(id -u)/${CREW_CCR_LABEL:-com.claudecrew.ccr}" >/dev/null 2>&1 && return 0
  fi
  if command -v systemctl >/dev/null 2>&1 && systemctl --user status "${CREW_CCR_UNIT:-claudecrew-ccr}" >/dev/null 2>&1; then
    systemctl --user restart "${CREW_CCR_UNIT:-claudecrew-ccr}" >/dev/null 2>&1 && return 0
  fi
  # 回落:直接 ccr restart(165 容器 nohup 起法)
  if command -v ccr >/dev/null 2>&1; then
    ( ccr restart >/dev/null 2>&1 & ) 2>/dev/null || true
  fi
}

cmd_models() {
  local key="${1:-}"
  if [ -n "$key" ]; then
    # crew models <key别名>:列该 key 在 CCR 里能路由的模型(joycode/newkey/... 通用)
    local ms; ms=$(ccr_models_for_key "$key")
    if [ -z "$ms" ]; then
      echo "== '$key' 支持的模型 =="
      echo "  (CCR 里没有 api_key 匹配 '$key' 的 provider;或未装 CCR/node)"
      return 0
    fi
    echo "== '$key' 支持的模型 =="
    printf '%s\n' "$ms" | sed 's/^/  /'
    return 0
  fi
  # 2026-09-01:无参 crew models 按 key 分组列【真实模型】(不再列 backend conf 文件名——那套是
  # 内部实现,用户面只见 key+模型)。想看内部 backend conf 用 `crew backends`。
  local k any=0
  while IFS= read -r k; do
    [ -n "$k" ] || continue
    local ms; ms=$(ccr_models_for_key "$k")
    echo "== $k =="
    if [ -n "$ms" ]; then
      printf '%s\n' "$ms" | sed 's/^/  /'; any=1
    else
      echo "  (无可路由模型;crew addkey / crew sync-models --key $k 补充)"
    fi
  done < <(_list_keys)
  [ "$any" = 0 ] && echo "(keys.conf 里没有 key,或都没对应 CCR provider)"
  return 0
}

# crew backends —— 列内部 backend conf 文件名(实现细节;一般用户看 crew models 即可)
cmd_backends() {
  echo "== backends (内部实现,选模型请用 crew models) =="
  for f in "$CREW_HOME"/backends/*.conf; do
    [ -f "$f" ] || continue
    basename "$f" .conf | sed 's/^/  /'
  done
}

# crew keys —— 列 key 别名(值脱敏)
# crew sync-models [--key A] [--base-url URL] —— 从某 key 的上游发现新模型,多选加进 CCR,重启生效。
# joycode 从代理 :8765 /v1/models 拉(刷新 joycode/joycode-oai);其他 key 打其 gateway /v1/models,
# 每个新 model 建一个 <model>-<alias> provider。(移植自 v1)
cmd_sync_models() {
  local sm_key="$KEY" sm_base=""
  while [ $# -gt 0 ]; do case "$1" in
    --base-url) sm_base="${2:-}"; shift 2;;
    --base-url=*) sm_base="${1#*=}"; shift;;
    *) shift;;
  esac; done
  command -v node >/dev/null 2>&1 || die "crew sync-models 需要 node"
  # 1) 选 key
  if [ -z "$sm_key" ] || [ "$sm_key" = "-" ]; then
    [ -t 0 ] || die "crew sync-models 需 --key <别名> 或交互终端"
    sm_key=$(_list_keys | _pick_one "选要同步的 key" "")
    [ -n "$sm_key" ] || die "没选 key"
  fi
  local sm_kv; sm_kv=$(lookup_key "$sm_key")
  local ccrcfg="$HOME/.claude-code-router/config.json"
  [ -f "$ccrcfg" ] || die "CCR config 不存在 ($ccrcfg)"
  # 2) 拉上游模型
  local is_joycode=0 sm_remote=""
  [ "$sm_kv" = joycode ] && is_joycode=1
  if [ "$is_joycode" = 1 ]; then
    local jport="${JOYCODE_PORT:-8765}"
    sm_remote=$(fetch_models_url "http://127.0.0.1:$jport/v1/models" "")
    [ -n "$sm_remote" ] || die "joycode 代理(:$jport)没返回模型 —— 起了吗(crew up)?VS Code 登录了 JoyCode 吗?"
  else
    [ -n "$sm_base" ] || sm_base=$(ccr_origin_for_key "$sm_kv")
    [ -n "$sm_base" ] || die "查不到 key '$sm_key' 的 gateway URL(CCR 里还没 provider 用它);传 --base-url <origin>"
    sm_base="${sm_base%/}"
    sm_remote=$(fetch_models_url "$sm_base/v1/models" "$sm_kv")
    [ -n "$sm_remote" ] || die "gateway $sm_base/v1/models 没返回模型(鉴权/URL 问题?)"
  fi
  # 3) diff 出本地没有的
  local sm_have sm_new
  sm_have=$(ccr_models_for_key "$sm_key")
  sm_new=$(HAVE="$sm_have" awk -F'\t' '
    BEGIN{ n=split(ENVIRON["HAVE"],h,"\n"); for(i=1;i<=n;i++) if(h[i]!="") seen[h[i]]=1 }
    NF{ id=$2; if(id!="" && !(id in seen) && !(id in done)){ done[id]=1; print id } }
  ' <<EOF
$sm_remote
EOF
)
  if [ -z "$sm_new" ]; then echo "== sync-models: '$sm_key' 已有全部上游模型 =="; return 0; fi
  echo "== sync-models: '$sm_key' — 上游有 $(printf '%s\n' "$sm_new" | grep -c .) 个新模型 ==" >&2
  # 4) 多选
  local sm_pick; sm_pick=$(printf '%s\n' "$sm_new" | _pick_multi "加到 key '$sm_key'")
  sm_pick=$(printf '%s\n' "$sm_pick" | awk 'NF')
  [ -n "$sm_pick" ] || { echo "没选 — 不改动"; return 0; }
  # 5) 写 CCR(备份 + 原子写 + 失败 restore)
  local sm_bak="$ccrcfg.bak.$(date +%s 2>/dev/null || echo manual)"
  cp "$ccrcfg" "$sm_bak" || die "备份失败"
  local sm_added
  sm_added=$(CCR_CFG="$ccrcfg" ALIAS="$sm_key" KV="$sm_kv" ISJC="$is_joycode" BASE="$sm_base" \
    REMOTE="$sm_remote" PICK="$sm_pick" node -e '
    const fs=require("fs");
    const cfg=JSON.parse(fs.readFileSync(process.env.CCR_CFG,"utf8"));
    cfg.Providers=cfg.Providers||[];
    const owner={}; for(const ln of (process.env.REMOTE||"").split("\n")){ const i=ln.indexOf("\t"); if(i<0)continue; owner[ln.slice(i+1)]=ln.slice(0,i); }
    const pick=(process.env.PICK||"").split("\n").map(s=>s.trim()).filter(Boolean);
    const isjc=process.env.ISJC==="1", alias=process.env.ALIAS, kv=process.env.KV, base=(process.env.BASE||"").replace(/\/$/,"");
    const isAnthropic=m=> isjc ? /claude/i.test(m) : (owner[m]||"").toLowerCase()==="anthropic";
    let added=0, skipped=[];
    if(isjc){
      const pj=cfg.Providers.find(p=>p.name==="joycode"), po=cfg.Providers.find(p=>p.name==="joycode-oai");
      for(const m of pick){
        if(m.indexOf(" ")>=0){ skipped.push(m+"(含空格)"); continue; }
        const tgt=isAnthropic(m)?pj:po;
        if(!tgt){ skipped.push(m+"(无 joycode provider)"); continue; }
        tgt.models=tgt.models||[]; if(!tgt.models.includes(m)){ tgt.models.push(m); added++; }
      }
    } else {
      for(const m of pick){
        if(m.indexOf(" ")>=0){ skipped.push(m+"(含空格)"); continue; }
        const anth=isAnthropic(m); const pname=m+"-"+alias;
        if(cfg.Providers.some(p=>p.name===pname)){ skipped.push(m+"(已存在)"); continue; }
        cfg.Providers.push({ name:pname,
          api_base_url: base + (anth?"/anthropic/v1/messages":"/v1/chat/completions"),
          api_key: kv, models:[m], transformer:{ use:[anth?"Anthropic":"OpenAI"] } });
        added++;
      }
    }
    const tmp=process.env.CCR_CFG+".tmp";
    fs.writeFileSync(tmp, JSON.stringify(cfg,null,2)); fs.renameSync(tmp, process.env.CCR_CFG);
    process.stderr.write("added "+added+(skipped.length?("; 跳过: "+skipped.join(", ")):"")+"\n");
    process.stdout.write(String(added));
  ') || { echo "写入失败;已从 $sm_bak 恢复"; cp "$sm_bak" "$ccrcfg"; return 1; }
  echo "== sync-models: 给 key '$sm_key' 加了 $sm_added 个 provider/model (备份: $sm_bak) =="
  # 6) 有变更才重启 CCR
  if [ "${sm_added:-0}" -gt 0 ] 2>/dev/null; then
    ccr_restart
    echo "  已重启 CCR — 新模型生效(crew models $sm_key 查看)"
  fi
}

cmd_keys() {
  local kf="$CREW_HOME/keys.conf"
  echo "== keys =="
  [ -f "$kf" ] || { echo "  (无 keys.conf)"; return 0; }
  awk -F= '
    /^[[:space:]]*#/ {next} /=/ {
      a=$1; gsub(/^[[:space:]]+|[[:space:]]+$/,"",a); if(a=="") next;
      v=substr($0, index($0,"=")+1); gsub(/^[[:space:]]+|[[:space:]]+$/,"",v);
      m = (length(v)>10) ? substr(v,1,4) "…" substr(v,length(v)-2) : "****";
      printf "  %-14s %s\n", a, m;
    }' "$kf"
}

# crew addkey <key> [别名] —— 简化加 key:写进 keys.conf。别名不给则从 key 派生。
# 只做"写别名=key",不拉 /v1/models、不建 backend(那是 v1 add-key 的重活;此处按用户要的极简)。
cmd_addkey() {
  local key="$1" alias="${2:-}"
  [ -z "$key" ] && die "usage: crew addkey <key> [别名]"
  # 别名默认:key- + key 的 sha256 前 6(稳定、不含明文)
  if [ -z "$alias" ]; then
    local h
    h=$(printf '%s' "$key" | { command -v sha256sum >/dev/null 2>&1 && sha256sum || shasum -a 256; } | cut -c1-6)
    alias="key-$h"
  fi
  # 别名校验(与 crew-session 名规则一致:字母数字._-)
  case "$alias" in *[!A-Za-z0-9._-]*) die "别名 '$alias' 含非法字符(仅允许 A-Za-z0-9._-)";; esac
  local kf="$CREW_HOME/keys.conf"
  mkdir -p "$CREW_HOME"
  [ -f "$kf" ] || : > "$kf"
  # 已存在同别名?覆盖其行(保留其余),否则追加。
  if grep -qE "^[[:space:]]*$alias[[:space:]]*=" "$kf" 2>/dev/null; then
    awk -v a="$alias" -v k="$key" '
      { line=$0; t=$0; sub(/^[[:space:]]+/,"",t);
        if (index(t, a "=")==1 || index(t, a " =")==1) { print a "=" k } else { print line } }
    ' "$kf" > "$kf.tmp" && mv "$kf.tmp" "$kf"
    log "更新 key 别名 '$alias'(覆盖旧值)"
  else
    printf '%s=%s\n' "$alias" "$key" >> "$kf"
    log "加了 key 别名 '$alias'"
  fi
  chmod 600 "$kf" 2>/dev/null || true
  echo "现有 key 别名:"; cmd_keys | grep -v '== keys =='
}

cmd_install_hooks() {
  # crew install-hooks [--force]  把仓 hooks/ 装到当前 git 仓的 .git/hooks/
  # 已存在同名 hook 不覆盖(除非 --force)。装完后每次 commit 自动跑 post-commit hook
  # 读 commit message 的 Notify-Session trailer / [TO:xxx] 头,自动 crew notify 相关会话。
  local force=0
  [ "${1:-}" = "--force" ] && force=1
  local src_dir="$SCRIPT_DIR/../hooks"
  [ -d "$src_dir" ] || die "hooks 目录不存在: $src_dir"
  # 当前 git 仓位置(cwd 或 crew 仓)
  local repo_root
  repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || die "当前不在 git 仓里,请 cd 到仓根后跑"
  local dst_dir="$repo_root/.git/hooks"
  mkdir -p "$dst_dir"
  local installed=0 skipped=0
  for src in "$src_dir"/*; do
    [ -f "$src" ] || continue
    local name; name=$(basename "$src")
    local dst="$dst_dir/$name"
    if [ -f "$dst" ] && [ "$force" != 1 ]; then
      # 已存在:比较内容是否一致
      if cmp -s "$src" "$dst"; then
        log "$name 已装(内容一致)"; skipped=$((skipped+1))
      else
        log "$name 已存在但内容不同(未覆盖;要覆盖加 --force)"; skipped=$((skipped+1))
      fi
      continue
    fi
    cp "$src" "$dst" && chmod +x "$dst" && { log "装 $name → $dst"; installed=$((installed+1)); }
  done
  log "install-hooks: 装了 $installed 个,跳过 $skipped 个(仓根: $repo_root)"
}

cmd_doctor() {
  local fix=0
  [ "${1:-}" = "--fix" ] && fix=1
  echo "== doctor =="
  echo "CREW_STATE: $CREW_STATE $([ -d "$CREW_STATE" ] && echo ✓ || echo ✗)"
  echo "CREW_HOME:  $CREW_HOME $([ -d "$CREW_HOME" ] && echo ✓ || echo ✗)"
  echo "CS bin:     $CS $([ -x "$CS" ] && echo ✓ || echo ✗)"
  echo "CT bin:     $CT $([ -x "$CT" ] && echo ✓ || echo ✗)"
  echo "CL bin:     $CL $([ -x "$CL" ] && echo ✓ || echo ✗)"
  echo "tmux:       $(command -v tmux || echo '(not found)')"
  echo "sessions:   $("$CS" list 2>/dev/null | wc -l)"

  # 2026-08-30 audit-crew A5(P0):registry 脏行自愈
  # 脏行 = registry 里有 <cwd,name> 但 state 目录里无任何 <name>.<field> 文件
  # (crew clean 已删 state 但 registry 行残留;或试错留下的 owkr 等孤儿名)
  local reg="$CREW_STATE/registry"
  if [ -f "$reg" ]; then
    echo "== registry =="
    local dirty_lines=""
    while IFS=$'\t' read -r cwd name; do
      [ -z "$name" ] && continue
      # state 有任何 <name>.<field> 文件就算干净
      local has_state
      has_state=$(find "$CREW_STATE" -maxdepth 1 -name "$name.*" -not -name "*.pending" -not -name "*.tmp*" 2>/dev/null | head -1)
      if [ -z "$has_state" ]; then
        dirty_lines="$dirty_lines$cwd	$name"$'\n'
        echo "  ✗ 脏行 '$name' @ '$cwd'(state 无 $name.* 文件)"
      fi
    done < "$reg"
    if [ -n "$dirty_lines" ]; then
      if [ "$fix" = "1" ]; then
        # 用 awk 过滤保留干净行
        local tmp
        tmp=$(mktemp)
        while IFS=$'\t' read -r cwd name; do
          [ -z "$name" ] && continue
          local has_state
          has_state=$(find "$CREW_STATE" -maxdepth 1 -name "$name.*" -not -name "*.pending" -not -name "*.tmp*" 2>/dev/null | head -1)
          [ -n "$has_state" ] && printf '%s\t%s\n' "$cwd" "$name" >> "$tmp"
        done < "$reg"
        mv "$tmp" "$reg"
        echo "  ✓ --fix:已删脏行"
      else
        echo "  (跑 'crew doctor --fix' 清除脏行)"
      fi
    else
      echo "  ✓ registry 干净"
    fi
  fi
}

cmd_version() {
  local commit
  commit=$(cd "$SCRIPT_DIR/.." && git rev-parse --short HEAD 2>/dev/null || echo "unknown")
  echo "crew v2.5.0 (refactor: 3 独立工具 + 顶层 CLI 兼容层;commit $commit)"
}

# 会话最近活跃时间(epoch):transcript .jsonl mtime + state 文件 mtime 取 max。0=无从判定。
# _mtime 跨平台:Linux `stat -c %Y`,macOS/BSD `stat -f %m`。注意 Linux 上 `stat -f` 是"文件系统
# 信息"(不报错但输出多行文本!),故必须先试 -c、再试 -f,且校验结果是纯数字(不是就当 0)。
_mtime() {
  local m
  m=$(stat -c %Y "$1" 2>/dev/null) || m=""
  case "$m" in ''|*[!0-9]*) m=$(stat -f %m "$1" 2>/dev/null) || m="";; esac
  case "$m" in ''|*[!0-9]*) m=0;; esac
  echo "$m"
}
session_activity() {
  local nm="$1" last=0 s m f
  s=$("$CS" get "$nm" sid 2>/dev/null || echo "")
  if [ -n "$s" ]; then
    for f in "$HOME"/.claude/projects/*/"$s".jsonl; do
      [ -f "$f" ] || continue; m=$(_mtime "$f"); [ "$m" -gt "$last" ] 2>/dev/null && last=$m
    done
  fi
  for f in "$CREW_STATE/$nm.sid" "$CREW_STATE/$nm.backend" "$CREW_STATE/$nm.key"; do
    [ -f "$f" ] || continue; m=$(_mtime "$f"); [ "$m" -gt "$last" ] 2>/dev/null && last=$m
  done
  echo "$last"
}

# 自动清理陈旧会话(分级):transcript/state 最后活跃 > STATE_DAYS(默认7)天 → 删 crew 状态(留
# transcript,可 find/resume 找回);> PURGE_DAYS(默认30)天 → 连 transcript 一起删(彻底)。
# 铁律:live(tmux 在跑)/ pinned 会话【绝不删】。不碰 send/inbox/--model 等接口。
# crew <name> [--days N] [--purge-days M] [--dry-run]
cmd_prune() {
  local p_days="${CREW_PRUNE_DAYS:-7}" p_purge_days="${CREW_PURGE_DAYS:-30}" p_dry=0
  while [ $# -gt 0 ]; do case "$1" in
    --days) p_days="$2"; shift 2;;
    --days=*) p_days="${1#*=}"; shift;;
    --purge-days) p_purge_days="$2"; shift 2;;
    --purge-days=*) p_purge_days="${1#*=}"; shift;;
    --dry-run|-n) p_dry=1; shift;;
    *) shift;;
  esac; done
  local now; now=$(date +%s 2>/dev/null || echo 0); [ "$now" = 0 ] && return 0
  local cut_state=$(( now - p_days*86400 )) cut_purge=$(( now - p_purge_days*86400 ))
  local live_sessions; live_sessions=$("$CT" list 2>/dev/null || echo "")
  local reaped=0 purged=0 kept=0 nm
  # 每个会话打一行明细:空闲天数 + 动作/保留原因,一眼看清"为什么没删"。
  printf '  %-20s %-10s %s\n' "会话" "空闲" "结果" >&2
  while IFS= read -r nm; do
    [ -n "$nm" ] || continue
    # live?(tmux 在跑)→ keep
    local tn=""
    if [ -f "$CREW_STATE/$nm.tmux" ]; then tn=$(cat "$CREW_STATE/$nm.tmux" 2>/dev/null)
    elif [ -f "$CREW_STATE/$nm.tmuxname" ]; then tn=$(cat "$CREW_STATE/$nm.tmuxname" 2>/dev/null)
    elif echo "$live_sessions" | grep -qFx "$nm"; then tn="$nm"
    elif echo "$live_sessions" | grep -qFx "crew-$nm"; then tn="crew-$nm"
    fi
    local last age_d age_s
    last=$(session_activity "$nm"); case "$last" in ''|*[!0-9]*) last=0;; esac
    if [ "$last" = 0 ]; then age_s="?"; else age_d=$(( (now-last)/86400 )); age_s="${age_d}d"; fi
    # live → keep
    if [ -n "$tn" ] && echo "$live_sessions" | grep -qFx "$tn"; then
      printf '  %-20s %-10s %s\n' "$nm" "$age_s" "保留(live)"; kept=$((kept+1)); continue
    fi
    # pinned → keep(常驻会话如 work)
    if "$CS" has "$nm" pintmux 2>/dev/null; then
      printf '  %-20s %-10s %s\n' "$nm" "$age_s" "保留(pinned)"; kept=$((kept+1)); continue
    fi
    # 判不出活跃时间 → 保守 keep
    [ "$last" = 0 ] && { printf '  %-20s %-10s %s\n' "$nm" "$age_s" "保留(无活跃时间)"; kept=$((kept+1)); continue; }
    if [ "$last" -lt "$cut_purge" ]; then
      # > purge_days:连 transcript 删
      if [ "$p_dry" = 1 ]; then printf '  %-20s %-10s %s\n' "$nm" "$age_s" "将连历史删(>${p_purge_days}d)"; purged=$((purged+1)); continue; fi
      "$CT" kill "$nm" 2>/dev/null || true
      "$CS" clean "$nm" --purge-transcript >/dev/null 2>&1 || true
      printf '  %-20s %-10s %s\n' "$nm" "$age_s" "已连历史删"; purged=$((purged+1))
    elif [ "$last" -lt "$cut_state" ]; then
      # state_days~purge_days:只删状态,留 transcript
      if [ "$p_dry" = 1 ]; then printf '  %-20s %-10s %s\n' "$nm" "$age_s" "将删状态(>${p_days}d,留历史)"; reaped=$((reaped+1)); continue; fi
      "$CT" kill "$nm" 2>/dev/null || true
      "$CS" clean "$nm" >/dev/null 2>&1 || true
      printf '  %-20s %-10s %s\n' "$nm" "$age_s" "已删状态(留历史)"; reaped=$((reaped+1))
    else
      printf '  %-20s %-10s %s\n' "$nm" "$age_s" "保留(未超 ${p_days}d)"; kept=$((kept+1))
    fi
  done < <("$CS" list 2>/dev/null | cut -f1 | sort -u)
  echo "== prune: 删状态 $reaped, 连历史删 $purged, 保留 $kept (状态>${p_days}d, 历史>${p_purge_days}d$( [ "$p_dry" = 1 ] && printf ', dry-run'))"
}

# 机会式节流自动清理:每 CREW_PRUNE_EVERY 秒(默认1天)最多一次,后台静默跑 prune。搭 spawn/ls 触发,
# 无需 cron。CREW_PRUNE_AUTO=0 关闭。绝不 delay 前台操作(后台 &)。
crew_autoprune() {
  [ "${CREW_PRUNE_AUTO:-1}" = 1 ] || return 0
  local every="${CREW_PRUNE_EVERY:-86400}" stamp="$CREW_STATE/.last-prune" last now
  last=$(cat "$stamp" 2>/dev/null || echo 0); case "$last" in ''|*[!0-9]*) last=0;; esac
  now=$(date +%s 2>/dev/null || echo 0); [ "$now" = 0 ] && return 0
  [ $((now - last)) -ge "$every" ] || return 0
  printf '%s' "$now" > "$stamp" 2>/dev/null || true
  ( "$SCRIPT_DIR/crew" prune >/dev/null 2>&1 & ) 2>/dev/null || true
}

# crew switch <会话> —— 交互切 key→model(都默认当前值),选完走 live 换模型路径重启。
# 顺序:先选 key(默认会话现 key),再选 model(默认会话现 model)。等价 `crew <会话> --key K --model M`,
# 但交互、免背参数。非交互(无 tty)报错提示用带参形式。
# crew resume-prev <会话> —— 把 sid 换回上次被 --fresh 覆盖前归档的 prev_sid,找回老历史。
# 场景:误 --fresh 后想恢复之前的对话(老历史 jsonl 还在,只是 state.sid 指向了新空会话)。
cmd_resume_prev() {
  local name="$1"
  [ -z "$name" ] && die "usage: crew resume-prev <会话>"
  local prev; prev=$("$CS" get "$name" prev_sid 2>/dev/null || echo "")
  [ -z "$prev" ] && die "'$name' 没有 prev_sid(没被 --fresh 覆盖过,或已找回)"
  local cur; cur=$("$CS" get "$name" sid 2>/dev/null || echo "")
  # 交换:当前 sid 存回 prev_sid(可再换回),prev 设为当前 sid
  "$CS" set "$name" sid "$prev" >/dev/null
  [ -n "$cur" ] && "$CS" set "$name" prev_sid "$cur" >/dev/null
  log "'$name' sid 换回 prev_sid=$prev(原 sid $cur 存进 prev_sid,可再 resume-prev 换回)。crew $name 重起即 resume 老历史"
}

cmd_switch() {
  local name="$1"
  [ -z "$name" ] && die "usage: crew switch <会话>"
  [ -t 0 ] || die "crew switch 需交互终端;非交互请用: crew $name --key <K> --model <M>"
  local cur_key cur_be picked_key picked_be
  cur_key=$("$CS" get "$name" key 2>/dev/null || echo "")
  cur_be=$("$CS" get "$name" backend 2>/dev/null || echo "")
  picked_key=$(_list_keys | _pick_one "选 key ($name,当前: ${cur_key:-无})" "$cur_key")
  # model 菜单:列【该 key 支持的模型】(ccr_models_for_key_full,provider,model 全名,直接可用)。
  # 拿不到(该 key 无 CCR provider)→ 提示补 key,不再暴露 backend 文件名。
  local model_opts
  model_opts=$(ccr_models_for_key_full "$picked_key")
  [ -z "$model_opts" ] && { log "key '$picked_key' 没有可路由模型(crew sync-models --key $picked_key 补充);保持原模型"; picked_be="$cur_be"; }
  [ -n "$model_opts" ] && picked_be=$(printf '%s\n' "$model_opts" | _pick_one "选模型 ($name,当前: ${cur_be:-无})" "$cur_be")
  # 设全局 BACKEND/KEY,走 cmd_spawn 的 live 换模型逻辑(它会判与现值不同才重启)
  [ -n "$picked_key" ] && KEY="$picked_key"
  [ -n "$picked_be" ] && BACKEND="$picked_be"
  if [ "$BACKEND" = "$cur_be" ] && [ "$KEY" = "$cur_key" ]; then
    log "'$name' key/model 未变(key=$KEY model=$BACKEND),不重启"
    return 0
  fi
  log "switch '$name' → key=$KEY model=$BACKEND"
  cmd_spawn "$name"
}

# crew find <描述...> —— 快搜已有 crew 会话历史,返回 Top5 候选(会话名+概要+打开命令)。
# 重点是快:每会话只 tail transcript 最近片段(不读大 .jsonl 全文)grep 粗筛;按命中数+最近活跃
# 排序;概要取首个命中行的 user 文本(疑似密钥脱敏)。纯 grep 路径,零模型依赖。
# CREW_FIND_TAIL(默认 200000 字节)控制每会话读多少最近内容。
cmd_find() {
  [ $# -eq 0 ] && die "usage: crew find <描述...>"
  local q="$*" tailb="${CREW_FIND_TAIL:-200000}"
  local live_sessions; live_sessions=$("$CT" list 2>/dev/null || echo "")
  # 收集 name→sid→transcript,grep 粗筛计分。结果行:"命中数<TAB>mtime<TAB>name<TAB>transcript"
  local scored="" name sid j hits mt words w
  # 拆词(空格分),任一命中计一分
  while IFS= read -r name; do
    [ -n "$name" ] || continue
    sid=$("$CS" get "$name" sid 2>/dev/null || echo "")
    [ -z "$sid" ] && continue
    j=""
    for f in "$HOME"/.claude/projects/*/"$sid".jsonl; do [ -f "$f" ] && { j="$f"; break; }; done
    [ -z "$j" ] && continue
    # 只读最近 tailb 字节(快)。多词累计命中(每词 grep -ic 计数)。
    local recent; recent=$(tail -c "$tailb" "$j" 2>/dev/null)
    hits=0
    for w in $q; do
      local c; c=$(printf '%s' "$recent" | grep -ic -- "$w" 2>/dev/null)
      case "$c" in ''|*[!0-9]*) c=0;; esac
      hits=$((hits + c))
    done
    [ "$hits" -eq 0 ] && continue
    mt=$(_mtime "$j")
    scored+="$hits"$'\t'"$mt"$'\t'"$name"$'\t'"$j"$'\n'
  done < <("$CS" list 2>/dev/null | cut -f1 | sort -u)

  if [ -z "$scored" ]; then
    echo "没找到匹配 '$q' 的会话。换个关键词?(find 只搜每个会话最近的对话片段)"
    return 0
  fi

  # 排序:命中数降序,再 mtime 降序;取 Top5
  local top; top=$(printf '%s' "$scored" | sort -t$'\t' -k1,1nr -k2,2nr | head -5)

  # 输出候选块
  local rank=0 c_dim=$'\033[2m' c_reset=$'\033[0m' c_name=$'\033[36m' c_cmd=$'\033[2m'
  while IFS=$'\t' read -r hits mt name j; do
    [ -n "$name" ] || continue
    rank=$((rank+1))
    # 状态/model/cwd
    local st="resumable" tn=""
    if [ -f "$CREW_STATE/$name.tmux" ]; then tn=$(cat "$CREW_STATE/$name.tmux" 2>/dev/null)
    elif [ -f "$CREW_STATE/$name.tmuxname" ]; then tn=$(cat "$CREW_STATE/$name.tmuxname" 2>/dev/null)
    elif echo "$live_sessions" | grep -qFx "$name"; then tn="$name"
    elif echo "$live_sessions" | grep -qFx "crew-$name"; then tn="crew-$name"; fi
    echo "$live_sessions" | grep -qFx "$tn" && st="live"
    local be; be=$("$CS" get "$name" backend 2>/dev/null || echo "?")
    local cwd; cwd=$(awk -F'\t' -v n="$name" '$2==n{print $1; exit}' "$CREW_STATE/registry" 2>/dev/null)
    local cwdb; cwdb=$(basename "${cwd:-?}")
    # 概要:node 直接读 transcript 末尾片段(不用 stdin 管道 —— 在 `while <<<` 循环里 node 会
    # 继承循环的 here-string stdin,读不到管道数据,故传文件路径让 node 自己 fs 读末尾 tailb 字节)。
    # 抠首个含【任一】查询词的文本(与计分一致,不只首词);疑似密钥脱敏;失败回落。
    local gist
    gist=$(node -e '
      var fs=require("fs"), file=process.argv[1], tailb=+process.argv[2]||200000;
      var words=process.argv.slice(3).map(function(w){return w.toLowerCase()});
      var buf="";
      try{ var fd=fs.openSync(file,"r"), sz=fs.fstatSync(fd).size, start=Math.max(0,sz-tailb), len=sz-start;
           var b=Buffer.alloc(len); fs.readSync(fd,b,0,len,start); fs.closeSync(fd); buf=b.toString("utf8"); }catch(e){}
      var lines=buf.split("\n"), found="";
      for(var i=0;i<lines.length && !found;i++){
        try{var m=JSON.parse(lines[i]); var c=m.message&&m.message.content;
          var t = typeof c==="string" ? c : (Array.isArray(c)? c.map(function(bl){return bl&&bl.text||""}).join(" ") : "");
          if(!t) continue; var lt=t.toLowerCase();
          for(var k=0;k<words.length;k++){ if(words[k] && lt.indexOf(words[k])>=0){ found=t.replace(/\s+/g," ").trim().slice(0,120); break; } }
        }catch(e){}
      }
      if(found) process.stdout.write(found);
    ' "$j" "$tailb" $q 2>/dev/null)
    # 脱敏:疑似 token(sk-/长 hex/长 base64)打码
    gist=$(printf '%s' "$gist" | sed -E 's/(sk-[A-Za-z0-9_-]{6})[A-Za-z0-9_-]+/\1…/g; s/[A-Za-z0-9]{32,}/<REDACTED>/g')
    if [ -z "$gist" ]; then
      # content 里没抠到(命中可能在工具输出/路径等非对话文本)→ 回落:抽首个命中词所在原始行的
      # 可读片段(去 JSON 转义噪音,截断),让用户仍能看到匹配上下文。
      local w1b; w1b=$(printf '%s' "$q" | awk '{print $1}')
      gist=$(tail -c "$tailb" "$j" 2>/dev/null | grep -i -m1 -- "$w1b" 2>/dev/null \
        | sed -E 's/\\[a-z]//g; s/[{}"]//g; s/\s+/ /g' | cut -c1-110)
      [ -n "$gist" ] && gist="~ $gist"
    fi
    [ -z "$gist" ] && gist="(命中 $hits 处)"
    printf '%s#%d%s  %s%s%s  %s(%s · %s · %s)%s\n' "$c_dim" "$rank" "$c_reset" "$c_name" "$name" "$c_reset" "$c_dim" "$st" "$be" "$cwdb" "$c_reset"
    printf '    概要: %s\n' "$gist"
    printf '    打开: %screw %s%s\n\n' "$c_cmd" "$name" "$c_reset"
  done <<< "$top"
}

# 2026-08-31:解析会话真实工作目录。优先级(对齐 v1 path_for_name + $PWD 回落):
#   显式 --dir($DIR 非空) > registry 里 <cwd>\t<name> 按 name 反查 > state.dir > $PWD。
# 换模型/重启 live 会话时不应丢工作目录 —— 会话早在 registry(首次 spawn 时写入),从那反查
# 回它原来的目录;claude 的 --resume 也依赖在正确 cwd 起(否则按错 project 目录找历史崩)。
# --- 交互选择器(移植自 v1 --pick)------------------------------------------
# _pick_one <title> <default>:选项从 stdin(每行一个),选中值到 stdout。fzf 优先,否则编号菜单
# (接受编号、选项原文、唯一前缀;Enter 保持默认)。所有提示走 stderr,只有选中值进 stdout。
_pick_one() {
  local title="$1" def="$2" chosen=""
  local opts=() line
  while IFS= read -r line; do [ -n "$line" ] && opts+=("$line"); done
  [ "${#opts[@]}" -eq 0 ] && { printf '%s' "$def"; return; }
  if command -v fzf >/dev/null 2>&1; then
    local ordered; ordered=$( { [ -n "$def" ] && printf '%s\n' "$def"; local o; for o in "${opts[@]}"; do [ "$o" = "$def" ] || printf '%s\n' "$o"; done; } )
    chosen=$(printf '%s\n' "$ordered" | fzf --height=40% --reverse --prompt="$title > " \
            --header="Enter=选中  Esc=保持默认 [$def]" 2>/dev/tty) || chosen=""
  else
    local i
    printf '\n== %s ==  (输编号,或 Enter 保持默认: %s)\n' "$title" "$def" >&2
    i=1; for line in "${opts[@]}"; do printf '  %2d) %s%s\n' "$i" "$line" "$([ "$line" = "$def" ] && printf '  (默认)')" >&2; i=$((i+1)); done
    local reply; printf '  选 > ' >&2; read -r reply </dev/tty
    if [ -z "$reply" ]; then chosen="$def"
    elif [ "$reply" -ge 1 ] 2>/dev/null && [ "$reply" -le "${#opts[@]}" ] 2>/dev/null; then chosen="${opts[$((reply-1))]}"
    else
      local o m="" hits=0 h="" rl; rl=$(printf '%s' "$reply" | tr 'A-Z' 'a-z')
      for o in "${opts[@]}"; do [ "$o" = "$reply" ] && { m="$o"; break; }; done
      if [ -z "$m" ]; then
        for o in "${opts[@]}"; do case "$(printf '%s' "$o" | tr 'A-Z' 'a-z')" in "$rl"*) hits=$((hits+1)); h="$o";; esac; done
        [ "$hits" = 1 ] && m="$h"
      fi
      if [ -n "$m" ]; then chosen="$m"; else printf '  无匹配 "%s" — 保持默认: %s\n' "$reply" "$def" >&2; chosen="$def"; fi
    fi
  fi
  [ -z "$chosen" ] && chosen="$def"
  printf '%s' "$chosen"
}
# backend 名列表(backends/*.conf 去 .conf),每行一个
_list_backends() {
  local f
  for f in "$CREW_HOME"/backends/*.conf; do
    [ -f "$f" ] || continue
    basename "$f" .conf
  done | sort -u
}
# key 别名列表(keys.conf 的 alias=... 左侧),每行一个
_list_keys() {
  [ -f "$CREW_HOME/keys.conf" ] || return 0
  awk -F= '/^[[:space:]]*#/{next} /=/{gsub(/^[[:space:]]+|[[:space:]]+$/,"",$1); if($1)print $1}' "$CREW_HOME/keys.conf" | sort -u
}

# _trust_dir <dir>:给该目录在 ~/.claude.json 预写 hasTrustDialogAccepted=true,让 claude 起会话
# 时不弹"Quick safety check: trust this folder?"确认页(--dangerously-skip-permissions 不跳它,
# detached tmux 里没人回车会卡住 → 空壳循环。本地新目录起会话必踩)。幂等,原子写,只改该 dir 条目。
_trust_dir() {
  local dir="$1"
  [ -n "$dir" ] || return 0
  [ "$dir" = "-" ] && return 0
  command -v node >/dev/null 2>&1 || return 0   # 无 node:降级,用户手动确认一次
  DIR_TO_TRUST="$dir" node -e '
    const fs=require("fs"), os=require("os"), path=require("path");
    const f=path.join(os.homedir(),".claude.json");
    let c={};
    try { c=JSON.parse(fs.readFileSync(f,"utf8")); } catch(e) { c={}; }
    if(typeof c!=="object"||!c) c={};
    c.projects=c.projects||{};
    const d=process.env.DIR_TO_TRUST;
    const p=c.projects[d]||{};
    if(p.hasTrustDialogAccepted===true) process.exit(0);  // 幂等:已信任不写
    p.hasTrustDialogAccepted=true;
    c.projects[d]=p;
    const tmp=f+".crewtmp";
    fs.writeFileSync(tmp, JSON.stringify(c));
    fs.renameSync(tmp, f);
  ' 2>/dev/null || true
}

resolve_session_dir() {
  local name="$1" d=""
  if [ -n "$DIR" ]; then echo "$DIR"; return; fi
  local reg="$CREW_STATE/registry"
  if [ -f "$reg" ]; then
    d=$(awk -F'\t' -v n="$name" '$2==n{print $1; exit}' "$reg" 2>/dev/null)
  fi
  [ -z "$d" ] && d=$("$CS" get "$name" dir 2>/dev/null || echo "")
  [ -z "$d" ] && d="$PWD"
  echo "$d"
}

cmd_spawn() {
  local name="$1"; shift
  local task="$*"
  [ -z "$name" ] && die "no name"

  # 2026-09-01:--pick 强制交互选(换模型/新起入口)。顺序先 key 后模型(与 switch/新起一致):
  # 选 key(默认会话现值)→ 从该 key 支持的模型选(默认现值;拿不到回落全量 backend)。放在 attach
  # 判断【之前】跑,选完的 BACKEND/KEY 被下面 live 换模型逻辑识别。仅 --pick 触发,不误伤纯 attach。
  # 需交互终端;非交互即使传 --pick 也跳过。
  if [ "$PICK" = 1 ] && [ -t 0 ]; then
    local _def_key; _def_key=$("$CS" get "$name" key 2>/dev/null || echo "")
    local _picked_key; _picked_key=$(_list_keys | _pick_one "选 key ($name)" "$_def_key")
    [ -n "$_picked_key" ] && KEY="$_picked_key"
    local _def_be; _def_be=$("$CS" get "$name" backend 2>/dev/null || echo "")
    local _mo; [ -n "$KEY" ] && _mo=$(ccr_models_for_key_full "$KEY")
    if [ -z "$_mo" ]; then
      [ -n "$KEY" ] && log "key '$KEY' 没有可路由模型(crew sync-models --key $KEY 补充);可 --model 直接指定"
    else
      local _picked_be; _picked_be=$(printf '%s\n' "$_mo" | _pick_one "选模型 ($name${KEY:+, key=$KEY})" "$_def_be")
      [ -n "$_picked_be" ] && BACKEND="$_picked_be"
    fi
  fi

  # 2026-08-30 audit-crew A5(P0):registry 写方收口 —— spawn 起会话时把 <cwd,name>
  # 落 registry(v2 之前只 clean 删行、从不写入,导致 agent-bridge crew-session-sync 侧
  # 长期看不见 v2 会话,DIR 兜底靠 /proc)。
  # 2026-08-31:解析真实工作目录(显式--dir > registry反查 > state.dir > $PWD),供 registry
  # 写入与传给 launcher 共用。显式 --dir 且与 registry 现值不同时,更新该行(原逻辑只首次写,
  # 导致换模型重启时 --dir 被忽略、会话掉回 /work)。
  local reg="$CREW_STATE/registry"
  mkdir -p "$CREW_STATE"
  local session_dir; session_dir=$(resolve_session_dir "$name")
  if ! [ -f "$reg" ] || ! awk -F'\t' -v m="$name" '$2==m{ok=1}END{exit !ok}' "$reg" 2>/dev/null; then
    printf '%s\t%s\n' "$session_dir" "$name" >> "$reg"
  elif [ -n "$DIR" ]; then
    # 显式 --dir:若 registry 里该 name 的 cwd 与之不同,重写该行
    local cur_reg_dir
    cur_reg_dir=$(awk -F'\t' -v n="$name" '$2==n{print $1; exit}' "$reg" 2>/dev/null)
    if [ "$cur_reg_dir" != "$DIR" ]; then
      awk -F'\t' -v n="$name" -v d="$DIR" 'BEGIN{OFS="\t"} $2==n{$1=d} {print}' "$reg" > "$reg.tmp" 2>/dev/null \
        && mv "$reg.tmp" "$reg"
    fi
  fi

  # 2026-08-30 修:v1 语义——crew <name> 无 task 且 tmux 已 live 时,attach 而非新起
  # (踩坑:用户跑 crew work,v2 无脑 spawn 灌新 launcher → 新起 crew-work tmux,
  # 而真 work tmux 还活着,claude 被分叉;pinned adopt 会话尤其危险)
  # 有 --fresh / 有 task / --no-tmux 时不走 attach,按用户显式意图 spawn
  if [ -z "$task" ] && [ "$FRESH" = 0 ] && [ "$NO_TMUX" = 0 ]; then
    local existing
    existing=$("$CT" resolve "$name" 2>/dev/null || true)
    if [ -n "$existing" ] && "$CT" list 2>/dev/null | grep -qFx "$existing"; then
      # 2026-09-01:空壳检查 —— tmux 会话在,但 pane 里没有 claude 进程(claude 崩了/退了,只剩
      # tmux 壳)= 不算真 live。此时不该 attach 空壳(会 attach 到一个 bash shell,bootstrap 还会
      # 踩嵌套 attach rc=1),应 kill 空壳后往下 spawn 重起。复用 cmd_ls 的 pane_pid→claude_pid 查法。
      local _pane_pid _claude_pid=""
      _pane_pid=$(tmux list-panes -t "$existing" -F '#{pane_pid}' 2>/dev/null | head -1)
      if [ -n "$_pane_pid" ]; then
        _claude_pid=$(ps --no-headers -o pid,cmd --ppid "$_pane_pid" 2>/dev/null | awk '/bin\/claude/{print $1; exit}')
      fi
      if [ -z "$_claude_pid" ]; then
        log "'$name' 的 tmux ($existing) 是空壳(无 claude 进程)→ kill 后重起(--resume 保历史)"
        "$CT" kill "$name" 2>/dev/null || true
        # 不 exec attach,不进换模型块 —— 直接落下面 spawn 重起
      else
      # 真 live:补回 v1 的"live 会话就地换 model/key"语义(v2 重构时丢了)。
      # 显式传了 --model/--key 且与 state 现值不同 → 停旧的、写新值、往下 spawn(sid 在→launcher
      # 自动 --resume,历史保留)。没传(纯 crew <name>)→ 仍 attach,不动。
      local _cur_backend _cur_key _want_restart=0
      _cur_backend=$("$CS" get "$name" backend 2>/dev/null || echo "")
      _cur_key=$("$CS" get "$name" key 2>/dev/null || echo "")
      if [ -n "$BACKEND" ] && [ "$BACKEND" != "$_cur_backend" ]; then
        log "切换 '$name' 模型: ${_cur_backend:-<无>} -> $BACKEND(重启,--resume 保历史)"; _want_restart=1
      fi
      if [ -n "$KEY" ] && [ "$KEY" != "$_cur_key" ]; then
        log "切换 '$name' key: ${_cur_key:-<无>} -> $KEY(重启,--resume 保历史)"; _want_restart=1
      fi
      if [ "$_want_restart" = 1 ]; then
        "$CT" kill "$name" 2>/dev/null || true   # 停旧的;sid/state 保留,下面 spawn 会 --resume
      else
        log "'$name' 已 live (tmux=$existing) → attach(换模型/key 加 --model/--key;要新起加 --fresh 或 crew kill 后再来)"
        exec "$CT" attach "$name"
      fi
      fi
    fi
  fi

  # 2026-09-01:走到这 = 确定要 spawn。没传 --model 且会话没记忆过 backend、又是交互终端 →
  # 交互选(新起会话"没输入就交互")。顺序:先选 key,再从【该 key 支持的模型】选(与 switch 一致,
  # 列真实模型名如 GLM-5.3/Claude-Opus-4.7,而非 backend 文件名)。拿不到该 key 的模型才回落全量
  # backend 名。已有记忆 backend 的(重起旧会话)不打扰。非交互(脚本)不弹。
  if [ -z "$BACKEND" ] && [ -t 0 ] && ! "$CS" has "$name" backend 2>/dev/null; then
    # 1) 先选 key
    if [ -z "$KEY" ] && ! "$CS" has "$name" key 2>/dev/null; then
      local _pk; _pk=$(_list_keys | _pick_one "选 key ($name)" "")
      [ -n "$_pk" ] && KEY="$_pk"
    fi
    # 2) 再选该 key 支持的模型(provider,model 全名,可直接用);拿不到 → 提示补 key,不暴露文件名
    local _mopts=""
    [ -n "$KEY" ] && _mopts=$(ccr_models_for_key_full "$KEY")
    if [ -z "$_mopts" ]; then
      [ -n "$KEY" ] && log "key '$KEY' 没有可路由模型(crew sync-models --key $KEY 补充);可 --model 直接指定"
    else
      local _pm; _pm=$(printf '%s\n' "$_mopts" | _pick_one "选模型 ($name${KEY:+, key=$KEY})" "")
      [ -n "$_pm" ] && BACKEND="$_pm"
    fi
  fi

  [ -n "$BACKEND" ] && "$CS" set "$name" backend "$BACKEND"
  [ -n "$KEY" ] && "$CS" set "$name" key "$KEY"
  # --policy X:设 per-session policy 文件(v2 修② 2026-08-30)
  if [ -n "$POLICY" ]; then
    if [ "$POLICY" = "-" ]; then
      "$CS" del "$name" policy
      log "AGENT_POLICY session pin cleared for '$name'"
    else
      "$CS" set "$name" policy "$POLICY"
      log "AGENT_POLICY pinned for '$name' -> $POLICY"
    fi
  fi

  # 2026-08-31 audit-crew P2-b:mode 决策(五概念解耦)
  #   --use-current-tmux 最高优先(用户显式意图 = 已在 tmux pane 里,别再 new-session)
  #   --no-tmux 次之:pinned 时忽略(pinned 语义 = "always on tmux"),否则 fg
  #   默认 tmux(new-session)
  local mode="tmux"
  if [ "$USE_CUR_TMUX" = 1 ]; then
    mode="use-current-tmux"
    log "'$name' 使用当前 tmux pane 起 claude(不 new-session,pinned 状态不动)"
  elif [ "$NO_TMUX" = 1 ]; then
    if "$CS" has "$name" pintmux 2>/dev/null; then
      log "'$name' is pinned to tmux (always-on); ignoring --no-tmux."
    else
      mode="fg"
    fi
  fi

  local -a extra_args=()
  [ "$FRESH" = 1 ] && extra_args+=(--fresh)
  [ -n "$task" ] && extra_args+=(--task "$task")

  # 2026-09-02:起会话前预信任 cwd,免 claude 弹 trust dialog 卡住(detached tmux 无人回车→空壳循环)
  _trust_dir "$session_dir"

  "$CL" spawn --name "$name" --mode "$mode" --dir "$session_dir" "${extra_args[@]}"
}

# 2026-09-01:机会式自动清理陈旧会话(节流每天一次,后台跑)。排除 prune 自身避免递归;
# 排除纯读命令无妨(它也只是后台触发一次)。live/pinned 绝不删,见 cmd_prune。
case "$CMD" in prune) : ;; *) crew_autoprune ;; esac

case "$CMD" in
  ls|list)      cmd_ls "$@" ;;
  menu)         cmd_menu ;;
  attach)       cmd_attach "$@" ;;
  stop)         cmd_stop "$@" ;;
  kill)         cmd_kill "$@" ;;
  pin)          cmd_pin "$@" ;;
  unpin)        cmd_unpin "$@" ;;
  adopt)        cmd_adopt "$@" ;;
  register)     cmd_register "$@" ;;
  wake)         cmd_wake "$@" ;;
  send)         cmd_send "$@" ;;
  notify)       cmd_notify "$@" ;;
  status)       cmd_status "$@" ;;
  heartbeat)    cmd_heartbeat "$@" ;;
  web)          cmd_web "$@" ;;
  inbox)        cmd_inbox "$@" ;;
  log)          cmd_log "$@" ;;
  models)       cmd_models "$@" ;;
  backends)     cmd_backends ;;
  keys)         cmd_keys ;;
  addkey|add-key) cmd_addkey "$@" ;;
  sync-models|syncmodels) cmd_sync_models "$@" ;;
  doctor)       cmd_doctor "$@" ;;
  install-hooks) cmd_install_hooks "$@" ;;
  version)      cmd_version "$@" ;;
  switch)       cmd_switch "$@" ;;
  resume-prev)  cmd_resume_prev "$@" ;;
  find)         cmd_find "$@" ;;
  prune)        cmd_prune "$@" ;;
  help|--help|-h) sed -n '9,42p' "$0" | sed 's/^# \{0,1\}//' ;;
  *)            cmd_spawn "$CMD" "$@" ;;
esac
