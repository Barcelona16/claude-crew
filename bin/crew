#!/usr/bin/env bash
# crew — 顶层 CLI,兼容旧 API 21 命令(2026-08-30 crew L 重构 Week 3)
#
# 分发到三个独立工具:
#   crew-session   状态管理
#   crew-tmux      tmux 集成
#   crew-launcher  claude 启动
#
# 命令:
#   crew <name> [task]       起会话(默认 tmux 模式,已存在则 attach)
#   crew ls [--json]         列会话
#   crew attach <name>       attach tmux
#   crew stop <name>         停 tmux 保状态(B2 防自杀:CREW_STOP_ALLOW_SELF_KILL=1 绕过)
#   crew kill <name> [--purge]  删会话
#   crew pin/unpin <name>    pin/unpin tmux
#   crew adopt <name> <tmux> [--sid X] [--dir P] [--model M]
#   crew send <name> "msg" [--no-wake]  发消息到会话 inbox + 默认唤醒(--no-wake 只落信封)
#   crew notify <name> "msg" 发消息并唤醒(send+wake 合一,确保会话看到)
#   crew wake <name>         唤醒会话(paneIdle 判据 + 双 Enter + pending 队列)
#   crew inbox <name> [--peek]  读 inbox(带时间戳,消费后归档)
#   crew status <name>       会话健康摘要(心跳/inbox/pending)
#   crew register            会话注册(读 cwd 判归属,原子写 project.json sessions[])
#   crew heartbeat           60s 采样守护(单例,抓 ctxPct 等)
#   crew web                 独立前端 :18060(会话卡片 + 收发 + 切模型 + attach)
#   crew log <name>          看 transcript
#   crew models              按 key 分组列每个 key 支持的真实模型
#   crew models <key>        列该 key 能路由的模型(从 CCR provider 反查;joycode 系含全部)
#   crew backends            列内部 backend conf 文件名(实现细节,选模型用 crew models)
#   crew sync-models [--key A] 手动批量同步上游模型(默认已在选模型菜单自动增量同步,此命令留作批量/兜底)
#   crew model-switch <模型> [key别名]  模型切换统一入口(校验→写map→apply→冒烟→失败自动回滚+根因)
#   crew keys                列 key 别名(值脱敏)
#   crew addkey <key> [别名] 加一把 key 到 keys.conf(别名不给则自动派生)
#   crew switch <会话>       交互切 key→model(都默认当前值,选完重启换)
#   crew resume-prev <会话>  找回上次被 --fresh 覆盖前的老历史(sid 换回归档的 prev_sid)
#   crew find <描述...>      搜已有会话历史,返回 Top5(会话名+概要+打开命令)
#   crew prune [--dry-run] [--days N] [--purge-days M]  清陈旧会话(默认>7d 删状态、>30d 连历史删;
#                            live/pinned 不删,平时自动跑;每会话打空闲天数+结果)
#   crew doctor              自检
#   crew version [--notes]  版本摘要 / 完整 release note(-n 看最近 3 版全文)
#
# 全局 flags:
#   --model M --key K --tmux --no-tmux --fresh --safe --pick --dir P
#   --pick  交互选 model+key(菜单);crew <会话> 不带 --model 新起时也会自动弹菜单选

set -uo pipefail

CREW_STATE="${CREW_STATE:-${XDG_DATA_HOME:-$HOME/.local/share}/claude-crew}"
CREW_HOME="${CREW_HOME:-$HOME/.config/claude-crew}"
# CCR 3 stores its live state in SQLite.  Keep crew's own provider map outside
# that database; setup/ccr_v3.py applies it through the authenticated CCR RPC.
CCR_PROVIDER_MAP="${CREW_CCR_CONFIG:-$CREW_HOME/ccr-providers.json}"
# SCRIPT_DIR = 真实 bin/ 目录。crew 常经软链调用(~/.local/bin/crew -> <clone>/bin/crew),
# 需先解析软链链,否则 SCRIPT_DIR 会误指 ~/.local/bin(那里没有 crew-* 兄弟工具)→ exit 127。
# 用手动 while 循环而非 `readlink -f`:macOS 自带 readlink 不支持 -f(会返回空),while 版 mac+Linux 通用。
_crew_self="${BASH_SOURCE[0]:-$0}"
while [ -L "$_crew_self" ]; do
  _crew_link="$(readlink "$_crew_self")"
  case "$_crew_link" in /*) _crew_self="$_crew_link";; *) _crew_self="$(dirname "$_crew_self")/$_crew_link";; esac
done
SCRIPT_DIR="$(cd "$(dirname "$_crew_self")" && pwd)"
CS="$SCRIPT_DIR/crew-session"
CT="$SCRIPT_DIR/crew-tmux"
CL="$SCRIPT_DIR/crew-launcher"
CR="$SCRIPT_DIR/crew-register.js"
CW="$SCRIPT_DIR/crew-wake.js"
CN="$SCRIPT_DIR/crew-notify.js"
CH="$SCRIPT_DIR/crew-heartbeat.js"
CST="$SCRIPT_DIR/crew-status.js"
CWEB="$SCRIPT_DIR/crew-web.js"

ACPD="${ACPD:-$SCRIPT_DIR/../acp/crew-acpd.mjs}"
DSHMJS="${DSHMJS:-$SCRIPT_DIR/../acp/crew-dsh.mjs}"
CREW_REMOTES_FILE="${CREW_REMOTES_FILE:-$CREW_HOME/remotes}"

# ── 拆出的职责单一 lib 模块(薄入口;函数定义全部在 crew.d/ 下,运行时解析)──
. "$SCRIPT_DIR/crew.d/common.sh"
. "$SCRIPT_DIR/crew.d/models.sh"
. "$SCRIPT_DIR/crew.d/session.sh"
. "$SCRIPT_DIR/crew.d/commands.sh"
. "$SCRIPT_DIR/crew.d/ops.sh"
. "$SCRIPT_DIR/crew.d/dsh.sh"

BACKEND=""
KEY=""
POLICY=""
NO_TMUX=0
FRESH=0
SAFE=0
USE_CUR_TMUX=0  # 2026-08-31 audit-crew P2-b:--use-current-tmux flag
PICK=0          # 2026-08-31:--pick 强制弹交互菜单(即使已传 --model/--key)
DIR=""          # 2026-08-31:默认空 = "未显式传 --dir"(区分于 "传了 = $PWD")。cmd_spawn
                # 里按 显式--dir > registry反查 > $PWD 解析真实工作目录。
# 2026-08-31:全程扫描 flags(与 v1 一致)——flag 可出现在会话名之后,如 `crew t1 --model X`。
# 非 flag(子命令/会话名/task)收进 POS,flag 在任意位置都被吃掉。避免 `crew <name> --model X`
# 里 --model 被当位置参数吞掉、静默不生效(换模型看似没反应)的坑。
POS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --model) BACKEND="$2"; shift 2 ;;
    --key) KEY="$2"; shift 2 ;;
    --policy) POLICY="$2"; shift 2 ;;
    --tmux) NO_TMUX=0; shift ;;
    --no-tmux) NO_TMUX=1; shift ;;
    --use-current-tmux) USE_CUR_TMUX=1; shift ;;
    --fresh) FRESH=1; shift ;;
    --safe) SAFE=1; shift ;;
    --dir) DIR="$2"; shift 2 ;;
    --pick) PICK=1; shift ;;
    -v|--version) POS=(version); shift; break ;;   # 2026-09-01:--version/-v 等价 version 子命令(之前被当会话名误起)
    -h|--help) POS=(help); shift; break ;;
    --) shift; while [ $# -gt 0 ]; do POS+=("$1"); shift; done; break ;;
    *) POS+=("$1"); shift ;;
  esac
done
set -- "${POS[@]}"

if [ $# -eq 0 ]; then
  # 2026-09-01:crew 空参 → 交互(选已有会话 attach,或"+ 新建")。非交互(脚本/无 tty)回落 ls
  # (保持管道/脚本行为不变)。CREW_NO_MENU=1 也强制 ls。
  if [ -t 0 ] && [ -z "${CREW_NO_MENU:-}" ]; then set -- menu; else set -- ls; fi
fi

CMD="$1"; shift

case "$CMD" in prune) : ;; *) crew_autoprune ;; esac

case "$CMD" in
  ls|list)      cmd_ls "$@" ;;
  menu)         cmd_menu ;;
  attach)       cmd_attach "$@" ;;
  stop)         cmd_stop "$@" ;;
  kill)         cmd_kill "$@" ;;
  pin)          cmd_pin "$@" ;;
  unpin)        cmd_unpin "$@" ;;
  adopt)        cmd_adopt "$@" ;;
  register)     cmd_register "$@" ;;
  wake)         cmd_wake "$@" ;;
  send)         cmd_send "$@" ;;
  notify)       cmd_notify "$@" ;;
  status)       cmd_status "$@" ;;
  heartbeat)    cmd_heartbeat "$@" ;;
  web)          cmd_web "$@" ;;
  inbox)        cmd_inbox "$@" ;;
  log)          cmd_log "$@" ;;
  models)       cmd_models "$@" ;;
  backends)     cmd_backends ;;
  keys)         cmd_keys ;;
  addkey|add-key) cmd_addkey "$@" ;;
  sync-models|syncmodels) cmd_sync_models "$@" ;;
  model-switch|switch-model) cmd_model_switch "$@" ;;
  doctor)       cmd_doctor "$@" ;;
  install-hooks) cmd_install_hooks "$@" ;;
  version)      case "${1:-}" in --notes|-n) cmd_version_notes "$@";; *) cmd_version "$@";; esac ;;
  switch)       cmd_switch "$@" ;;
  resume-prev)  cmd_resume_prev "$@" ;;
  find)         cmd_find "$@" ;;
  acp)          cmd_acp "$@" ;;
  dsh)          cmd_dsh "$@" ;;
  chat)         cmd_dsh "$@" ;;
  prune)        cmd_prune "$@" ;;
  help|--help|-h) cmd_help "$@" ;;
  *)            cmd_spawn "$CMD" "$@" ;;
esac
