#!/usr/bin/env bash
# crew-launcher — claude 启动层(2026-08-30 crew L 重构 Week 3)
#
# 职责:把 backend/key/policy/sid 组装成 claude 命令,exec 起来
#
# 用法:
#   crew-launcher spawn --name <name> --mode <fg|tmux> [--fresh] [--task "..."]
#
#   --mode fg:foreground,exec 替换当前 shell 成 claude(需 pty)
#   --mode tmux:调 crew-tmux ensure + run,让 tmux pane 里的 shell 跑 claude
#
# 读的 crew-session 字段:sid/backend/key/policy(自动读 policy_body 若有)
# 写的 crew-session 字段:sid(初次)/fgpid(fg 模式)/notmux(mode 记忆)
#
# 环境变量:
#   CREW_STATE       (透传)
#   CREW_HOME        backends/policy 模板目录
#   CREW_CLAUDE_BIN  claude 二进制路径(默认 /work/node20/bin/claude 或 claude-yolo)

set -uo pipefail

CREW_STATE="${CREW_STATE:-${XDG_DATA_HOME:-$HOME/.local/share}/claude-crew}"
CREW_HOME="${CREW_HOME:-$HOME/.config/claude-crew}"
# CLAUDE_BIN: CREW_CLAUDE_BIN 覆盖 > CLAUDE_BIN 覆盖 > PATH 里的 claude > 云端容器默认路径。
# (2026-08-31 修:原默认硬编码 /work/node20/bin/claude 是云端路径,mac 上没有 —— 没设
#  CREW_CLAUDE_BIN 时 mac 会找不到 claude 起不来会话。改为先探 PATH,回落云端路径。)
CLAUDE_BIN="${CREW_CLAUDE_BIN:-${CLAUDE_BIN:-$(command -v claude 2>/dev/null || echo /work/node20/bin/claude)}}"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CS="$SCRIPT_DIR/crew-session"
CT="$SCRIPT_DIR/crew-tmux"

usage() {
  cat <<EOF >&2
usage: crew-launcher spawn --name <name> --mode <fg|tmux|use-current-tmux> [--fresh] [--task "..."]

  --name <name>            必需,crew 会话名
  --mode fg|tmux|use-current-tmux  必需,启动模式
    fg              exec bash launcher 到当前 shell(前台)
    tmux            crew-tmux ensure + run(新起 tmux session)
    use-current-tmux 已在 tmux pane 里(bootstrap 起的外壳 tmux),不再 new-session,直接
                     exec bash launcher 到当前 pane —— B2 修(2026-08-31 audit-crew P2-b),
                     根治 pinned + bootstrap 外壳 tmux 打架的五概念纠缠;pinned 状态不动
  --fresh                  生成新 sid(不 resume 老)
  --task "..."             起后灌一段初始任务(tmux 模式:send-keys;fg/use-current-tmux:忽略)
EOF
  exit 2
}

# 生成随机 uuid(用 /proc/sys/kernel/random/uuid,依赖 kernel)
gen_uuid() {
  if [ -r /proc/sys/kernel/random/uuid ]; then
    cat /proc/sys/kernel/random/uuid
  else
    # fallback:用 openssl 或 uuidgen
    command -v uuidgen >/dev/null 2>&1 && uuidgen || \
      command -v openssl >/dev/null 2>&1 && openssl rand -hex 16 | sed 's/\(........\)\(....\)\(....\)\(....\)\(............\)/\1-\2-\3-\4-\5/' || \
      { echo "no uuid source" >&2; return 1; }
  fi
}

# 读 backend conf(BASE_URL/MODEL/TOKEN/KEY_MODE)—— 老 crew 兼容
load_backend_conf() {
  local name="$1"
  local backend
  backend=$("$CS" get "$name" backend 2>/dev/null || echo "")
  [ -z "$backend" ] && { echo "[crew-launcher] no backend for '$name'(先 crew-session set <n> backend X)" >&2; return 1; }
  local conf="$CREW_HOME/backends/$backend.conf"
  # v1 兼容(2026-08-30 切换 work 时踩):conf 缺失时按 v1 双路径判:
  # 1) backend 名带逗号(如 "joycode-oai,GLM-5.3") → 合成 ccr backend(BASE_URL=crew-proxy:8788,
  #    MODEL 保全串,TOKEN=test,KEY_MODE=ccr)—— 让 CCR 路由
  # 2) backend 名无逗号 → 报错让用户显式传 --model provider,model
  if [ ! -f "$conf" ]; then
    case "$backend" in
      *,*)
        # v1 line 313-315 逻辑:合成 ccr backend
        BK_BASE_URL="http://127.0.0.1:${CREW_PROXY_PORT:-8788}"
        BK_MODEL="$backend"
        BK_TOKEN="test"
        BK_ENV_EXTRA="MAX_THINKING_TOKENS=0 CLAUDE_CODE_DISABLE_UNKNOWN_MODEL_WINDOW_ENFORCEMENT=1"
        BK_KEY_MODE="ccr"
        BK_CLAUDE_FLAGS=""
        echo "[crew-launcher] backend '$backend' 无 conf 文件,按 v1 语义合成 ccr backend(via crew-proxy:8788)" >&2
        return 0
        ;;
      *)
        # 2026-09-01 裸模型名兜底:backend 无 conf 且不含逗号(如 "GLM-5.3")—— 以前直接拒起
        # (work backend 被写成裸 GLM-5.3 就起不来的坑)。改为先查 CCR:哪个 provider 的 models[]
        # 含这个 realmodel,查到就合成 provider,realmodel 的 ccr backend 起(走 crew-proxy:8788)。
        local _prov=""
        if command -v node >/dev/null 2>&1 && [ -f "$HOME/.claude-code-router/config.json" ]; then
          _prov=$(RM="$backend" node -e '
            const fs=require("fs");
            const c=JSON.parse(fs.readFileSync(process.env.HOME+"/.claude-code-router/config.json","utf8"));
            const ps=c.Providers||c.providers||[];
            const p=ps.find(p=>(p.models||[]).indexOf(process.env.RM)>=0);
            if(p) process.stdout.write(p.name);
          ' 2>/dev/null)
        fi
        if [ -n "$_prov" ]; then
          BK_BASE_URL="http://127.0.0.1:${CREW_PROXY_PORT:-8788}"
          BK_MODEL="$_prov,$backend"
          BK_TOKEN="test"; BK_KEY_MODE="ccr"; BK_CLAUDE_FLAGS=""
          BK_ENV_EXTRA="MAX_THINKING_TOKENS=0 CLAUDE_CODE_DISABLE_UNKNOWN_MODEL_WINDOW_ENFORCEMENT=1"
          echo "[crew-launcher] 裸模型名 '$backend' 无 conf,查 CCR 反推 provider='$_prov' → 合成 ccr backend '$_prov,$backend'(via :8788)" >&2
          return 0
        fi
        echo "[crew-launcher] backend '$backend' 无 conf、不含逗号、CCR 里也无 provider 提供它,拒起。用 --model provider,model(例:joycode-oai,GLM-5.3)或 crew addkey/sync-models" >&2
        return 1
        ;;
    esac
  fi
  # 只 source 已知字段,防注入
  local line k v
  while IFS='=' read -r k v; do
    case "$k" in
      BASE_URL|MODEL|TOKEN|KEY_MODE|ENV_EXTRA|CLAUDE_FLAGS)
        # 去掉两端空白
        v=$(echo "$v" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/^"//;s/"$//')
        eval "BK_$k=\"\$v\""
        ;;
    esac
  done < "$conf"
}

# 组装 claude 命令行(数组形式,避 quoting)。cwd = 会话工作目录(算 claude project 目录用)
build_claude_argv() {
  local name="$1" fresh="$2" cwd="${3:-$PWD}"
  local -a argv=()
  # model
  [ -n "${BK_MODEL:-}" ] && argv+=( --model "$BK_MODEL" )
  # dangerously-skip-permissions(默认加,除非 conf 说别)
  case " ${BK_CLAUDE_FLAGS:-} " in
    *" --dangerously-skip-permissions "*) : ;;
    *) argv+=( --dangerously-skip-permissions ) ;;
  esac
  # claude 把 transcript 存在 ~/.claude/projects/<cwd编码>/<sid>.jsonl,cwd编码 = cwd 里非
  # [A-Za-z0-9] 换成 '-'。--resume <sid> 只在【当前 cwd 对应的 project 目录】找。
  local projdir; projdir="$HOME/.claude/projects/$(printf '%s' "$cwd" | sed 's/[^A-Za-z0-9]/-/g')"
  # sid: --resume 老 sid,或 --session-id 新 uuid
  local sid=""
  if [ "$fresh" != "1" ]; then
    sid=$("$CS" get "$name" sid 2>/dev/null || true)
  fi
  if [ -n "$sid" ]; then
    # 2026-09-01:resume 存在性按【当前 cwd 的 project 目录】判(不用全局 * 通配——通配会"以为
    # 存在"但 claude 在当前 cwd 找不到 → 弹会话选择器/空会话)。cwd 目录有 <sid>.jsonl → --resume
    # (claude 一定命中);cwd 目录没有但别处有 → 仍 --resume(claude 按它记录的 cwd 定位);
    # 全都没有 → --session-id 新起(历史文件之后自然生成)。
    if [ -f "$projdir/$sid.jsonl" ] || ls "$HOME"/.claude/projects/*/"$sid".jsonl >/dev/null 2>&1; then
      argv+=( --resume "$sid" )
    else
      argv+=( --session-id "$sid" )
    fi
  else
    # 2026-09-01 修:fresh 生成新 sid 前,先把老 sid 归档到 prev_sid(否则一次 --fresh 就把老历史
    # 孤立——文件还在但 state 不再指向,resume 永远回不来。web-kimi 7.2MB 历史就这么"丢"过)。
    local old_sid; old_sid=$("$CS" get "$name" sid 2>/dev/null || true)
    [ -n "$old_sid" ] && "$CS" set "$name" prev_sid "$old_sid" >/dev/null 2>&1 || true
    sid=$(gen_uuid) || return 1
    argv+=( --session-id "$sid" )
    "$CS" set "$name" sid "$sid" >/dev/null
  fi
  # policy(--append-system-prompt "$(cat FILE)")—— 通过 shell 展开,launcher 里用数组不能展开,写 wrapper 处理
  # 输出 argv 到 stdout(空格分隔,shell-quote 化,调用方 eval 或 array)
  printf '%s\n' "${argv[@]}"
}

# spawn --name X --mode fg|tmux [...]
cmd_spawn() {
  local name="" mode="" fresh=0 task="" dir="" model_arg="" key_arg=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --name) name="$2"; shift 2 ;;
      --mode) mode="$2"; shift 2 ;;
      --fresh) fresh=1; shift ;;
      --task) task="$2"; shift 2 ;;
      --dir) dir="$2"; shift 2 ;;
      # 2026-08-31:补 --model/--key 分支。之前只有 crew 主脚本吃这两个 flag 并写 state,
      # 外部调用方(面板/adopt/直接调 launcher 的脚本)传 --model 会落进 `*) shift ;;` 被
      # 静默吞掉 → 换模型没反应,只能手动 crew-session set backend 绕过。这里显式吸掉并
      # 立即写会话 state,让下面 load_backend_conf 读 state.backend 时是新值。
      --model) model_arg="$2"; shift 2 ;;
      --key) key_arg="$2"; shift 2 ;;
      *) shift ;;
    esac
  done
  [ -z "$name" ] || [ -z "$mode" ] && usage
  case "$mode" in fg|tmux|use-current-tmux) : ;; *) echo "[crew-launcher] mode 必须 fg / tmux / use-current-tmux" >&2; usage ;; esac

  # --model/--key 先写会话 state(与 crew 主脚本 1037-1038 行同语义),再交给 load_backend_conf
  [ -n "$model_arg" ] && "$CS" set "$name" backend "$model_arg" >/dev/null
  [ -n "$key_arg" ]   && "$CS" set "$name" key     "$key_arg"   >/dev/null

  # 加载 backend
  load_backend_conf "$name" || return 1

  # dir 回写 state,供 crew ls / 下次重启复用(crew-session 是通用 kv;crew ls 已有从
  # /proc/cwd 与 registry 反查 dir 的逻辑,state.dir 作为额外来源不冲突)。
  [ -n "$dir" ] && "$CS" set "$name" dir "$dir" >/dev/null 2>&1 || true

  # 处理 policy body(A3):policy 字段存在 → 用 policy_body 文件传给 --append-system-prompt
  local policy_body_arg=""
  if "$CS" has "$name" policy 2>/dev/null; then
    local pol
    pol=$("$CS" get "$name" policy)
    # 从模板生成 body 落文件(如果 policy_body 字段不存在)
    if ! "$CS" has "$name" policy_body 2>/dev/null; then
      local tmpl="$CREW_HOME/templates/policy-$pol.md"
      [ -f "$tmpl" ] || tmpl="$SCRIPT_DIR/../templates/policy-$pol.md"
      if [ -f "$tmpl" ]; then
        # 提取 --- 后正文(和老 extract_policy_body 一致)
        local body
        body=$(awk '/^---$/{flag=1; next} flag' "$tmpl")
        [ -n "$body" ] && "$CS" set "$name" policy_body "$body" >/dev/null
      fi
    fi
    if "$CS" has "$name" policy_body 2>/dev/null; then
      policy_body_arg="$CREW_STATE/$name.policy_body"
    fi
  fi

  # 组装 argv(不含 policy)—— 输出数组
  local argv_lines
  # cwd:优先 --dir 传入;空则读 state.dir;再空回落 $PWD(算 claude project 目录用)
  local _cwd="$dir"
  [ -z "$_cwd" ] && _cwd=$("$CS" get "$name" dir 2>/dev/null || echo "")
  [ -z "$_cwd" ] && _cwd="$PWD"
  argv_lines=$(build_claude_argv "$name" "$fresh" "$_cwd") || return 1
  # 转数组
  local -a argv=()
  while IFS= read -r line; do
    argv+=("$line")
  done <<< "$argv_lines"
  # 加 policy(如果有 body 文件,通过 wrapper 让 shell 展开)
  local extra_policy=""
  [ -n "$policy_body_arg" ] && extra_policy=" --append-system-prompt \"\$(cat $(printf %q "$policy_body_arg"))\""

  # 2026-08-31 [onboarding] 通用会话协议注入:/work/.crew-onboarding/CLAUDE.md 存在则
  # 追加到 --append-system-prompt。位置在 policy 之前(先通用协议再具体域 policy),
  # claude 按顺序拼多个 --append-system-prompt。用户拍板方案 A(crew-launcher 注入)。
  # 版本号在同目录 VERSION 文件,launcher 通过 CREW_ONBOARDING_VER env 透传给会话
  # (便于会话内自查/statusline 显示协议版本)。文件不存在时静默跳过,不影响启动。
  local extra_onboarding=""
  local onboarding_file="${CREW_ONBOARDING_DIR:-/work/.crew-onboarding}/CLAUDE.md"
  local onboarding_ver_file="${CREW_ONBOARDING_DIR:-/work/.crew-onboarding}/VERSION"
  local onboarding_ver=""
  if [ -f "$onboarding_file" ]; then
    extra_onboarding=" --append-system-prompt \"\$(cat $(printf %q "$onboarding_file"))\""
    if [ -f "$onboarding_ver_file" ]; then
      onboarding_ver=$(head -1 "$onboarding_ver_file" 2>/dev/null | tr -d '[:space:]')
    fi
  fi

  # env 前缀
  local envp=""
  [ -n "$onboarding_ver" ] && envp+=" CREW_ONBOARDING_VER=$(printf %q "$onboarding_ver")"
  [ -n "${BK_BASE_URL:-}" ] && envp+=" ANTHROPIC_BASE_URL=$(printf %q "$BK_BASE_URL")"
  [ -n "${BK_TOKEN:-}" ] && envp+=" ANTHROPIC_AUTH_TOKEN=$(printf %q "$BK_TOKEN")"
  [ -n "${BK_ENV_EXTRA:-}" ] && envp+=" $BK_ENV_EXTRA"
  # 2026-08-31 修 statusline 显示 bug:v2 重构时丢了 v1(crew.v1:775-776)对 CREW_* 的注入,
  # 导致 claude 子进程不知道自己属于哪个 crew 会话 → crew-statusline.sh 认不出会话、回落到
  # CCR Router.default(显示成 Claude-Opus-4.8-joybuilder + 默认 key)。补回:让 statusline /
  # keyresolve 能拿到本会话真实 model/key。CREW_STATE 也让子进程内的 crew 命令指对状态目录。
  local _sess_backend _sess_key
  _sess_backend=$("$CS" get "$name" backend 2>/dev/null || echo "")
  _sess_key=$("$CS" get "$name" key 2>/dev/null || echo "")
  envp+=" CREW_SESSION=$(printf %q "$name") CREW_HOME=$(printf %q "$CREW_HOME") CREW_STATE=$(printf %q "$CREW_STATE")"
  [ -n "$_sess_backend" ] && envp+=" CREW_MODEL=$(printf %q "$_sess_backend")"
  [ -n "$_sess_key" ] && envp+=" CREW_KEY=$(printf %q "$_sess_key")"

  # 拼完整命令(每次生成 launcher 脚本文件传 tmux/fg,避 quoting)
  # 2026-08-30 audit-crew C4(P0):
  #   ①chmod 600(不 +x)— launcher 通过 `bash <file>` 跑,不需要执行权限;600 让 /tmp
  #     里的 ANTHROPIC_AUTH_TOKEN 只有 owner 可读,阻断"/tmp 明文 token 被同容器其他用户
  #     读到"路径。v1(870,884)是脱敏 crew-last-cmd 但 launcher 本身仍 644——v2 补齐。
  #   ②launcher 内容首行 self-unlink:bash 起来立即 rm 自己,claude exec 起来时文件已无。
  #     即使 send-keys 期间被 curl /tmp 扫走,也只有几毫秒窗口。
  #     测试注入 CREW_LAUNCHER_KEEP=1 可跳过 self-unlink(便于 unit test 检查内容),
  #     生产不设该 env → 默认走 self-unlink。
  local launcher="/tmp/crew-launch-$name.sh"
  {
    echo "#!/bin/bash"
    echo "# generated by crew-launcher for '$name' mode=$mode"
    if [ -z "${CREW_LAUNCHER_KEEP:-}" ]; then
      echo "# self-unlink first: 阻断 /tmp 明文 token 泄露(audit-crew C4)"
      echo 'rm -f "$0" 2>/dev/null || true'
    fi
    echo "export PATH=/work/node20/bin:\$PATH LANG=C.UTF-8 LC_ALL=C.UTF-8 IS_SANDBOX=1"
    # 2026-08-31 修 Bug A:在起 claude 前 cd 到会话工作目录(对齐 v1:858/888)。v2 之前直接
    # 在 tmux pane 当前目录起 claude → 换模型/重启会话丢工作目录,且 --resume 按错目录找历史崩。
    [ -n "$dir" ] && printf 'cd %s || { echo "[crew] cannot cd to %s" >&2; exit 1; }\n' "$(printf %q "$dir")" "$(printf %q "$dir")"
    printf 'exec env%s "%s"' "$envp" "$CLAUDE_BIN"
    for a in "${argv[@]}"; do
      printf ' %s' "$(printf %q "$a")"
    done
    printf '%s%s' "$extra_onboarding" "$extra_policy"
    echo
  } > "$launcher"
  chmod 600 "$launcher"

  # mode fg:exec launcher(取代当前 shell)
  # mode tmux:调 crew-tmux ensure + run
  # mode use-current-tmux(2026-08-31 audit-crew P2-b):已在 tmux pane 里,不 new-session,
  #   直接 exec bash launcher —— 根治 pinned + bootstrap 外壳 tmux 打架的五概念纠缠。
  #   pinned 状态不动(不 unpin/re-pin);notmux 设 0(未来 crew ls 判 live 靠 tmux 存在性)
  case "$mode" in
    fg)
      "$CS" set "$name" notmux "1" >/dev/null
      "$CS" set "$name" fgpid "$$" >/dev/null
      exec bash "$launcher"
      ;;
    use-current-tmux)
      # 前置检查:必须在 tmux pane 里(否则等同 fg,提示更清晰)
      if [ -z "${TMUX:-}" ]; then
        echo "[crew-launcher] --mode use-current-tmux 需要在 tmux pane 里跑(当前 \$TMUX 未设),回落 fg 模式" >&2
        "$CS" set "$name" notmux "1" >/dev/null
        exec bash "$launcher"
      fi
      # 记 tmuxname 为当前 pane 所在 session(方便 crew ls / crew-tmux resolve 认它)
      _cur_sess=$(tmux display-message -p '#S' 2>/dev/null)
      if [ -n "$_cur_sess" ]; then
        "$CS" set "$name" tmuxname "$_cur_sess" >/dev/null
        # 顺手写 .tmux(adopt marker),让 crew ls 认它;pinned 状态保持
        "$CS" set "$name" tmux "$_cur_sess" >/dev/null
      fi
      "$CS" set "$name" notmux "0" >/dev/null
      echo "[crew-launcher] '$name' mode=use-current-tmux ready (pane=$_cur_sess, launcher=$launcher)"
      exec bash "$launcher"
      ;;
    tmux)
      "$CS" set "$name" notmux "0" >/dev/null
      "$CT" ensure "$name" || { echo "[crew-launcher] ensure tmux 失败" >&2; return 1; }
      # 等 pane 里 shell 准备好(输出 prompt)
      local resolved
      resolved=$("$CT" resolve "$name")
      for i in $(seq 1 20); do
        timeout 3 tmux capture-pane -t "$resolved" -p 2>/dev/null | grep -qE '\$|#|❯' && break
        sleep 0.15
      done
      "$CT" run "$name" "$launcher"
      # task:launcher 起 claude 后,再 send-keys task(在 claude REPL 里)
      if [ -n "$task" ]; then
        sleep 2  # 等 claude 起来
        timeout 3 tmux send-keys -t "$resolved" -l "$task"
        sleep 0.3
        timeout 3 tmux send-keys -t "$resolved" Enter
      fi
      echo "[crew-launcher] '$name' mode=tmux ready (tmux=$resolved, launcher=$launcher)"
      ;;
  esac
}

case "${1:-}" in
  spawn)  shift; cmd_spawn "$@" ;;
  help|--help|-h) sed -n '3,15p' "$0" ;;
  '') usage ;;
  *) echo "[crew-launcher] unknown command: $1" >&2; exit 2 ;;
esac
