#!/usr/bin/env bash
# crew-launcher — claude 启动层(2026-08-30 crew L 重构 Week 3)
#
# 职责:把 backend/key/policy/sid 组装成 claude 命令,exec 起来
#
# 用法:
#   crew-launcher spawn --name <name> --mode <fg|tmux> [--fresh] [--task "..."]
#
#   --mode fg:foreground,exec 替换当前 shell 成 claude(需 pty)
#   --mode tmux:调 crew-tmux ensure + run,让 tmux pane 里的 shell 跑 claude
#
# 读的 crew-session 字段:sid/backend/key/policy(自动读 policy_body 若有)
# 写的 crew-session 字段:sid(初次)/fgpid(fg 模式)/notmux(mode 记忆)
#
# 环境变量:
#   CREW_STATE       (透传)
#   CREW_HOME        backends/policy 模板目录
#   CREW_CLAUDE_BIN  claude 二进制路径(默认 /work/node20/bin/claude 或 claude-yolo)

set -uo pipefail

CREW_STATE="${CREW_STATE:-${XDG_DATA_HOME:-$HOME/.local/share}/claude-crew}"
CREW_HOME="${CREW_HOME:-$HOME/.config/claude-crew}"
# CLAUDE_BIN: CREW_CLAUDE_BIN 覆盖 > CLAUDE_BIN 覆盖 > PATH 里的 claude > 云端容器默认路径。
# (2026-08-31 修:原默认硬编码 /work/node20/bin/claude 是云端路径,mac 上没有 —— 没设
#  CREW_CLAUDE_BIN 时 mac 会找不到 claude 起不来会话。改为先探 PATH,回落云端路径。)
CLAUDE_BIN="${CREW_CLAUDE_BIN:-${CLAUDE_BIN:-$(command -v claude 2>/dev/null || echo /work/node20/bin/claude)}}"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CS="$SCRIPT_DIR/crew-session"
CT="$SCRIPT_DIR/crew-tmux"

usage() {
  cat <<EOF >&2
usage: crew-launcher spawn --name <name> --mode <fg|tmux|use-current-tmux> [--fresh] [--task "..."]

  --name <name>            必需,crew 会话名
  --mode fg|tmux|use-current-tmux  必需,启动模式
    fg              exec bash launcher 到当前 shell(前台)
    tmux            crew-tmux ensure + run(新起 tmux session)
    use-current-tmux 已在 tmux pane 里(bootstrap 起的外壳 tmux),不再 new-session,直接
                     exec bash launcher 到当前 pane —— B2 修(2026-08-31 audit-crew P2-b),
                     根治 pinned + bootstrap 外壳 tmux 打架的五概念纠缠;pinned 状态不动
  --fresh                  生成新 sid(不 resume 老)
  --task "..."             起后灌一段初始任务(tmux 模式:send-keys;fg/use-current-tmux:忽略)
EOF
  exit 2
}

# 生成随机 uuid(优先 /proc/sys/kernel/random/uuid;mac 等无 /proc 时回落 uuidgen / openssl)。
# 2026-09-03 修:原 fallback 用 `A && uuidgen || B && openssl` 链——bash 左结合下 uuidgen 成功后
# `&& openssl` 仍会执行,导致输出两个 uuid 拼一起(mac 上 --session-id 传俩值 → claude
# "Session ID already in use"/起不来)。改 if/elif 分支消除链式陷阱;uuidgen 大写转小写规范化。
gen_uuid() {
  if [ -r /proc/sys/kernel/random/uuid ]; then
    cat /proc/sys/kernel/random/uuid
  elif command -v uuidgen >/dev/null 2>&1; then
    uuidgen | tr 'A-Z' 'a-z'
  elif command -v openssl >/dev/null 2>&1; then
    openssl rand -hex 16 | sed 's/\(........\)\(....\)\(....\)\(....\)\(............\)/\1-\2-\3-\4-\5/'
  else
    echo "no uuid source" >&2; return 1
  fi
}

# sid_alive: 校验 jsonl transcript 是否 claude 认可(而不只是"文件存在")。
# claude 的 <sid>.jsonl 首行固定形如 {"type":"mode","sessionId":"<sid>"};首行不可 parse
# 或 sessionId 不匹配 = 文件损坏/被清/换了名字,claude 起来必"No conversation found"秒退。
# 用 node 一行验(比 grep 稳:jsonl 可能字段顺序/引号变体,但 JSON.parse 一致)。
sid_alive() {
  local file="$1" sid="$2"
  [ -s "$file" ] || return 1                    # 空文件直接死
  command -v node >/dev/null 2>&1 || return 0   # 无 node:降级只信任文件存在(旧行为)
  node -e '
    const fs=require("fs");
    try {
      const line=fs.readFileSync(process.argv[1],"utf8").split("\n",1)[0].trim();
      if(!line) process.exit(1);
      const j=JSON.parse(line);
      process.exit(j&&j.sessionId===process.argv[2]?0:1);
    } catch(e) { process.exit(1); }
  ' "$file" "$sid" 2>/dev/null
}

# _fallback_backend_key: 扫存活会话 state 文件,按 backend/key 出现频次找众数,输出到 stdout
# 格式:BACKEND\tKEY(TAB 分隔)。无有效数据返空。
# 优先级:env CREW_FALLBACK_MODEL/CREW_FALLBACK_KEY > 众数统计。
# 2026-09-02 · P1 修:crew v2 crew-launcher 硬要 .backend 导致老 adopt 会话 resume 死循环
# (work 会话事故手动救活 18 个后用户拍板加此 fallback)。
_fallback_backend_key() {
  local fb_model="${CREW_FALLBACK_MODEL:-}"
  local fb_key="${CREW_FALLBACK_KEY:-}"
  # env override 全给了就直接用
  if [ -n "$fb_model" ] && [ -n "$fb_key" ]; then
    printf '%s\t%s' "$fb_model" "$fb_key"
    return 0
  fi
  # 用 node 扫 CREW_STATE/*.backend + *.key,统计众数;bash 无 hash 表 grep+uniq 也可但慢
  command -v node >/dev/null 2>&1 || return 1
  node -e '
    const fs=require("fs"), path=require("path");
    const dir=process.env.CREW_STATE;
    if(!dir) process.exit(1);
    let files=[];
    try{files=fs.readdirSync(dir);}catch(_){process.exit(1);}
    const bk={}, kk={};
    for(const f of files){
      if(f.endsWith(".backend")){
        const v=fs.readFileSync(path.join(dir,f),"utf8").trim();
        if(v) bk[v]=(bk[v]||0)+1;
      } else if(f.endsWith(".key")){
        const v=fs.readFileSync(path.join(dir,f),"utf8").trim();
        if(v) kk[v]=(kk[v]||0)+1;
      }
    }
    const top=(m)=>{const e=Object.entries(m);if(!e.length)return "";return e.sort((a,b)=>b[1]-a[1])[0][0];};
    const b=process.env.FB_MODEL||top(bk);
    const k=process.env.FB_KEY||top(kk);
    if(b||k) process.stdout.write((b||"")+"\t"+(k||""));
  ' 2>/dev/null <<< ""  # env override 已在 shell 侧处理,这里不再传
}

# 读 backend conf(BASE_URL/MODEL/TOKEN/KEY_MODE)—— 老 crew 兼容
load_backend_conf() {
  local name="$1"
  local backend
  backend=$("$CS" get "$name" backend 2>/dev/null || echo "")
  # 2026-09-02 P1:backend 空时不 die,fallback 到众数(env 或存活会话统计)
  if [ -z "$backend" ]; then
    local fb; fb=$(_fallback_backend_key)
    local fb_model="${fb%$'\t'*}"
    local fb_key="${fb##*$'\t'}"
    if [ -n "$fb_model" ]; then
      echo "[crew-launcher] warn: '$name' 无 backend state,fallback 众数:backend='$fb_model' key='$fb_key'(写入 state 记忆本次)" >&2
      "$CS" set "$name" backend "$fb_model" >/dev/null 2>&1 || true
      [ -n "$fb_key" ] && "$CS" set "$name" key "$fb_key" >/dev/null 2>&1 || true
      backend="$fb_model"
    else
      echo "[crew-launcher] no backend for '$name' 且 fallback 无候选(无 env override 且 CREW_STATE 里无存活会话 state)" >&2
      return 1
    fi
  fi
  local conf="$CREW_HOME/backends/$backend.conf"
  # v1 兼容(2026-08-30 切换 work 时踩):conf 缺失时按 v1 双路径判:
  # 1) backend 名带 CCR 3 selector(如 "joycode-oai/GLM-5.3") → 合成 ccr backend(BASE_URL=crew-proxy:8788,
  #    MODEL 保全串,TOKEN=test,KEY_MODE=ccr)—— 让 CCR 路由
  # 2) backend 名无 selector → 报错让用户显式传 --model provider/model
  if [ ! -f "$conf" ]; then
    # 2026-10-16 兼容:历史 state 里 backend 是 CCR 2 时代的 "provider,model"(逗号)串。
    # 旧版本(commit 2028139 前)写的就是逗号,迁移时漏改 → launcher 按单模型名处理匹配不到 →
    # 拒起。这里统一转成 CCR 3 的 "provider/model" 斜杠串再走下面的 selector 分支。
    case "$backend" in
      *,*)
        local _bn="${backend%%,*}" _bm="${backend#*,}"
        echo "[crew-launcher] backend '$backend' 是旧逗号串,归一化为 '$_bn/$_bm'" >&2
        backend="$_bn/$_bm"
        ;;
    esac
    case "$backend" in
      */*)
        # v1 line 313-315 逻辑:合成 ccr backend
        BK_BASE_URL="http://127.0.0.1:${CREW_PROXY_PORT:-8788}"
        BK_MODEL="$backend"
        BK_TOKEN="test"
        BK_ENV_EXTRA="MAX_THINKING_TOKENS=0 CLAUDE_CODE_DISABLE_UNKNOWN_MODEL_WINDOW_ENFORCEMENT=1"
        BK_KEY_MODE="ccr"
        BK_CLAUDE_FLAGS=""
        echo "[crew-launcher] backend '$backend' 无 conf 文件,按 v1 语义合成 ccr backend(via crew-proxy:8788)" >&2
        return 0
        ;;
      *)
        # 裸模型名兜底:backend 无 conf 且不含 CCR 3 selector(如 "GLM-5.3")。
        # 查 CCR provider map，查到就合成 provider/model 的 backend（走 crew-proxy:8788）。
        local _prov=""
        local _crew_provider_map="${CREW_CCR_CONFIG:-$CREW_HOME/ccr-providers.json}"
        if command -v node >/dev/null 2>&1 && [ -f "$_crew_provider_map" ]; then
          _prov=$(RM="$backend" CREW_PROVIDER_MAP="$_crew_provider_map" node -e '
            const fs=require("fs");
            const c=JSON.parse(fs.readFileSync(process.env.CREW_PROVIDER_MAP,"utf8"));
            const ps=c.Providers||c.providers||[];
            const p=ps.find(p=>(p.models||[]).indexOf(process.env.RM)>=0);
            if(p) process.stdout.write(p.name);
          ' 2>/dev/null)
        fi
        if [ -n "$_prov" ]; then
          BK_BASE_URL="http://127.0.0.1:${CREW_PROXY_PORT:-8788}"
          BK_MODEL="$_prov/$backend"
          BK_TOKEN="test"; BK_KEY_MODE="ccr"; BK_CLAUDE_FLAGS=""
          BK_ENV_EXTRA="MAX_THINKING_TOKENS=0 CLAUDE_CODE_DISABLE_UNKNOWN_MODEL_WINDOW_ENFORCEMENT=1"
          echo "[crew-launcher] 裸模型名 '$backend' 无 conf,查 CCR 反推 provider='$_prov' → 合成 CCR 3 selector '$_prov/$backend'(via :8788)" >&2
          return 0
        fi
        echo "[crew-launcher] backend '$backend' 无 conf、不含 CCR 3 selector、provider map 里也无 provider 提供它,拒起。用 --model provider/model(例:joycode-oai/GLM-5.3)或 crew addkey/sync-models" >&2
        return 1
        ;;
    esac
  fi
  # 只 source 已知字段,防注入
  local line k v
  while IFS='=' read -r k v; do
    case "$k" in
      BASE_URL|MODEL|TOKEN|KEY_MODE|ENV_EXTRA|CLAUDE_FLAGS)
        # 去掉两端空白
        v=$(echo "$v" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/^"//;s/"$//')
        eval "BK_$k=\"\$v\""
        ;;
    esac
  done < "$conf"
}

# 组装 claude 命令行(数组形式,避 quoting)。cwd = 会话工作目录(算 claude project 目录用)
build_claude_argv() {
  local name="$1" fresh="$2" cwd="${3:-$PWD}"
  local -a argv=()
  # model
  [ -n "${BK_MODEL:-}" ] && argv+=( --model "$BK_MODEL" )
  # 2026-09-03 --name <crew会话名>:让 claude 的 agentName = crew 会话名,而不是 harness 按 cwd
  # 自动生成的 work-8d 之类。根治官方 SendMessage/ListAgents 寻址用的名字与 crew 会话名脱节:
  # 之前 cwd=/work 的会话 agentName 全是 work-XX,发消息 to=work-8d,hook 按 to 记 inbox 就散落
  # 到 inbox/work-8d 而非 inbox/<会话名>。加 --name 后 ListAgents 列出即会话名、to=会话名、
  # hook 记 inbox/<会话名> 全对齐,收发方寻址一致。
  argv+=( --name "$name" )
  # dangerously-skip-permissions(默认加,除非 conf 说别)
  case " ${BK_CLAUDE_FLAGS:-} " in
    *" --dangerously-skip-permissions "*) : ;;
    *) argv+=( --dangerously-skip-permissions ) ;;
  esac
  # claude 把 transcript 存在 ~/.claude/projects/<cwd编码>/<sid>.jsonl,cwd编码 = cwd 里非
  # [A-Za-z0-9] 换成 '-'。--resume <sid> 只在【当前 cwd 对应的 project 目录】找。
  local projdir; projdir="$HOME/.claude/projects/$(printf '%s' "$cwd" | sed 's/[^A-Za-z0-9]/-/g')"
  # sid: --resume 老 sid,或 --session-id 新 uuid
  local sid=""
  if [ "$fresh" != "1" ]; then
    sid=$("$CS" get "$name" sid 2>/dev/null || true)
  fi
  if [ -n "$sid" ]; then
    # 2026-09-01:resume 存在性按【当前 cwd 的 project 目录】判(不用全局 * 通配——通配会"以为
    # 存在"但 claude 在当前 cwd 找不到 → 弹会话选择器/空会话)。cwd 目录有 <sid>.jsonl → --resume
    # (claude 一定命中);cwd 目录没有但别处有 → 仍 --resume(claude 按它记录的 cwd 定位);
    # 全都没有 → --session-id 新起(历史文件之后自然生成)。
    #
    # 2026-09-01 §F(sid 死指自愈):文件在但不是 claude 认可的 transcript(空/损坏/首行
    # sessionId 不匹配)时,claude 起来会"No conversation found"秒退。**内容预检**堵这个坑:
    # 找到候选文件 → 校验首行 JSON 的 sessionId === sid → 匹配才 --resume;不匹配就当死指
    # 走 fallback:归档 sid 到 prev_sid + 生成新 sid + --session-id(等价 --fresh 但老历史留档)。
    local _cand=""
    if [ -f "$projdir/$sid.jsonl" ]; then _cand="$projdir/$sid.jsonl"
    else _cand=$(ls "$HOME"/.claude/projects/*/"$sid".jsonl 2>/dev/null | head -1); fi
    if [ -n "$_cand" ] && sid_alive "$_cand" "$sid"; then
      argv+=( --resume "$sid" )
    elif [ -n "$_cand" ]; then
      # 文件在但内容不匹配 = 死指。归档 sid + 生成新的。
      echo "[crew-launcher] sid '$sid' 的 jsonl($_cand)首行 sessionId 不匹配,判定死指 → fallback --session-id 新起(老 sid 已归档 prev_sid)" >&2
      "$CS" set "$name" prev_sid "$sid" >/dev/null 2>&1 || true
      sid=$(gen_uuid) || return 1
      argv+=( --session-id "$sid" )
      "$CS" set "$name" sid "$sid" >/dev/null
    else
      # 文件真不在:与旧逻辑一致(--session-id sid,让 claude 自然写出这个 sid 的 transcript)
      argv+=( --session-id "$sid" )
    fi
  else
    # 2026-09-01 修:fresh 生成新 sid 前,先把老 sid 归档到 prev_sid(否则一次 --fresh 就把老历史
    # 孤立——文件还在但 state 不再指向,resume 永远回不来。web-kimi 7.2MB 历史就这么"丢"过)。
    local old_sid; old_sid=$("$CS" get "$name" sid 2>/dev/null || true)
    [ -n "$old_sid" ] && "$CS" set "$name" prev_sid "$old_sid" >/dev/null 2>&1 || true
    sid=$(gen_uuid) || return 1
    argv+=( --session-id "$sid" )
    "$CS" set "$name" sid "$sid" >/dev/null
  fi
  # policy(--append-system-prompt "$(cat FILE)")—— 通过 shell 展开,launcher 里用数组不能展开,写 wrapper 处理
  # 输出 argv 到 stdout(空格分隔,shell-quote 化,调用方 eval 或 array)
  # 2026-09-03 v8 P2(Agent-A3 复审):dump argv 快照到 $CREW_STATE/launcher-argv.log
  #   备排查 sendmsg-test-a/b argv 都成 test-b 之类的身份错位坑 · 只 append 不清 · 尽力不阻塞
  if [ -d "${CREW_STATE:-}" ]; then
    {
      printf '%s spawn name=%s argv=[' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$name"
      printf '%q ' "${argv[@]}"
      printf ']\n'
    } >> "$CREW_STATE/launcher-argv.log" 2>/dev/null || true
  fi
  printf '%s\n' "${argv[@]}"
}

# spawn --name X --mode fg|tmux [...]
cmd_spawn() {
  local name="" mode="" fresh=0 task="" dir="" model_arg="" key_arg=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --name) name="$2"; shift 2 ;;
      --mode) mode="$2"; shift 2 ;;
      --fresh) fresh=1; shift ;;
      --task) task="$2"; shift 2 ;;
      --dir) dir="$2"; shift 2 ;;
      # 2026-08-31:补 --model/--key 分支。之前只有 crew 主脚本吃这两个 flag 并写 state,
      # 外部调用方(面板/adopt/直接调 launcher 的脚本)传 --model 会落进 `*) shift ;;` 被
      # 静默吞掉 → 换模型没反应,只能手动 crew-session set backend 绕过。这里显式吸掉并
      # 立即写会话 state,让下面 load_backend_conf 读 state.backend 时是新值。
      --model) model_arg="$2"; shift 2 ;;
      --key) key_arg="$2"; shift 2 ;;
      *) shift ;;
    esac
  done
  [ -z "$name" ] || [ -z "$mode" ] && usage
  case "$mode" in fg|tmux|use-current-tmux) : ;; *) echo "[crew-launcher] mode 必须 fg / tmux / use-current-tmux" >&2; usage ;; esac

  # --model/--key 先写会话 state(与 crew 主脚本 1037-1038 行同语义),再交给 load_backend_conf
  [ -n "$model_arg" ] && "$CS" set "$name" backend "$model_arg" >/dev/null
  [ -n "$key_arg" ]   && "$CS" set "$name" key     "$key_arg"   >/dev/null

  # 加载 backend
  load_backend_conf "$name" || return 1

  # dir 回写 state,供 crew ls / 下次重启复用(crew-session 是通用 kv;crew ls 已有从
  # /proc/cwd 与 registry 反查 dir 的逻辑,state.dir 作为额外来源不冲突)。
  [ -n "$dir" ] && "$CS" set "$name" dir "$dir" >/dev/null 2>&1 || true

  # 处理 policy body(A3):policy 字段存在 → 用 policy_body 文件传给 --append-system-prompt
  local policy_body_arg=""
  if "$CS" has "$name" policy 2>/dev/null; then
    local pol
    pol=$("$CS" get "$name" policy)
    # 从模板生成 body 落文件(如果 policy_body 字段不存在)
    if ! "$CS" has "$name" policy_body 2>/dev/null; then
      local tmpl="$CREW_HOME/templates/policy-$pol.md"
      [ -f "$tmpl" ] || tmpl="$SCRIPT_DIR/../templates/policy-$pol.md"
      if [ -f "$tmpl" ]; then
        # 提取 --- 后正文(和老 extract_policy_body 一致)
        local body
        body=$(awk '/^---$/{flag=1; next} flag' "$tmpl")
        [ -n "$body" ] && "$CS" set "$name" policy_body "$body" >/dev/null
      fi
    fi
    if "$CS" has "$name" policy_body 2>/dev/null; then
      policy_body_arg="$CREW_STATE/$name.policy_body"
    fi
  fi

  # 组装 argv(不含 policy)—— 输出数组
  local argv_lines
  # cwd:优先 --dir 传入;空则读 state.dir;再空回落 $PWD(算 claude project 目录用)
  local _cwd="$dir"
  [ -z "$_cwd" ] && _cwd=$("$CS" get "$name" dir 2>/dev/null || echo "")
  [ -z "$_cwd" ] && _cwd="$PWD"
  argv_lines=$(build_claude_argv "$name" "$fresh" "$_cwd") || return 1
  # 转数组
  local -a argv=()
  while IFS= read -r line; do
    argv+=("$line")
  done <<< "$argv_lines"
  # 加 policy(如果有 body 文件,通过 wrapper 让 shell 展开)
  local extra_policy=""
  [ -n "$policy_body_arg" ] && extra_policy=" --append-system-prompt \"\$(cat $(printf %q "$policy_body_arg"))\""

  # 2026-08-31 [onboarding] 通用会话协议注入:/work/.crew-onboarding/CLAUDE.md 存在则
  # 追加到 --append-system-prompt。位置在 policy 之前(先通用协议再具体域 policy),
  # claude 按顺序拼多个 --append-system-prompt。用户拍板方案 A(crew-launcher 注入)。
  # 版本号在同目录 VERSION 文件,launcher 通过 CREW_ONBOARDING_VER env 透传给会话
  # (便于会话内自查/statusline 显示协议版本)。文件不存在时静默跳过,不影响启动。
  local extra_onboarding=""
  local onboarding_file="${CREW_ONBOARDING_DIR:-/work/.crew-onboarding}/CLAUDE.md"
  local onboarding_ver_file="${CREW_ONBOARDING_DIR:-/work/.crew-onboarding}/VERSION"
  local onboarding_ver=""
  if [ -f "$onboarding_file" ]; then
    extra_onboarding=" --append-system-prompt \"\$(cat $(printf %q "$onboarding_file"))\""
    if [ -f "$onboarding_ver_file" ]; then
      onboarding_ver=$(head -1 "$onboarding_ver_file" 2>/dev/null | tr -d '[:space:]')
    fi
  fi

  # 2026-09-03 通信约定注入:同机会话间通信改用官方 SendMessage/ListAgents(取代 tmux 注入)。
  # comm-protocol.md 随仓分发(templates/),launcher 无条件追加到 --append-system-prompt。
  # 顺序:onboarding(通用协议)→ comm(通信约定,横切能力)→ policy(域 policy,最具体、最后拼)。
  local extra_comm=""
  local comm_file="$SCRIPT_DIR/../templates/comm-protocol.md"
  [ -f "$comm_file" ] && extra_comm=" --append-system-prompt \"\$(cat $(printf %q "$comm_file"))\""

  # 2026-09-03 hooks 挂载:生成 per-session settings.json 落 $CREW_STATE/<name>.settings
  # (不落 /tmp,遵 audit-crew C4 安全风格;内容仅 hook command 无 token),原子写 tmp+mv。
  # - PostToolUse:会话调 SendMessage 时记日志(crew-sendmsg-hook.sh → crew-notify.js write)。
  #   matcher 默认 SendMessage(已实测确认的官方工具名);CREW_SENDMSG_TOOL 覆盖为将来改名逃生阀。
  # - Stop(2026-09-03 stage2 · v3.1 升级 2):每 turn 结束时 crew-stop-hook.sh 自动 crew send
  #   触发者一条 turn-done 回执(channel='crew-auto-done')。缺失(旧安装)时 launcher 不加此项。
  # 无 node 降级:不生成 settings、不加 --settings,会话正常起(只是没 hook),对齐 sid_alive 降级。
  local extra_settings=""
  local settings_file="$CREW_STATE/$name.settings"
  local hook_cmd="$SCRIPT_DIR/crew-sendmsg-hook.sh"
  local stop_hook_cmd="$SCRIPT_DIR/crew-stop-hook.sh"
  local statusline_cmd="$SCRIPT_DIR/crew-statusline.sh"
  local sendmsg_tool="${CREW_SENDMSG_TOOL:-SendMessage}"
  if command -v node >/dev/null 2>&1 && [ -x "$hook_cmd" ]; then
    local _stmp="$settings_file.tmp.$$"
    # Stop hook 可选:文件存在且可执行才挂载(避免旧安装升级期缺失导致启动失败)
    local _has_stop_hook=""
    [ -x "$stop_hook_cmd" ] && _has_stop_hook="1"
    # Claude Code's native header shows the requested model but its bottom bar
    # does not expose the routed provider/key. Register crew's status line for
    # every session so a CCR-routed GLM session is not mistaken for the image's
    # default Claude model.
    local _statusline_cmd=""
    [ -x "$statusline_cmd" ] && _statusline_cmd="$statusline_cmd"
    if HOOK_CMD="$hook_cmd" MATCHER="$sendmsg_tool" \
       STOP_HOOK_CMD="$stop_hook_cmd" HAS_STOP="$_has_stop_hook" STATUSLINE_CMD="$_statusline_cmd" \
       SETTINGS_BASE_URL="$BK_BASE_URL" \
       node -e '
        const fs=require("fs");
        const hooks={PostToolUse:[{matcher:process.env.MATCHER,
          hooks:[{type:"command",command:process.env.HOOK_CMD}]}]};
        if (process.env.HAS_STOP) {
          hooks.Stop=[{matcher:"*",
            hooks:[{type:"command",command:process.env.STOP_HOOK_CMD}]}];
        }
        const settings={hooks};
        if (process.env.STATUSLINE_CMD) {
          settings.statusLine={type:"command",command:process.env.STATUSLINE_CMD};
        }
        // 2026-10-16 P1:per-session settings 内注入 env base_url,优先级高于全局
        // ~/.claude/settings.json(CCR3 原生集成会反复把全局 env 重写为 :3456 直连,
        // 导致会话绕过 crew-proxy 直连 CCR 而 401)。--settings 文件级别更高,能覆盖全局。
        if (process.env.SETTINGS_BASE_URL) {
          settings.env={
            "ANTHROPIC_BASE_URL":process.env.SETTINGS_BASE_URL,
            "ANTHROPIC_API_BASE_URL":process.env.SETTINGS_BASE_URL,
            "CLAUDE_AGENT_API_BASE_URL":process.env.SETTINGS_BASE_URL
          };
        }
        process.stdout.write(JSON.stringify(settings,null,2)+"\n");
      ' > "$_stmp" 2>/dev/null; then
      mv -f "$_stmp" "$settings_file" && extra_settings=" --settings $(printf %q "$settings_file")"
    else
      rm -f "$_stmp" 2>/dev/null
    fi
  fi

  # env 前缀
  local envp=""
  [ -n "$onboarding_ver" ] && envp+=" CREW_ONBOARDING_VER=$(printf %q "$onboarding_ver")"
  [ -n "${BK_BASE_URL:-}" ] && envp+=" ANTHROPIC_BASE_URL=$(printf %q "$BK_BASE_URL")"
  [ -n "${BK_TOKEN:-}" ] && envp+=" ANTHROPIC_AUTH_TOKEN=$(printf %q "$BK_TOKEN")"
  [ -n "${BK_ENV_EXTRA:-}" ] && envp+=" $BK_ENV_EXTRA"
  # 2026-08-31 修 statusline 显示 bug:v2 重构时丢了 v1(crew.v1:775-776)对 CREW_* 的注入,
  # 导致 claude 子进程不知道自己属于哪个 crew 会话 → crew-statusline.sh 认不出会话、回落到
  # CCR Router.default(显示成 Claude-Opus-4.8-joybuilder + 默认 key)。补回:让 statusline /
  # keyresolve 能拿到本会话真实 model/key。CREW_STATE 也让子进程内的 crew 命令指对状态目录。
  local _sess_backend _sess_key
  _sess_backend=$("$CS" get "$name" backend 2>/dev/null || echo "")
  _sess_key=$("$CS" get "$name" key 2>/dev/null || echo "")
  envp+=" CREW_SESSION=$(printf %q "$name") CREW_HOME=$(printf %q "$CREW_HOME") CREW_STATE=$(printf %q "$CREW_STATE")"
  [ -n "$_sess_backend" ] && envp+=" CREW_MODEL=$(printf %q "$_sess_backend")"
  [ -n "$_sess_key" ] && envp+=" CREW_KEY=$(printf %q "$_sess_key")"
  # 2026-10-20 ctx 窗口对齐:oxygen(llm-gw)不提供模型上下文元数据(/v1/models 只有 id),
  # CC 对未知模型按默认窗口(~200k)假定,与上游真实窗口(GLM-5.3 实际 1M/Flash 500k 等)不符:
  #   - 假窗口 < 真窗口:statusline 剩余量失真、提前压缩(浪费)
  #   - 假窗口 > 真窗口:自动压缩该触发时不触发 → compact 请求超真窗口被 400
  #     "prompt is too long" 拒掉 → 会话卡死只能重开(用户实测)
  # 解法:按模型查 ~/.config/claude-crew/model-windows.conf(每行 <模式>=<token数>),
  # 注入 CLAUDE_CODE_MAX_CONTEXT_TOKENS(真实窗口) + AUTO_COMPACT_WINDOW(90%,压缩留
  # 余量别贴上限跑)。BK_MODEL(本次要跑的)> state backend(旧值)。无匹配不注入(CC 默认)。
  local _mw_file="$CREW_HOME/model-windows.conf" _mw_win=""
  if [ -f "$_mw_file" ]; then
    local _mw_model="${BK_MODEL:-}"
    [ -z "$_mw_model" ] && _mw_model="$_sess_backend"
    # 小写包含匹配:conf 写短名 glm-5.3 / kimi,模型全名 GLM-5.3-Local-joybuilder 也命中
    _mw_win=$(awk -F= -v m="$(printf %s "$_mw_model" | tr 'A-Z' 'a-z')" '
      $1!="" && index(m, tolower($1)) {print $2; exit}' "$_mw_file" 2>/dev/null)
    case "$_mw_win" in
      ''|*[!0-9]*) ;;  # 空/非数字:不注入
      *)
        envp+=" CLAUDE_CODE_MAX_CONTEXT_TOKENS=$_mw_win"
        envp+=" CLAUDE_CODE_AUTO_COMPACT_WINDOW=$(( _mw_win * 90 / 100 ))"
        ;;
    esac
  fi

  # 拼完整命令(每次生成 launcher 脚本文件传 tmux/fg,避 quoting)
  # 2026-08-30 audit-crew C4(P0):
  #   ①chmod 600(不 +x)— launcher 通过 `bash <file>` 跑,不需要执行权限;600 让 /tmp
  #     里的 ANTHROPIC_AUTH_TOKEN 只有 owner 可读,阻断"/tmp 明文 token 被同容器其他用户
  #     读到"路径。v1(870,884)是脱敏 crew-last-cmd 但 launcher 本身仍 644——v2 补齐。
  #   ②launcher 内容首行 self-unlink:bash 起来立即 rm 自己,claude exec 起来时文件已无。
  #     即使 send-keys 期间被 curl /tmp 扫走,也只有几毫秒窗口。
  #     测试注入 CREW_LAUNCHER_KEEP=1 可跳过 self-unlink(便于 unit test 检查内容),
  #     生产不设该 env → 默认走 self-unlink。
  local launcher="/tmp/crew-launch-$name.sh"
  {
    echo "#!/bin/bash"
    echo "# generated by crew-launcher for '$name' mode=$mode"
    if [ -z "${CREW_LAUNCHER_KEEP:-}" ]; then
      echo "# self-unlink first: 阻断 /tmp 明文 token 泄露(audit-crew C4)"
      echo 'rm -f "$0" 2>/dev/null || true'
    fi
    echo "export PATH=/work/node20/bin:\$PATH LANG=C.UTF-8 LC_ALL=C.UTF-8 IS_SANDBOX=1"
    # 2026-08-31 修 Bug A:在起 claude 前 cd 到会话工作目录(对齐 v1:858/888)。v2 之前直接
    # 在 tmux pane 当前目录起 claude → 换模型/重启会话丢工作目录,且 --resume 按错目录找历史崩。
    [ -n "$dir" ] && printf 'cd %s || { echo "[crew] cannot cd to %s" >&2; exit 1; }\n' "$(printf %q "$dir")" "$(printf %q "$dir")"
    printf 'exec env%s "%s"' "$envp" "$CLAUDE_BIN"
    for a in "${argv[@]}"; do
      printf ' %s' "$(printf %q "$a")"
    done
    printf '%s%s%s%s' "$extra_settings" "$extra_onboarding" "$extra_comm" "$extra_policy"
    echo
  } > "$launcher"
  chmod 600 "$launcher"

  # mode fg:exec launcher(取代当前 shell)
  # mode tmux:调 crew-tmux ensure + run
  # mode use-current-tmux(2026-08-31 audit-crew P2-b):已在 tmux pane 里,不 new-session,
  #   直接 exec bash launcher —— 根治 pinned + bootstrap 外壳 tmux 打架的五概念纠缠。
  #   pinned 状态不动(不 unpin/re-pin);notmux 设 0(未来 crew ls 判 live 靠 tmux 存在性)
  case "$mode" in
    fg)
      "$CS" set "$name" notmux "1" >/dev/null
      "$CS" set "$name" fgpid "$$" >/dev/null
      exec bash "$launcher"
      ;;
    use-current-tmux)
      # 前置检查:必须在 tmux pane 里(否则等同 fg,提示更清晰)
      if [ -z "${TMUX:-}" ]; then
        echo "[crew-launcher] --mode use-current-tmux 需要在 tmux pane 里跑(当前 \$TMUX 未设),回落 fg 模式" >&2
        "$CS" set "$name" notmux "1" >/dev/null
        exec bash "$launcher"
      fi
      # 记 tmuxname 为当前 pane 所在 session(方便 crew ls / crew-tmux resolve 认它)
      _cur_sess=$(tmux display-message -p '#S' 2>/dev/null)
      if [ -n "$_cur_sess" ]; then
        "$CS" set "$name" tmuxname "$_cur_sess" >/dev/null
        # 顺手写 .tmux(adopt marker),让 crew ls 认它;pinned 状态保持
        "$CS" set "$name" tmux "$_cur_sess" >/dev/null
      fi
      "$CS" set "$name" notmux "0" >/dev/null
      echo "[crew-launcher] '$name' mode=use-current-tmux ready (pane=$_cur_sess, launcher=$launcher)"
      exec bash "$launcher"
      ;;
    tmux)
      "$CS" set "$name" notmux "0" >/dev/null
      "$CT" ensure "$name" || { echo "[crew-launcher] ensure tmux 失败" >&2; return 1; }
      # 等 pane 里 shell 准备好(输出 prompt)
      local resolved
      resolved=$("$CT" resolve "$name")
      for i in $(seq 1 20); do
        timeout 3 tmux capture-pane -t "$resolved" -p 2>/dev/null | grep -qE '\$|#|❯' && break
        sleep 0.15
      done
      "$CT" run "$name" "$launcher"
      # task:launcher 起 claude 后,再 send-keys task(在 claude REPL 里)
      if [ -n "$task" ]; then
        sleep 2  # 等 claude 起来
        timeout 3 tmux send-keys -t "$resolved" -l "$task"
        sleep 0.3
        timeout 3 tmux send-keys -t "$resolved" Enter
      fi
      echo "[crew-launcher] '$name' mode=tmux ready (tmux=$resolved, launcher=$launcher)"
      ;;
  esac
}

case "${1:-}" in
  spawn)  shift; cmd_spawn "$@" ;;
  help|--help|-h) sed -n '3,15p' "$0" ;;
  '') usage ;;
  *) echo "[crew-launcher] unknown command: $1" >&2; exit 2 ;;
esac
